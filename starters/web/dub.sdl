name "starter-web"
description "Build REST applications with flint:web and Flint Boot"
license "Apache-2.0"
// A starter has no code (ADR-029 section 8): its dependencies and its configuration section.
targetType "none"
dependency "flint:starter" version="*"
dependency "flint:arena" version="*"
dependency "flint:di" version="*"
dependency "flint:config" version="*"
dependency "flint:serde" version="*"
dependency "flint:validate" version="*"
dependency "flint:web" version="*"
dependency "flint:boot-autoconfigure-web" version="*"
