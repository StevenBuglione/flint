name "starter-data-jdbc"
description "Repositories over SQL with flint:engine-data and Flint Boot"
license "Apache-2.0"
// A starter has no code (ADR-029 section 8): its dependencies and its configuration section.
targetType "none"
dependency "flint:starter" version="*"
dependency "flint:conc" version="*"
dependency "flint:engine-data" version="*"
dependency "flint:engine-sql" version="*"
dependency "flint:engine-migrate" version="*"
dependency "flint:boot-autoconfigure-data" version="*"
