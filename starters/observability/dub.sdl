name "starter-observability"
description "Flint observability starter: health, readiness and Prometheus metrics endpoints, and OTLP export"
license "Apache-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "flint:arena" version="*"
dependency "flint:conc" version="*"
dependency "flint:di" version="*"
dependency "flint:config" version="*"
dependency "flint:web" version="*"
dependency "flint:actuator" version="*"

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}
