name "starter-data"
description "Flint data starter: a configured SQL pool, build-time migrations and repositories"
license "Apache-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "flint:arena" version="*"
dependency "flint:conc" version="*"
dependency "flint:di" version="*"
dependency "flint:config" version="*"
dependency "flint:data" version="*"
dependency "flint:sql" version="*"
dependency "flint:migrate" version="*"

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}
