/// `flint openapi`: the OpenAPI document of a starter-web application, and a typed TypeScript client from it
/// (ADR-028 section 5).
///
/// flint builds the project, runs it with `--openapi` (flint:starter-web prints the document that flint:engine-web
/// generated from the controllers at compile time), names the document after flint.toml, and writes it. With
/// `--typescript`, it also writes a dependency-free client: one interface per object schema and one method per
/// operation, over `fetch`.
module flint_tool.commands.openapi;

import std.json : JSONOptions, JSONValue;
import flint_tool.diagnostics.report : Report;
import flint_tool.engine.session : Session;

@safe:

/// `flint openapi [--output FILE] [--typescript FILE]`.
int commandOpenApi(ref Session session, string project, string output, string typescript)
{
    import std.file : write;
    import flint_tool.commands.output : finishBare;
    import flint_tool.commands.project : Target, TargetKind, locate;
    import flint_tool.engine.builder : BuildOutcome, BuildRequest, buildProject;
    import flint_tool.support.process : Launch, capture;

    Report report;
    Target target;
    if (!locate(session, project, target, report))
        return finishBare(session, report, "flint.openapi/1");
    if (target.kind == TargetKind.workspace || !usesStarterWeb(target.manifest))
    {
        report.error("FLINT-E0004", "flint openapi documents a project that uses flint:starter-web",
                "flint add web, then serve controllers with runApplication");
        return finishBare(session, report, "flint.openapi/1");
    }
    BuildRequest request;
    BuildOutcome outcome;
    const quiet = session.json;
    session.json = false;
    const built = buildProject(session, target.manifest, target.resolution, request, outcome, report);
    session.json = quiet;
    if (!built)
        return finishBare(session, report, "flint.openapi/1");
    Launch launch;
    launch.directory = target.root;
    const printed = capture([outcome.artifact, "--openapi"], launch);
    JSONValue document;
    if (!printed.ok || !parse(printed.output, document))
    {
        const hint = "serve the controllers with flint.boot.runApplication and WebServerAutoConfiguration; "
            ~ "they answer --openapi\n";
        report.error("FLINT-E0704", "the application did not print an OpenAPI document", hint ~ printed.combined());
        return finishBare(session, report, "flint.openapi/1");
    }
    document["info"]["title"] = target.manifest.name;
    document["info"]["version"] = target.manifest.version_;
    const text = document.toPrettyString(JSONOptions.doNotEscapeSlashes) ~ "\n";
    if (output.length)
    {
        write(output, text);
        session.progress("Wrote", output);
    }
    else if (typescript.length == 0)
        imported!"flint_tool.sys.posix".writeOutput(text);
    if (typescript.length)
    {
        write(typescript, typescriptClient(document));
        session.progress("Wrote", typescript ~ " (TypeScript client)");
    }
    return finishBare(session, report, "flint.openapi/1");
}

private bool usesStarterWeb(const ref imported!"flint_tool.project.manifest".Manifest manifest)
{
    foreach (ref dependency; manifest.dependencies)
    {
        if (dependency.name == "flint:starter-web")
            return true;
    }
    return false;
}

private bool parse(string text, out JSONValue document)
{
    import std.json : JSONException, JSONType, parseJSON;

    try
        document = parseJSON(text);
    catch (JSONException)
        return false;
    return document.type == JSONType.object && "paths" in document && "info" in document;
}

/// The TypeScript client for an OpenAPI document that flint:engine-web generated.
string typescriptClient(const JSONValue document)
{
    import std.algorithm.sorting : sort;
    import std.array : join;

    string[string] interfaces;
    string methods;
    auto paths = document["paths"].objectNoRef.keys;
    sort(paths);
    foreach (path; paths)
    {
        auto verbs = document["paths"][path].objectNoRef.keys;
        sort(verbs);
        foreach (verb; verbs)
            methods ~= clientMethod(path, verb, document["paths"][path][verb], interfaces);
    }
    auto names = interfaces.keys;
    sort(names);
    string declarations;
    foreach (name; names)
        declarations ~= interfaces[name];
    const info = document["info"]["title"].str ~ " " ~ document["info"]["version"].str;
    const rerun = ". Do not edit; rerun `flint openapi --typescript`.\n\n";
    return "// Generated by `flint openapi` from " ~ info ~ rerun ~ declarations ~ clientPrelude ~ methods ~ "}\n";
}

private enum clientPrelude = `function queryString(query: Record<string, unknown>): string {
  const parts = Object.entries(query)
    .filter(([, value]) => value !== undefined)
    .map(([key, value]) => encodeURIComponent(key) + "=" + encodeURIComponent(String(value)));
  return parts.length ? "?" + parts.join("&") : "";
}

/** A non-success response: its status and the server's error message. */
export class ApiError extends Error {
  constructor(public readonly status: number, message: string) {
    super(message);
  }
}

/** Typed calls to the API. */
export class Client {
  constructor(private readonly baseUrl = "", private readonly headers: Record<string, string> = {}) {}

  private async request<T>(method: string, path: string, body?: unknown): Promise<T> {
    const response = await fetch(this.baseUrl + path, {
      method,
      headers: body === undefined ? this.headers : { "Content-Type": "application/json", ...this.headers },
      body: body === undefined ? undefined : JSON.stringify(body),
    });
    const text = await response.text();
    const value = text ? JSON.parse(text) : undefined;
    if (!response.ok) {
      const message = value && typeof value.error === "string" ? value.error : response.statusText;
      throw new ApiError(response.status, message);
    }
    return value as T;
  }
`;

private string clientMethod(string path, string verb, const JSONValue operation, ref string[string] interfaces)
{
    import std.array : join, replace;

    string[] parameters;
    string[] query;
    string route = path;
    foreach (ref parameter; operation["parameters"].arrayNoRef)
    {
        const name = parameter["name"].str;
        const type = typeOf(parameter["schema"], interfaces);
        if (parameter["in"].str == "path")
        {
            parameters ~= identifier(name) ~ ": " ~ type;
            route = route.replace("{" ~ name ~ "}", "${encodeURIComponent(String(" ~ identifier(name) ~ "))}");
        }
        else
            query ~= quoteKey(name) ~ (parameter["required"].boolean ? "" : "?") ~ ": " ~ type;
    }
    bool hasBody;
    if (const requestBody = "requestBody" in operation)
    {
        parameters ~= "body: " ~ typeOf((*requestBody)["content"]["application/json"]["schema"], interfaces);
        hasBody = true;
    }
    string url = "`" ~ route ~ "`";
    if (query.length)
    {
        parameters ~= "query: { " ~ query.join("; ") ~ " } = {}";
        url ~= " + queryString(query)";
    }
    string result = "void";
    foreach (status, response; operation["responses"].objectNoRef)
    {
        if (status.length == 3 && status[0] == '2')
        {
            if (const content = "content" in response)
                result = typeOf((*content)["application/json"]["schema"], interfaces);
        }
    }
    return "\n  /** " ~ verb.toUpperCaseAscii ~ " " ~ path ~ " (" ~ operation["operationId"].str
        ~ ") */\n  " ~ methodName(operation["operationId"].str) ~ "(" ~ parameters.join(
                ", ") ~ "): Promise<" ~ result ~ "> {\n    return this.request<" ~ result ~ ">(\""
        ~ verb.toUpperCaseAscii ~ "\", " ~ url ~ (hasBody ? ", body" : "") ~ ");\n  }\n";
}

private string typeOf(const JSONValue schema, ref string[string] interfaces)
{
    import std.json : JSONType;

    if (schema.type != JSONType.object)
        return "unknown";
    if (const values = "enum" in schema)
        return literalUnion(*values);
    switch ("type" in schema ? schema["type"].str : "")
    {
    case "string":
        return "string";
    case "integer":
    case "number":
        return "number";
    case "boolean":
        return "boolean";
    case "array":
        const item = typeOf(schema["items"], interfaces);
        return (item.length && item[$ - 1] == '"' ? "(" ~ item ~ ")" : item) ~ "[]";
    case "object":
        return objectType(schema, interfaces);
    default:
        return "unknown";
    }
}

// A string enum as a union of literals.
private string literalUnion(const JSONValue values)
{
    import std.array : join;

    string[] literals;
    foreach (ref value; values.arrayNoRef)
        literals ~= `"` ~ value.str ~ `"`;
    return literals.join(" | ");
}

// A titled object schema as a named interface, declared once.
private string objectType(const JSONValue schema, ref string[string] interfaces)
{
    const title = "title" in schema;
    if (title is null)
        return "Record<string, unknown>";
    if (title.str !in interfaces)
    {
        interfaces[title.str] = "";
        interfaces[title.str] = interfaceOf(title.str, schema, interfaces);
    }
    return title.str;
}

private string interfaceOf(string name, const JSONValue schema, ref string[string] interfaces)
{
    import std.algorithm.sorting : sort;

    // Fields in declaration order: flint:engine-web lists them in `required`; otherwise sorted.
    const properties = schema["properties"].objectNoRef;
    string[] order;
    if (const required = "required" in schema)
        foreach (ref key; required.arrayNoRef)
            order ~= key.str;
    if (order.length != properties.length)
    {
        order = properties.keys;
        sort(order);
    }
    string fields;
    foreach (key; order)
        fields ~= "  " ~ quoteKey(key) ~ ": " ~ typeOf(properties[key], interfaces) ~ ";\n";
    return "export interface " ~ name ~ " {\n" ~ fields ~ "}\n\n";
}

// `NoteController.get` as `noteGet`.
private string methodName(string operationId)
{
    import std.algorithm.searching : endsWith;
    import std.ascii : toLower, toUpper;
    import std.string : indexOf;

    const dot = operationId.indexOf('.');
    string owner = dot < 0 ? "" : operationId[0 .. dot];
    const action = dot < 0 ? operationId : operationId[dot + 1 .. $];
    if (owner.endsWith("Controller"))
        owner = owner[0 .. $ - "Controller".length];
    if (owner.length == 0)
        return action;
    return toLower(owner[0]) ~ owner[1 .. $] ~ toUpper(action[0]) ~ action[1 .. $];
}

private string identifier(string name)
{
    string result;
    foreach (ch; name)
        result ~= (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_' ? ch
            : '_';
    return result;
}

private string quoteKey(string name)
{
    return identifier(name) == name ? name : `"` ~ name ~ `"`;
}

private string toUpperCaseAscii(string text)
{
    import std.ascii : toUpper;

    string result;
    foreach (ch; text)
        result ~= toUpper(ch);
    return result;
}

unittest
{
    import std.json : parseJSON;

    import std.array : join;

    const fixture = [
        `{"openapi":"3.1.0","info":{"title":"notes","version":"1.0.0"},"paths":{`,
        `"/api/notes/{id}":{"get":{"operationId":"NoteController.get","parameters":[{"name":"id","in":"path",`,
        `"required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"",`,
        `"content":{"application/json":{"schema":{"title":"Note","type":"object","properties":{"id":`,
        `{"type":"integer"},"tags":{"type":"array","items":{"type":"string"}},"level":{"type":"string",`,
        `"enum":["low","high"]}},"required":[]}}}}}},"delete":{"operationId":"NoteController.remove",`,
        `"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer"}}],"responses":`,
        `{"204":{"description":""}}}},"/api/notes":{"post":{"operationId":"NoteController.create",`,
        `"parameters":[{"name":"tag","in":"query","required":false,"schema":{"type":"string"}}],`,
        `"requestBody":{"content":{"application/json":{"schema":{"title":"NewNote","type":"object",`,
        `"properties":{"title":{"type":"string"}},"required":[]}}}},"responses":{"201":{"description":"",`,
        `"content":{"application/json":{"schema":{"title":"Created","type":"object","properties":{},`,
        `"required":[]}}}}}}}}}`,
    ];
    const document = parseJSON(fixture.join);
    const client = typescriptClient(document);
    import std.algorithm.searching : canFind;

    assert(client.canFind("export interface Note {\n  id: number;\n"), client);
    assert(client.canFind("  level: \"low\" | \"high\";\n"), client);
    assert(client.canFind("  tags: string[];\n"), client);
    assert(client.canFind("export interface NewNote {\n  title: string;\n}"), client);
    assert(client.canFind("noteGet(id: number): Promise<Note> {\n    return this.request<Note>(\"GET\", "
            ~ "`/api/notes/${encodeURIComponent(String(id))}`);"), client);
    assert(client.canFind("noteRemove(id: number): Promise<void>"), client);
    assert(client.canFind("noteCreate(body: NewNote, query: { tag?: string } = {}): Promise<Created> {\n    return "
            ~ "this.request<Created>(\"POST\", `/api/notes` + queryString(query), body);"), client);
}
