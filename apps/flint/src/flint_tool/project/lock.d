/// flint.lock: the exact dependency graph, content hashes and toolchain identity of a project.
///
/// The lock is rendered deterministically from the resolution, so verifying it is a byte comparison.
module flint_tool.project.lock;

import flint_tool.diagnostics.report : Report, Severity, at, diagnostic;
import flint_tool.home.policy : Home;
import flint_tool.project.manifest : Manifest;
import flint_tool.project.resolve : ResolvedPackage, Resolution;

@safe:

/// The lock file name.
enum lockName = "flint.lock";

/// Lock state after a check.
enum LockState : ubyte
{
    /// flint.lock matches the inputs.
    current,
    /// flint.lock does not exist.
    missing,
    /// flint.lock differs from the inputs.
    stale
}

/// Render the lock for a resolution.
string renderLock(const ref Home home, const ref Manifest manifest, const ref Resolution resolution)
{
    import std.path : buildPath;
    import flint_tool.support.files : sha256File;

    string text = "# flint.lock is generated by `flint lock` and verified by every build. Do not edit it.\n"
        ~ "# It records the exact dependency graph, content hashes and toolchain identity.\n"
        ~ "schema = 1\n\n[project]\n" ~ pair("name", manifest.name) ~ pair("version",
                manifest.version_) ~ "\n[platform]\n" ~ pair("flint",
                home.platform.flint) ~ pair("release", home.platform.release);
    foreach (tool; ["dmd", "ldc", "dub"])
        text ~= pair(tool, home.versions[tool]);
    if (resolution.workspace)
        text ~= pair("pinned_by", "workspace commit");
    else
    {
        text ~= pair("toolchain_sha256", home.digests["policy/toolchains.json"]);
        text ~= pair("dmd_patch_sha256", sha256File(buildPath(home.root, "toolchain", "dmd-2.114.0-flint.patch")));
        text ~= pair("dub_patch_sha256", sha256File(buildPath(home.root, "toolchain", "dub-1.43.0-flint.patch")));
        text ~= pair("profiles_sha256", home.digests["policy/profiles.toml"]);
        text ~= pair("safety_sha256", home.digests["policy/safety-policy.json"]);
    }
    foreach (ref item; resolution.packages)
    {
        text ~= "\n[[package]]\n" ~ pair("name", item.name) ~ pair("kind", item.kind);
        if (item.source.length)
            text ~= pair("source", item.source);
        if (item.declaredPath.length)
            text ~= pair("path", item.declaredPath);
        if (item.version_.length)
            text ~= pair("version", item.version_) ~ pair("commit", item.commit);
        if (item.contentSha256.length)
            text ~= pair("content_sha256", item.contentSha256);
        text ~= pair("scope", item.testOnly ? "test" : "build");
        text ~= "dependencies = [" ~ list(item.dependencies) ~ "]\n";
    }
    foreach (ref native; resolution.natives.packages)
    {
        // Native binaries are recorded for the host target; other targets verify the recipe and source.
        text ~= "\n[[native]]\n" ~ pair("name", native.name) ~ pair("version",
                native.version_) ~ pair("linkage", native.linkage);
        if (native.linkage != "system")
            text ~= pair("target", resolution.natives.target) ~ pair("recipe_revision",
                    native.recipeRevision) ~ pair("package_id",
                    native.packageId) ~ pair("source_sha256",
                    native.sourceSha256) ~ pair("binary_sha256", native.binarySha256);
        text ~= "requested_by = [" ~ list(native.requesters) ~ "]\n";
        text ~= "dependencies = [" ~ list(native.dependencies) ~ "]\n";
    }
    return text;
}

private string pair(string key, string value)
{
    return key ~ " = " ~ quoted(value) ~ "\n";
}

private string list(scope const(string)[] values)
{
    import std.algorithm.sorting : sort;

    auto sorted = values.dup;
    sort(sorted);
    string text;
    foreach (index, value; sorted)
        text ~= (index ? ", " : "") ~ quoted(value);
    return text;
}

/// A TOML basic string.
string quoted(string value)
{
    string text = "\"";
    foreach (ch; value)
    {
        if (ch == '"' || ch == '\\')
            text ~= '\\';
        if (ch == '\n')
        {
            text ~= "\\n";
            continue;
        }
        text ~= ch;
    }
    return text ~ "\"";
}

/// Compare flint.lock in `root` with `expected`. Mismatches are reported when `strict`.
LockState checkLock(string root, string expected, bool missingIsError, ref Report report)
{
    import std.path : buildPath;
    import flint_tool.support.files : readIfPresent;

    const actual = readIfPresent(buildPath(root, lockName));
    if (actual is null)
    {
        if (missingIsError)
            report.add(at(diagnostic("FLINT-E0201", Severity.error, "flint.lock does not exist",
                    "run `flint lock` and commit flint.lock"), lockName, 0));
        return LockState.missing;
    }
    if (actual == expected)
        return LockState.current;
    report.add(at(diagnostic("FLINT-E0202", Severity.error, describeChange(actual, expected),
            "review the change, then run `flint lock` to accept it"), lockName,
            firstDifference(actual, expected), 0, actual));
    return LockState.stale;
}

/// Write flint.lock; returns true when its content changed.
bool writeLock(string root, string expected)
{
    import std.path : buildPath;
    import flint_tool.support.files : writeIfChanged;

    return writeIfChanged(buildPath(root, lockName), expected);
}

private long firstDifference(string actual, string expected)
{
    import std.string : lineSplitter;
    import std.array : array;

    auto left = actual.lineSplitter.array;
    auto right = expected.lineSplitter.array;
    foreach (index; 0 .. left.length < right.length ? left.length : right.length)
    {
        if (left[index] != right[index])
            return cast(long) index + 1;
    }
    return cast(long)(left.length < right.length ? left.length : right.length) + 1;
}

/// A one-line summary of what changed between two lock texts.
string describeChange(string actual, string expected)
{
    import std.array : join;

    const before = packageLines(actual);
    const after = packageLines(expected);
    string[] changes;
    foreach (name, line; after)
    {
        if (name !in before)
            changes ~= "added " ~ name;
        else if (before[name] != line)
            changes ~= "changed " ~ name;
    }
    foreach (name, line; before)
    {
        if (name !in after)
            changes ~= "removed " ~ name;
    }
    import std.algorithm.sorting : sort;

    sort(changes);
    if (changes.length == 0)
        return "the platform or toolchain identity recorded in flint.lock differs from this installation";
    return "the resolved graph differs from flint.lock: " ~ changes.join(", ");
}

private string[string] packageLines(string text)
{
    import std.string : lineSplitter, startsWith;

    string[string] packages;
    bool inPackage;
    string current;
    string body;
    string prefix;
    foreach (line; text.lineSplitter)
    {
        if (line == "[[package]]" || line == "[[native]]")
        {
            if (current.length)
                packages[current] = body;
            inPackage = true;
            current = null;
            body = null;
            prefix = line == "[[native]]" ? "native " : null;
            continue;
        }
        if (!inPackage)
            continue;
        if (current is null && line.startsWith("name = \"") && line.length > "name = \"".length)
            current = prefix ~ line["name = \"".length .. $ - 1];
        body ~= line ~ "\n";
    }
    if (current.length)
        packages[current] = body;
    return packages;
}
