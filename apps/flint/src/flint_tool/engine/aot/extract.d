/// The extraction compile (docs/spring/aot-contract.md section 1.1): the compiler evaluates a describer over the
/// modules Flint AOT needs and prints their models, so the generator sees real types and evaluated attributes.
///
/// The describer is written next to a generated root module and compiled with `-c` into a throwaway object: the
/// forked DMD's compile server serves `-c` compiles (with druntime, Phobos and the platform prelude analysed) but
/// not `-o-` ones, and the root holds no code, so the object costs nothing. Nothing it produces is linked.
module flint_tool.engine.aot.extract;

import flint_tool.engine.aot.model : AnnotationType, ModuleModel;

@safe:

/// Line prefix announcing a described module.
enum modulePrefix = "FLINT-AOT-MODULE ";
/// Line prefix of one type: the module name, a space, the type's JSON.
enum typePrefix = "FLINT-AOT-TYPE ";
/// Line prefix of one annotation type's JSON.
enum annotationPrefix = "FLINT-AOT-ANNOTATION ";
/// Line prefix of a class-presence answer.
enum presencePrefix = "FLINT-AOT-PRESENT ";

/// What one extraction compile needs.
struct ExtractionRequest
{
    /// The compiler executable.
    string compiler;
    /// `-I` flags and any other semantic flags of the build (`-preview=dip1000`, `-version=`).
    string[] flags;
    /// Modules to describe.
    string[] modules;
    /// Fully qualified class names whose presence to answer.
    string[] classes;
    /// Annotation types the generator already holds (platform ones, from this environment): not described again.
    string[] knownAnnotations;
    /// Directory for the describer and the root module.
    string directory;
    /// Working directory of the compile.
    string workingDirectory;
    /// The compile server's platform prelude (FLINT_DMD_SERVER_PRELUDE), or empty: with it the server has the
    /// platform modules analysed, so the compile analyses only the requested ones.
    string prelude;
    /// Ask the forked DMD's native extractor (-flint-aot-extract) first; a compiler without it falls back to the
    /// describer.
    bool native = true;
}

/// What it produced.
struct ExtractionResult
{
    /// One model per requested module.
    ModuleModel[] models;
    /// The document of each model (`flint.aot.model/1`), for the cache.
    string[] documents;
    /// Annotation types the described modules reach, and their JSON.
    AnnotationType[] annotationTypes;
    /// ditto
    string[] annotationDocuments;
    /// Class-presence answers.
    bool[string] present;
    /// The compiler's own output, without model lines, when the compile failed.
    string errors;
    /// Model documents that did not parse.
    string unreadable;
    /// Whether the compile succeeded and every model parsed.
    bool ok;
    /// Wall time of the compile, in milliseconds.
    long milliseconds;
    /// The compiler's native extractor produced the models (else the describer did).
    bool native;
}

/// The module listing the annotation types the describer skips.
string renderKnown(scope const string[] names)
{
    import flint_tool.engine.aot.conditions : literal;

    // A switch in a plain function: an associative-array enum cost about 10 ms to analyse (druntime's hooks).
    string text = "// Generated by Flint AOT: annotation types already described. Never linked. Do not edit.\n"
        ~ "module flint_aot_known;\n\nbool flintAotKnownAnnotation(string name) pure nothrow @safe @nogc\n{\n";
    if (names.length == 0)
        return text ~ "    return false;\n}\n";
    text ~= "    switch (name)\n    {\n";
    foreach (name; names)
        text ~= "    case " ~ literal(name) ~ ":\n";
    return text ~ "        return true;\n    default:\n        return false;\n    }\n}\n";
}

/// The root module the compiler is given. For the native extractor it only imports the modules (in request order)
/// and asks the presence questions; the describer's instantiations are left out.
string renderRoot(scope const string[] modules, scope const string[] classes, bool native = false)
{
    import std.string : lastIndexOf;

    string text = "// Generated by Flint AOT: the extraction root. Never linked. Do not edit.\n"
        ~ "module flint_aot_extract;\n\n" ~ (native ? "" : "import flint_aot_describe : describeModule;\n");
    foreach (name; modules)
        text ~= "static import " ~ name ~ ";\n";
    text ~= "\n";
    if (!native)
    {
        foreach (name; modules)
            text ~= "static if (describeModule!(" ~ name ~ ", \"" ~ name ~ "\"))\n{\n}\n";
    }
    foreach (name; classes)
    {
        const dot = name.lastIndexOf('.');
        if (dot <= 0)
            continue;
        text ~= "pragma(msg, \"" ~ presencePrefix ~ name ~ " \", __traits(compiles, { import "
            ~ name[0 .. dot] ~ " : " ~ name[dot + 1 .. $] ~ "; }));\n";
    }
    return text;
}

/// Run one extraction compile.
ExtractionResult extract(const ref ExtractionRequest request)
{
    import std.file : mkdirRecurse;

    mkdirRecurse(request.directory);
    bool unsupported;
    long spent;
    if (request.native)
    {
        auto native = extractOnce(request, true, unsupported);
        if (!unsupported)
            return native;
        spent = native.milliseconds;
    }
    auto result = extractOnce(request, false, unsupported);
    result.milliseconds += spent;
    return result;
}

/// The native extractor's request file: the modules in request order, then the annotation types already held.
string renderNativeRequest(scope const string[] modules, scope const string[] known)
{
    string text;
    foreach (name; modules)
        text ~= "module " ~ name ~ "\n";
    foreach (name; known)
        text ~= "known " ~ name ~ "\n";
    return text;
}

/// One extraction compile, natively (-flint-aot-extract, the forked DMD's walker over the analysed AST, which
/// prints the describer's lines) or through the describer. `unsupported` is set when the compiler rejected the
/// native switch, so the caller falls back.
private ExtractionResult extractOnce(const ref ExtractionRequest request, bool native, out bool unsupported)
{
    import core.time : MonoTime;
    import std.algorithm.searching : canFind;
    import std.path : buildPath;
    import flint_tool.support.files : writeIfChanged;
    import flint.os : EnvVar;
    import flint_tool.support.process : Launch, capture;

    ExtractionResult result;
    string[] switches;
    if (native)
    {
        const listing = buildPath(request.directory, "flint_aot_request.txt");
        writeIfChanged(listing, renderNativeRequest(request.modules, request.knownAnnotations));
        switches = ["-flint-aot-extract=" ~ listing];
    }
    else
    {
        writeIfChanged(buildPath(request.directory, "flint_aot_describe.d"), describerSource);
        writeIfChanged(buildPath(request.directory, "flint_aot_known.d"), renderKnown(request.knownAnnotations));
    }
    const root = buildPath(request.directory, "flint_aot_extract.d");
    writeIfChanged(root, renderRoot(request.modules, request.classes, native));
    Launch launch;
    launch.directory = request.workingDirectory;
    if (request.prelude.length)
        launch.environment ~= EnvVar("FLINT_DMD_SERVER_PRELUDE", request.prelude);
    const started = MonoTime.currTime;
    const object = buildPath(request.directory, "flint_aot_extract.o");
    const outcome = capture([request.compiler, "-c", "-of=" ~ object,
        "-I" ~ request.directory] ~ switches ~ request.flags ~ [root], launch);
    removeObject(object);
    result.milliseconds = (MonoTime.currTime - started).total!"msecs";
    // An unforked DMD ("unrecognized switch") or LDC ("Unknown command line argument") names the switch.
    if (native && outcome.started && !outcome.ok && outcome.combined().canFind("flint-aot-extract")
            && !outcome.combined().canFind(modulePrefix))
    {
        unsupported = true;
        return result;
    }
    result.native = native;
    if (!outcome.started)
    {
        result.errors = outcome.failure;
        return result;
    }
    readOutput(outcome.combined(), result);
    result.ok = outcome.ok && result.unreadable.length == 0 && result.models.length == request.modules.length;
    if (outcome.ok)
        result.errors = result.unreadable;
    if (!result.ok && result.errors.length == 0)
        result.errors = "the compiler exited with status " ~ outcomeCode(outcome.code);
    return result;
}

private void removeObject(string path)
{
    import std.file : FileException, exists, remove;

    try
    {
        if (exists(path))
            remove(path);
    }
    catch (FileException)
    {
        // A leftover object in .flint is harmless.
    }
}

private string outcomeCode(int code)
{
    import std.conv : to;

    return code.to!string;
}

/// Split the compiler's output into models, annotation types, presence answers and everything else.
void readOutput(string output, ref ExtractionResult result)
{
    import std.algorithm.iteration : splitter;
    import std.algorithm.searching : startsWith;
    import std.string : indexOf, lastIndexOf;

    string[] modules;
    string[][string] types;
    bool[string] announced;
    bool[string] exporters;
    foreach (raw; output.splitter('\n'))
    {
        // Windows compilers end lines with CRLF; a module name keeping the CR is an invalid file name there, and
        // a presence answer "true\r" would read as false.
        const line = raw.length && raw[$ - 1] == '\r' ? raw[0 .. $ - 1] : raw;
        if (line.startsWith(modulePrefix))
        {
            const rest = line[modulePrefix.length .. $];
            const space = rest.indexOf(' ');
            const name = space < 0 ? rest : rest[0 .. space];
            if (space >= 0 && rest[space + 1 .. $] == "descriptors")
                exporters[name] = true;
            if (name !in types)
            {
                modules ~= name;
                types[name] = null;
            }
        }
        else if (line.startsWith(typePrefix))
        {
            const rest = line[typePrefix.length .. $];
            const space = rest.indexOf(' ');
            if (space > 0 && rest[0 .. space] in types)
                types[rest[0 .. space]] ~= rest[space + 1 .. $];
        }
        else if (line.startsWith(annotationPrefix))
            readAnnotation(line[annotationPrefix.length .. $], announced, result);
        else if (line.startsWith(presencePrefix))
        {
            const rest = line[presencePrefix.length .. $];
            const space = rest.lastIndexOf(' ');
            if (space > 0)
                result.present[rest[0 .. space]] = rest[space + 1 .. $] == "true";
        }
        else if (line.length)
            result.errors ~= line ~ "\n";
    }
    foreach (name; modules)
        readModule(name, types[name], (name in exporters) !is null, result);
}

private void readAnnotation(string document, ref bool[string] announced, ref ExtractionResult result)
{
    import flint_tool.engine.aot.model : parseAnnotationType;

    AnnotationType type;
    string error;
    if (!parseAnnotationType(document, type, error))
    {
        result.unreadable ~= "unreadable annotation type: " ~ error ~ "\n";
        return;
    }
    if (type.name in announced)
        return;
    announced[type.name] = true;
    result.annotationTypes ~= type;
    result.annotationDocuments ~= document;
}

private void readModule(string name, scope const string[] types, bool exporter, ref ExtractionResult result)
{
    import std.array : join;
    import flint_tool.engine.aot.conditions : literal;
    import flint_tool.engine.aot.model : parseModule;

    const document = `{"schema":"flint.aot.model/1","module":` ~ literal(name) ~ (exporter
            ? `,"exportsDescriptors":true` : "") ~ `,"types":[` ~ types.join(",") ~ `]}`;
    ModuleModel model;
    string error;
    if (parseModule(document, model, error))
    {
        result.models ~= model;
        result.documents ~= document;
    }
    else
        result.unreadable ~= "unreadable model of " ~ name ~ ": " ~ error ~ "\n";
}

/// The compile-time describer. It is D evaluated by the compiler during the extraction compile, kept here as text
/// because flint itself never compiles it.
enum describerSource = `// Generated by Flint AOT: the describer of the extraction compile. Never linked.
module flint_aot_describe;

import flint_aot_known : flintAotKnownAnnotation;

/// Print the models of one module's types (schema flint.aot.model/1): a FLINT-AOT-MODULE line, then one
/// FLINT-AOT-TYPE line per type. Every annotation type reached prints once per compile, from announce.
template describeModule(alias M, string name)
{
    // A platform module exporting its own descriptors (Descriptor[] flintAotDescriptors()) is marked: the
    // generator calls it instead of describing the module's data types (aot-contract.md section 3).
    pragma(msg, "FLINT-AOT-MODULE " ~ name ~ (__traits(hasMember, M, "flintAotDescriptors") ? " descriptors" : ""));
    static foreach (member; __traits(allMembers, M))
    {
        static if (isLocalType!(M, member, name))
        {
            static if (describeTypes!(__traits(getMember, M, member), name))
            {
            }
        }
    }
    enum describeModule = true;
}

private template describeTypes(T, string moduleName)
{
    pragma(msg, "FLINT-AOT-TYPE " ~ moduleName ~ " " ~ describeType!T());
    static if (!is(T == enum))
    {
        static foreach (member; __traits(derivedMembers, T))
        {
            static if (isLocalType!(T, member))
            {
                static if (describeTypes!(__traits(getMember, T, member), moduleName))
                {
                }
            }
        }
    }
    enum describeTypes = true;
}

/// Printed once per annotation type and compile: a template instance is evaluated once.
/// Platform annotation types the generator already holds are not described again (their CTFE is most of an
/// application module's extraction).
private template announce(T)
{
    static if (!flintAotKnownAnnotation(typeName!T))
        pragma(msg, "FLINT-AOT-ANNOTATION " ~ describeAnnotationType!T());
    enum announce = true;
}

private template isLocalType(alias M, string member, string moduleName = null)
{
    static if (__traits(compiles, __traits(getMember, M, member)))
    {
        alias symbol = __traits(getMember, M, member);
        // A package.d module's alias is its package, which __traits(isSame) never equates with the module that
        // declares the type: module-level members compare by the module's name.
        static if (is(symbol) && (is(symbol == class) || is(symbol == struct) || is(symbol == interface)
                || is(symbol == enum) || is(symbol == union)))
            enum isLocalType = __traits(compiles, __traits(parent, symbol))
                && (__traits(isSame, __traits(parent, symbol), M) || (moduleName.length
                    && __traits(fullyQualifiedName, __traits(parent, symbol)) == moduleName));
        else
            enum isLocalType = false;
    }
    else
        enum isLocalType = false;
}

private enum string quoted(string s) = quote(s);

private string quote(string s)
{
    enum hex = "0123456789abcdef";
    string r = "\"";
    foreach (char c; s)
    {
        if (c == '"' || c == '\\')
            r ~= "\\" ~ c;
        else if (c == '\n')
            r ~= "\\n";
        else if (c == '\t')
            r ~= "\\t";
        else if (c < 0x20)
            r ~= "\\u00" ~ hex[c >> 4] ~ hex[c & 15];
        else
            r ~= c;
    }
    return r ~ "\"";
}

private string number(long value)
{
    if (value == long.min)
        return "-9223372036854775808";
    if (value < 0)
        return "-" ~ number(-value);
    if (value < 10)
        return "" ~ cast(char)('0' + value);
    return number(value / 10) ~ cast(char)('0' + value % 10);
}

private string unsigned(ulong value)
{
    if (value < 10)
        return "" ~ cast(char)('0' + value);
    return unsigned(value / 10) ~ cast(char)('0' + value % 10);
}

private template moduleOf(alias S)
{
    static if (__traits(isModule, S))
        enum moduleOf = packagePrefix!(S) ~ __traits(identifier, S);
    else
        enum moduleOf = moduleOf!(__traits(parent, S));
}

private template packagePrefix(alias S)
{
    static if (__traits(compiles, __traits(parent, S)) && __traits(isPackage, __traits(parent, S)))
        enum packagePrefix = packagePrefix!(__traits(parent, S)) ~ __traits(identifier, __traits(parent, S)) ~ ".";
    else
        enum packagePrefix = "";
}

/// D source spelling of a type, valid wherever every module in typeModules!T is imported statically.
private template typeName(T)
{
    static if (is(T == immutable(char)[]))
        enum typeName = "string";
    else static if (is(T == immutable(wchar)[]))
        enum typeName = "wstring";
    else static if (is(T == immutable(dchar)[]))
        enum typeName = "dstring";
    else static if (is(T == immutable U, U))
        enum typeName = "immutable(" ~ typeName!U ~ ")";
    else static if (is(T == shared const U, U))
        enum typeName = "shared(const(" ~ typeName!U ~ "))";
    else static if (is(T == const U, U))
        enum typeName = "const(" ~ typeName!U ~ ")";
    else static if (is(T == inout U, U))
        enum typeName = "inout(" ~ typeName!U ~ ")";
    else static if (is(T == shared U, U))
        enum typeName = "shared(" ~ typeName!U ~ ")";
    else static if (is(T == V[K], V, K))
        enum typeName = typeName!V ~ "[" ~ typeName!K ~ "]";
    else static if (is(T == E[], E))
        enum typeName = typeName!E ~ "[]";
    else static if (is(T == E[n], E, size_t n))
        enum typeName = typeName!E ~ "[" ~ unsigned(n) ~ "]";
    else static if (is(T == E*, E) && !is(T == function))
        enum typeName = typeName!E ~ "*";
    else static if (is(T == X!Args, alias X, Args...))
        enum typeName = templateName(__traits(fullyQualifiedName, X)) ~ "!(" ~ argumentNames!Args ~ ")";
    else static if (is(T == class) || is(T == struct) || is(T == interface) || is(T == enum) || is(T == union))
        enum typeName = __traits(fullyQualifiedName, T);
    else
        enum typeName = T.stringof;
}

private template argumentNames(Args...)
{
    static if (Args.length == 0)
        enum argumentNames = "";
    else
    {
        static if (is(Args[0]))
            enum head = typeName!(Args[0]);
        else
            enum head = Args[0].stringof;
        static if (Args.length == 1)
            enum argumentNames = head;
        else
            enum argumentNames = head ~ ", " ~ argumentNames!(Args[1 .. $]);
    }
}

/// The modules declaring the named parts of a type, as a JSON array body.
private template typeModules(T)
{
    static if (is(T == immutable(char)[]) || is(T == immutable(wchar)[]) || is(T == immutable(dchar)[]))
        enum typeModules = "";
    else static if (is(T == immutable U, U) || is(T == const U, U) || is(T == inout U, U) || is(T == shared U, U))
        enum typeModules = typeModules!U;
    else static if (is(T == V[K], V, K))
        enum typeModules = joinModules(typeModules!V, typeModules!K);
    else static if (is(T == E[], E) || is(T == E[n], E, size_t n))
        enum typeModules = typeModules!E;
    else static if (is(T == E*, E) && !is(T == function))
        enum typeModules = typeModules!E;
    else static if (is(T == X!Args, alias X, Args...))
        enum typeModules = joinModules(quote(moduleOf!X), argumentModules!Args);
    else static if (is(T == class) || is(T == struct) || is(T == interface) || is(T == enum) || is(T == union))
        enum typeModules = quote(moduleOf!T);
    else
        enum typeModules = "";
}

private template argumentModules(Args...)
{
    static if (Args.length == 0)
        enum argumentModules = "";
    else static if (is(Args[0]))
        enum argumentModules = joinModules(typeModules!(Args[0]), argumentModules!(Args[1 .. $]));
    else
        enum argumentModules = argumentModules!(Args[1 .. $]);
}

/// A template's qualified name without its parameter list: DMD writes a.b.T(U, V).
private string templateName(string name)
{
    foreach (index, char c; name)
    {
        if (c == '(')
            return name[0 .. index];
    }
    return name;
}

private string joinModules(string a, string b)
{
    if (a.length == 0)
        return b;
    if (b.length == 0)
        return a;
    return a ~ "," ~ b;
}

/// Memoized pieces: each is a template keyed by every input its function reads (the type, the attribute tuple,
/// the string), so the compiler evaluates it once per compile however many members repeat it.
private enum string typeRefOf(T) = typeRef!T();

private string typeRef(T)()
{
    string r = "{\"name\":" ~ quote(typeName!T) ~ ",\"modules\":[" ~ typeModules!T ~ "]";
    static if (is(T == E[], E) && !is(T : const(char)[]))
        r ~= ",\"element\":" ~ typeRefOf!E;
    static if (is(T == X!Args, alias X, Args...))
    {
        r ~= ",\"template\":" ~ quote(templateName(__traits(fullyQualifiedName, X))) ~ ",\"arguments\":[";
        static foreach (i, A; Args)
        {
            static if (i)
                r ~= ",";
            static if (is(A))
                r ~= typeRefOf!A;
            else
                r ~= "{\"name\":" ~ quote(A.stringof) ~ ",\"modules\":[]}";
        }
        r ~= "]";
        // The runtime's spelling of the instance (typeNameOf), so generated code can name it with a literal
        // instead of instantiating the type: only when the closure has the runtime.
        static if (__traits(compiles, { import flint.engine.aot.name : canonicalTypeName; })
                && __traits(compiles, __traits(fullyQualifiedName, T)))
        {
            import flint.engine.aot.name : canonicalTypeName;

            r ~= ",\"canonical\":" ~ quote(canonicalTypeName(__traits(fullyQualifiedName, T)));
        }
    }
    static if (is(T == class))
        r ~= ",\"kind\":\"class\"";
    else static if (is(T == interface))
        r ~= ",\"kind\":\"interface\"";
    else static if (is(T == struct) || is(T == union))
        r ~= ",\"kind\":\"struct\"";
    else static if (is(T == enum))
        r ~= ",\"kind\":\"enum\"";
    return r ~ "}";
}

private string location(alias S)()
{
    enum where = __traits(getLocation, S);
    return ",\"file\":" ~ quoted!(where[0]) ~ ",\"line\":" ~ number(where[1]);
}

private string value(T)(T v)
{
    static if (is(T == enum))
    {
        static foreach (member; __traits(allMembers, T))
        {
            if (v == __traits(getMember, T, member))
                return "{\"enum\":" ~ quote(typeName!T) ~ ",\"modules\":[" ~ typeModules!T ~ "],\"name\":"
                    ~ quote(member) ~ "}";
        }
        return "null";
    }
    else static if (is(T : const(char)[]))
        return v is null ? "null" : quote(v);
    else static if (is(T == bool))
        return v ? "true" : "false";
    else static if (is(T == char) || is(T == wchar) || is(T == dchar))
        return "{\"char\":" ~ number(v) ~ "}";
    else static if (__traits(isUnsigned, T))
        return unsigned(v);
    else static if (__traits(isIntegral, T))
        return number(v);
    else static if (__traits(isFloating, T))
        return "{\"float\":" ~ quote(v.stringof) ~ "}";
    else static if (is(T : E[], E))
    {
        string r = "[";
        foreach (i, e; v)
        {
            if (i)
                r ~= ",";
            r ~= value(e);
        }
        return r ~ "]";
    }
    else static if (is(T == struct) && isEnumLike!T)
        return "{\"enum\":" ~ quote(typeName!T) ~ ",\"modules\":[" ~ typeModules!T ~ "],\"name\":"
            ~ quote(v.name()) ~ "}";
    else static if (is(T == struct))
        return annotationValue(v);
    else
        return "null";
}

/// A Java enum with methods, ported as a struct with static constants (proposed R15): named by name().
private enum bool isEnumLike(T) = __traits(compiles, { string n = T.init.name(); int o = T.init.ordinal(); })
    && __traits(compiles, __traits(getMember, T, T.init.name()));

private string annotationValue(T)(T v)
{
    static if (announce!T)
    {
    }
    string r = "{\"type\":" ~ quote(typeName!T) ~ ",\"modules\":[" ~ typeModules!T ~ "],\"values\":{";
    static foreach (i, field; T.tupleof)
    {
        static if (i)
            r ~= ",";
        r ~= quote(__traits(identifier, T.tupleof[i])) ~ ":" ~ value(v.tupleof[i]);
    }
    return r ~ "}}";
}

private enum string attributesOf(attrs...) = attributes!attrs();

private string attributes(attrs...)()
{
    string r = "[";
    static foreach (i, a; attrs)
    {
        static if (i)
            r ~= ",";
        static if (is(a) && is(a == struct))
            r ~= annotationValue(a.init);
        else static if (is(typeof(a) == struct))
            r ~= annotationValue(a);
        else static if (is(a))
            r ~= "{\"type\":" ~ quote(typeName!a) ~ ",\"modules\":[" ~ typeModules!a ~ "],\"values\":{}}";
        else
            r ~= "{\"value\":" ~ value(a) ~ "}";
    }
    return r ~ "]";
}

private string describeAnnotationType(T)()
{
    string r = "{\"name\":" ~ quote(typeName!T) ~ ",\"modules\":[" ~ typeModules!T ~ "],\"meta\":"
        ~ attributesOf!(__traits(getAttributes, T)) ~ ",\"fields\":[";
    static foreach (i, field; T.tupleof)
    {
        static if (i)
            r ~= ",";
        r ~= "{\"name\":" ~ quote(__traits(identifier, T.tupleof[i])) ~ ",\"type\":" ~ typeRefOf!(typeof(field))
            ~ ",\"default\":" ~ value(T.init.tupleof[i]) ~ ",\"annotations\":"
            ~ attributesOf!(__traits(getAttributes, T.tupleof[i])) ~ "}";
    }
    return r ~ "]}";
}

private string function_(T, string name, size_t index, bool inherited)()
{
    alias F = __traits(getOverloads, T, name)[index];
    enum where = __traits(getLocation, F);
    string r = "{\"name\":" ~ quote(name) ~ ",\"file\":" ~ quoted!(where[0]) ~ ",\"line\":" ~ number(where[1])
        ~ ",\"visibility\":" ~ quote(__traits(getVisibility, F))
        ~ ",\"static\":" ~ (__traits(isStaticFunction, F) ? "true" : "false")
        ~ ",\"final\":" ~ (__traits(isFinalFunction, F) ? "true" : "false")
        ~ ",\"abstract\":" ~ (__traits(isAbstractFunction, F) ? "true" : "false")
        ~ ",\"override\":" ~ (__traits(isOverrideFunction, F) ? "true" : "false")
        ~ ",\"annotations\":" ~ attributesOf!(__traits(getAttributes, F));
    static if (is(typeof(F) R == return))
    {
        r ~= ",\"returns\":" ~ typeRefOf!R;
        static if (is(R == class) || is(R == interface))
            r ~= ",\"returnSupertypes\":[" ~ supertypeNamesOf!R ~ "]";
    }
    r ~= ",\"attributes\":" ~ wordsOf!(__traits(getFunctionAttributes, F));
    r ~= ",\"parameters\":[";
    static if (is(typeof(F) P == __parameters))
    {
        static foreach (i; 0 .. P.length)
        {
            static if (i)
                r ~= ",";
            // An unnamed parameter, as in void f(int), is named by its position.
            static if (__traits(compiles, __traits(identifier, P[i .. i + 1])))
                r ~= "{\"name\":" ~ quote(__traits(identifier, P[i .. i + 1]));
            else
                r ~= "{\"name\":" ~ quote("_param_" ~ number(i));
            r ~= ",\"type\":" ~ typeRefOf!(P[i])
                ~ ",\"storage\":" ~ wordsOf!(__traits(getParameterStorageClasses, F, i)) ~ ",\"annotations\":"
                ~ attributesOf!(__traits(getAttributes, P[i .. i + 1])) ~ "}";
        }
    }
    return r ~ "],\"inherited\":" ~ (inherited ? "true" : "false") ~ "}";
}

private enum string wordsOf(names...) = words!names();

private string words(names...)()
{
    string r = "[";
    static foreach (i, name; names)
    {
        static if (i)
            r ~= ",";
        r ~= quote(name);
    }
    return r ~ "]";
}

private enum string supertypeNamesOf(T) = supertypeNames!T();

private string supertypeNames(T)()
{
    string r;
    static if (is(T S == super))
    {
        static foreach (B; S)
        {
            static if (!is(B == Object))
            {
                r ~= (r.length ? "," : "") ~ quote(typeName!B);
                static if (supertypeNamesOf!B.length)
                    r ~= "," ~ supertypeNamesOf!B;
            }
        }
    }
    return r;
}

private enum string supertypesOf(T) = supertypes!T();

private string supertypes(T)()
{
    string r;
    static if (is(T S == super))
    {
        static foreach (i, B; S)
        {
            static if (i)
                r ~= ",";
            r ~= typeRefOf!B;
            static if (supertypesOf!B.length)
                r ~= "," ~ supertypesOf!B;
        }
    }
    return r;
}

private template isDerived(T, string member)
{
    enum isDerived = declares!T(member);
}

/// Whether T itself declares member: one unrolled comparison per member, not a recursive template, which made
/// O(members^2) instances per type.
private bool declares(T)(string member)
{
    static foreach (name; __traits(derivedMembers, T))
        if (name == member)
            return true;
    return false;
}

private string describeType(T)()
{
    string r;
    static if (is(T == class))
        enum kind = "class";
    else static if (is(T == interface))
        enum kind = "interface";
    else static if (is(T == enum))
        enum kind = "enum";
    else
        enum kind = "struct";
    r ~= "{\"name\":" ~ quote(__traits(identifier, T)) ~ ",\"fqn\":" ~ quote(typeName!T) ~ ",\"kind\":\"" ~ kind
        ~ "\"" ~ location!T() ~ ",\"visibility\":" ~ quote(__traits(getVisibility, T)) ~ ",\"annotations\":"
        ~ attributesOf!(__traits(getAttributes, T));
    static if (is(T == class))
        r ~= ",\"abstract\":" ~ (__traits(isAbstractClass, T) ? "true" : "false") ~ ",\"final\":"
            ~ (__traits(isFinalClass, T) ? "true" : "false");
    static if (is(T == class) || is(T == interface))
        r ~= ",\"supertypes\":[" ~ supertypesOf!T ~ "]";
    static if (is(T == enum))
    {
        r ~= ",\"constants\":[";
        static foreach (i, member; __traits(allMembers, T))
        {
            static if (i)
                r ~= ",";
            r ~= quote(member);
        }
        r ~= "]";
    }
    else
    {
        r ~= ",\"fields\":[";
        static foreach (i, field; T.tupleof)
        {
            static if (i)
                r ~= ",";
            r ~= "{\"name\":" ~ quote(__traits(identifier, T.tupleof[i])) ~ ",\"index\":" ~ number(i)
                ~ ",\"type\":" ~ typeRefOf!(typeof(field)) ~ ",\"visibility\":"
                ~ quote(__traits(getVisibility, T.tupleof[i])) ~ ",\"annotations\":"
                ~ attributesOf!(__traits(getAttributes, T.tupleof[i])) ~ "}";
        }
        r ~= "],\"methods\":[";
        bool firstMethod = true;
        // Classes and interfaces list inherited methods too: a proxy forwards them, a repository implements them.
        static if (is(T == class) || is(T == interface))
            alias members = __traits(allMembers, T);
        else
            alias members = __traits(derivedMembers, T);
        static foreach (member; members)
        {
            static if (member != "this" && member != "Monitor" && member != "factory"
                    && (member.length < 2 || member[0 .. 2] != "__" || member == "__ctor")
                    && __traits(compiles, __traits(getOverloads, T, member)))
            {
                static foreach (index, overload; __traits(getOverloads, T, member))
                {
                    // Object's own methods are the same for every class; the generator never needs them.
                    static if (!__traits(isSame, __traits(parent, overload), Object))
                    {
                        if (!firstMethod)
                            r ~= ",";
                        firstMethod = false;
                        r ~= function_!(T, member, index, !isDerived!(T, member))();
                    }
                }
            }
        }
        r ~= "]";
    }
    return r ~ "}";
}
`;
