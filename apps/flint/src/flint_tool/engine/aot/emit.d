/// Flint AOT's emitter: one plain D module per module plan, plus the thin registry (docs/spring/aot-contract.md
/// sections 3-8).
///
/// Generated code is `@safe`, declares no templates and instantiates only `Any.of!T`, `Any.get!T` and
/// `flint.engine.aot.permanent`'s carving functions. It imports
/// its own user module, the modules declaring the types it names (statically), the annotation modules whose values
/// it spells, and `flint.engine.aot.*`; never another generated module.
module flint_tool.engine.aot.emit;

import flint_tool.engine.aot.merge : MergedSet;
import flint_tool.engine.aot.model : Annotation, Method, Parameter, TypeRef, Value;
import flint_tool.engine.aot.plan : ArgumentPlan, BeanPlan, ConfigPlan, DescriptorPlan,
    ExceptionPlan, HandlerPlan, ListenerPlan, ModulePlan, Plan, Point, ProxyPlan, QueryPlan;

@safe:

/// The contract version generated code targets.
enum contractVersion = 3;

/// The generated module's name for an extracted module.
string generatedName(string moduleName)
{
    return "flint_aot." ~ moduleName;
}

/// The generated module's path under `.flint/generated/aot/`, mirroring its source path.
string generatedPath(string moduleName, bool packageModule)
{
    import std.array : split;
    import std.path : buildPath;

    // The platform's separators throughout: the driver compares these paths with directory listings (Windows).
    const base = buildPath(["flint_aot"] ~ moduleName.split("."));
    return packageModule ? buildPath(base, "package.d") : base ~ ".d";
}

/// Render one generated module.
string renderModule(const ref ModulePlan plan, const string[string] canonicalNames = null)
{
    auto emitter = Emitter(plan, canonicalNames);
    return emitter.render();
}

/// Render the registry. `modules` lists the generated modules in definition order.
string renderRegistry(const ref Plan plan, scope const string[] modules)
{
    import std.conv : to;
    import flint_tool.engine.aot.conditions : literal;
    import flint_tool.engine.aot.names : entryPoint;

    string text = "// Generated by Flint AOT (contract " ~ contractVersion.to!string ~ "). Do not edit.\n"
        ~ "module flint_aot_registry;\n\nimport flint.engine.aot.registry : AotRegistry, installRegistry;\n";
    // META-INF/services providers: importing a provider's module keeps it, its ModuleInfo and its constructors in
    // a static link, where nothing else may reference it (java.util.ServiceLoader's discovery, aot-contract section 3).
    foreach (name; plan.serviceModules)
        text ~= "static import " ~ name ~ ";\n";
    text ~= "\n@safe:\n\n";
    foreach (name; modules)
        text ~= "extern (C) void " ~ entryPoint(name) ~ "(scope AotRegistry registry) @safe;\n";
    text ~= "\nprivate void populate(scope AotRegistry registry)\n{\n    registry.begin(" ~ contractVersion.to!string
        ~ ", " ~ modules.length.to!string ~ ");\n    registry.application(" ~ literal(
                plan.application) ~ ", " ~ stringArray(plan.scanPackages) ~ ");\n";
    foreach (name; modules)
        text ~= "    " ~ entryPoint(name) ~ "(registry);\n";
    return text ~ "    registry.end();\n}\n\nshared static this()\n{\n    installRegistry(&populate);\n}\n";
}

/// A D array literal of strings, or `null`.
string stringArray(scope const string[] items)
{
    import std.array : join;
    import flint_tool.engine.aot.conditions : literal;

    if (items.length == 0)
        return "null";
    string[] parts;
    foreach (item; items)
        parts ~= literal(item);
    return "[" ~ parts.join(", ") ~ "]";
}

/// A D identifier made of `text`'s letters, digits and underscores.
string sanitize(string text)
{
    import std.ascii : isAlphaNum;

    string result;
    foreach (char ch; text)
        result ~= isAlphaNum(ch) ? ch : '_';
    return result;
}

/// What generated code carves from its `Permanent`, by D type: lists and their elements, boxed values, objects.
private struct Reservation
{
    size_t[string] lists;
    size_t[string] elements;
    size_t[string] boxes;
    size_t[string] objects;

    /// The bytes as a D expression of `Permanent`'s size functions, in a stable order; "0" when nothing is carved.
    string expression() const
    {
        import std.array : join;
        import std.conv : to;

        string[] terms;
        foreach (type; sorted(lists))
            terms ~= "Permanent.bytes!(" ~ type ~ ")(" ~ lists[type].to!string ~ ", " ~ elements[type].to!string ~ ")";
        foreach (type; sorted(boxes))
            terms ~= "Permanent.boxBytes!(" ~ type ~ ")(" ~ boxes[type].to!string ~ ")";
        foreach (type; sorted(objects))
            terms ~= "Permanent.objectBytes!(" ~ type ~ ")(" ~ objects[type].to!string ~ ")";
        return terms.length ? terms.join("\n    + ") : "0";
    }

    private static string[] sorted(const size_t[string] counts)
    {
        import std.algorithm.sorting : sort;

        auto keys = counts.keys;
        sort(keys);
        return keys;
    }
}

private struct Emitter
{
    const ModulePlan plan;
    /// Canonical names of template instances (Plan.canonicalNames).
    const(string[string]) canonicalNames;
    bool[string] imports;
    bool[string] used;
    string[string] descriptorLocal;
    string body_;
    /// Whether the code being emitted carves its tables from a `permanent` in scope: a `describe_` function or the
    /// registration (flint.engine.aot.permanent). Elsewhere lists, boxes and objects stay GC literals.
    bool permanentScope;
    /// What the code being emitted carves, by type, for its reservation.
    Reservation reservation;
    /// The `describeBytes_` enums of this module's descriptors, which the registration reserves with its own.
    string[] describeBytes;

    /// The `permanent.list` call, or the array literal outside a permanent scope; "null" when `parts` is empty.
    string list(string type, scope const string[] parts, string separator = ", ")
    {
        import std.array : join;

        if (parts.length == 0)
            return "null";
        if (!permanentScope)
            return "[" ~ parts.join(separator) ~ "]";
        reservation.lists[type] = reservation.lists.get(type, 0) + 1;
        reservation.elements[type] = reservation.elements.get(type, 0) + parts.length;
        return "permanent.list!(" ~ type ~ ")(" ~ parts.join(separator) ~ ")";
    }

    /// A string list (`stringArray`), carved in a permanent scope.
    string strings(scope const string[] items)
    {
        import flint_tool.engine.aot.conditions : literal;

        string[] parts;
        foreach (item; items)
            parts ~= literal(item);
        return list("string", parts);
    }

    /// `Any.of(value)` of a `type` value, its box carved in a permanent scope.
    string boxed(string type, string value)
    {
        if (!permanentScope)
            return "Any.of(" ~ value ~ ")";
        reservation.boxes[type] = reservation.boxes.get(type, 0) + 1;
        return "permanent.any(" ~ value ~ ")";
    }

    /// `new type(arguments)`, carved in a permanent scope.
    string object(string type, string arguments)
    {
        if (!permanentScope)
            return "new " ~ type ~ "(" ~ arguments ~ ")";
        reservation.objects[type] = reservation.objects.get(type, 0) + 1;
        return "permanent.make!(" ~ type ~ ")(" ~ arguments ~ ")";
    }

    /// Start a permanent scope with nothing reserved yet.
    void beginPermanent()
    {
        permanentScope = true;
        reservation = Reservation.init;
    }

    /// End the permanent scope: the D expression of the bytes its code carves.
    string endPermanent()
    {
        permanentScope = false;
        auto result = reservation.expression();
        reservation = Reservation.init;
        return result;
    }

    string render()
    {
        import std.algorithm.sorting : sort;
        import std.conv : to;

        imports[plan.name] = true;
        foreach (name; plan.containerModules)
            imports[name] = true;
        string declarations;
        foreach (ref config; plan.configurations)
            declarations ~= configuration(config);
        foreach (ref proxy; plan.proxies)
            declarations ~= proxyClass(proxy);
        foreach (ref descriptor; plan.descriptors)
            declarations ~= descriptorFunctions(descriptor);
        foreach (ref bean; plan.beans)
            declarations ~= beanFunctions(bean);
        foreach (ref handler; plan.handlers)
            declarations ~= handlerInvoker(handler);
        foreach (ref handler; plan.exceptionHandlers)
            declarations ~= exceptionInvoker(handler);
        foreach (ref listener; plan.listeners)
            declarations ~= listenerInvoker(listener);
        const entry = registration();
        string[] names = imports.keys;
        sort(names);
        string importText;
        foreach (name; names)
        {
            if (name != "object" && name.length)
                importText ~= "static import " ~ name ~ ";\n";
        }
        return "// Generated by Flint AOT (contract " ~ contractVersion.to!string ~ ") from " ~ plan.source
            ~ ". Do not edit.\nmodule " ~ generatedName(plan.name) ~ ";\n\n" ~ runtimeImports()
            ~ importText ~ "\n@safe:\n\n" ~ declarations ~ body_ ~ entry;
    }

    string runtimeImports()
    {
        string text = "import flint.engine.aot.any : Any;\n";
        if (plan.beans.length || plan.proxies.length || plan.configurations.length)
            text ~= "import flint.engine.aot.bean : BeanDefinition, BeanFactory, ScopeKind;\n";
        if ("condition" in used)
            text ~= "import flint.engine.aot.condition : ConditionContext;\n";
        if (plan.descriptors.length)
            text ~= "import flint.engine.aot.descriptor : ConstructorDescriptor, Descriptor, MergedAnnotation, "
                ~ "MethodDescriptor, ParameterDescriptor, PropertyDescriptor, TypeKind;\n";
        else if ("merged" in used)
            text ~= "import flint.engine.aot.descriptor : MergedAnnotation;\n";
        if (plan.listeners.length)
            text ~= "import flint.engine.aot.event : EventListenerSpec;\n";
        if ("expression" in used)
            text ~= "import flint.engine.aot.expression : EvaluationContext, ExpressionSpec;\n";
        if (plan.handlers.length || plan.exceptionHandlers.length)
            text ~= "import flint.engine.aot.mapping : ArgumentKind, ArgumentSpec, ExceptionHandlerSpec, "
                ~ "HandlerArguments, HandlerMapping;\n";
        if (plan.proxies.length)
            text ~= "import flint.engine.aot.proxy : AdviceChain, Invocation, adviceChain, allocateProxy;\n";
        if (plan.queries.length)
            text ~= "import flint.engine.aot.query : DerivedQuery, QueryKind;\n";
        if ("permanent" in used || plan.descriptors.length)
            text ~= "import flint.engine.aot.permanent : Permanent;\n";
        return text ~ "import flint.engine.aot.registry : AotRegistry;\n";
    }

    /// The type name a descriptor looks a property's type up by. A template instance is spelled by engine-aot's
    /// `typeNameOf` (`Optional!int`, not the source's `Optional!(int)`), as `descriptorOf` registers it.
    string typeNameText(string type)
    {
        import std.algorithm.searching : canFind;
        import flint_tool.engine.aot.conditions : literal;

        if (!type.canFind("!("))
            return literal(type);
        // A literal when the extraction gave the runtime's spelling: typeNameOf!(T) would instantiate T here.
        if (const canonical = type in canonicalNames)
            return literal(*canonical);
        return "imported!\"flint.engine.aot.name\".typeNameOf!(" ~ type ~ ")";
    }

    /// Note the modules a type needs.
    void need(const ref TypeRef type)
    {
        foreach (name; type.modules)
            imports[name] = true;
    }

    void needModuleOf(string fqn)
    {
        import flint_tool.engine.aot.names : packageOf;

        // Types named only by string never need an import; this is for types spelled in code, whose declaring
        // module is the plan's own or recorded in a TypeRef.
        if (fqn.length)
            imports[packageOf(fqn)] = true;
    }

    // ---- values and annotations ----

    string value(const ref Value item)
    {
        import std.conv : to;
        import flint_tool.engine.aot.conditions : literal;

        final switch (item.kind)
        {
        case Value.Kind.null_:
            return "null";
        case Value.Kind.boolean:
            return item.boolean ? "true" : "false";
        case Value.Kind.integer:
            return item.integer.to!string;
        case Value.Kind.text:
            return literal(item.text);
        case Value.Kind.raw:
            return item.text;
        case Value.Kind.enumMember:
            return enumMember(item);
        case Value.Kind.array:
            return array(item);
        case Value.Kind.annotation:
            return annotationLiteral(item.nested[0]);
        }
    }

    string enumMember(const ref Value item)
    {
        foreach (name; item.modules)
            imports[name] = true;
        return item.enumType ~ "." ~ item.text;
    }

    string array(const ref Value item)
    {
        if (item.items.length == 0)
            return "null";
        string[] parts;
        foreach (ref element; item.items)
            parts ~= value(element);
        const type = elementType(item);
        if (type is null)
        {
            // An element type the literal leaves to the field (integers, mixed values): a GC literal.
            const scope_ = permanentScope;
            permanentScope = false;
            scope (exit)
                permanentScope = scope_;
            return list("", parts);
        }
        return list(type, parts);
    }

    /// The D element type of an annotation array value whose spelling fixes it (strings, enum members of one enum,
    /// annotations of one type), or null.
    static string elementType(const ref Value item)
    {
        string type;
        foreach (ref element; item.items)
        {
            string next;
            if (element.kind == Value.Kind.text)
                next = "string";
            else if (element.kind == Value.Kind.enumMember)
                next = element.enumType;
            else if (element.kind == Value.Kind.annotation)
                next = element.nested[0].type;
            if (next is null || (type !is null && next != type))
                return null;
            type = next;
        }
        return type;
    }

    /// An expression of the annotation's struct type with every field set.
    string annotationLiteral(const ref Annotation annotation)
    {
        foreach (name; annotation.modules)
            imports[name] = true;
        string text = "() { " ~ annotation.type ~ " a; ";
        foreach (index, name; annotation.names)
        {
            if (annotation.values[index].kind != Value.Kind.null_)
                text ~= "a." ~ name ~ " = " ~ value(annotation.values[index]) ~ "; ";
        }
        return text ~ "return a; }()";
    }

    /// A merged annotation table: `merged` as aggregate 0, then each of `inherited` (contract 3, `aggregateIndex`).
    string mergedArray(const ref MergedSet merged, string indent, const MergedSet[] inherited = null)
    {
        import std.conv : to;
        import flint_tool.engine.aot.conditions : literal;

        string[] parts;
        foreach (aggregate; 0 .. inherited.length + 1)
        {
            const items = aggregate == 0 ? merged.items : inherited[aggregate - 1].items;
            foreach (ref item; items)
            {
                const index = aggregate == 0 ? "" : ", " ~ aggregate.to!string;
                const value = annotationLiteral(item.annotation);
                parts ~= "\n" ~ indent ~ "    MergedAnnotation(" ~ literal(
                        item.annotation.type) ~ ", " ~ boxed(item.annotation.type,
                        value) ~ ", " ~ item.distance.to!string ~ index ~ ")";
            }
        }
        if (parts.length == 0)
            return "null";
        used["merged"] = true;
        return list("MergedAnnotation", parts, ",");
    }

    static bool hasInherited(const ref DescriptorPlan descriptor)
    {
        foreach (ref item; descriptor.inherited)
        {
            if (item.items.length)
                return true;
        }
        return false;
    }

    // ---- beans ----

    string point(const ref Point item)
    {
        import std.algorithm.searching : startsWith;
        import flint_tool.engine.aot.conditions : literal;
        import flint_tool.engine.aot.plan : PointKind;

        const qualifier = item.qualifier.length ? literal(item.qualifier) : "null";
        foreach (name; item.modules)
            imports[name] = true;
        final switch (item.kind)
        {
        case PointKind.bean:
            return "cast(" ~ item.type ~ ") factory.getBeanOfType(" ~ literal(item.lookup) ~ ", " ~ qualifier ~ ")";
        case PointKind.spel:
            return item.expression;
        case PointKind.value:
            return "factory.resolveValue(" ~ literal(
                    item.expression) ~ ", " ~ literal(item.type) ~ ").get!(" ~ item.type ~ ")()";
        case PointKind.beans:
            const array = "() { " ~ item.lookup ~ "[] beans; foreach (bean; factory.getBeansOfType(" ~ literal(
                    item.lookup) ~ ")) beans ~= cast(" ~ item.lookup ~ ") bean; return beans; }()";
            return item.type.startsWith("flint.java.util.List!(") ? item.type ~ "(" ~ array ~ ")" : array;
        case PointKind.optional:
            const found = "cast(" ~ item.lookup ~ ") factory.findBeanOfType(" ~ literal(
                    item.lookup) ~ ", " ~ qualifier ~ ")";
            if (item.type.startsWith("flint.java.util.Optional!("))
                return item.type ~ ".ofNullable(" ~ found ~ ")";
            if (item.type.startsWith("std.typecons.Nullable!("))
                return "(" ~ item.lookup ~ " bean) { return bean is null ? (" ~ item.type
                    ~ ").init : " ~ item.type ~ "(bean); }(" ~ found ~ ")";
            return found;
        }
    }

    string arguments(const Point[] points)
    {
        import std.array : join;

        string[] parts;
        foreach (ref item; points)
            parts ~= point(item);
        return parts.join(", ");
    }

    /// The id of a bean's generated functions: its name, unless an earlier bean in the module has the same one
    /// (two configurations with mutually exclusive conditions may define `@Bean filterChain`), then with its class.
    string beanId(const ref BeanPlan bean)
    {
        bool[string] taken;
        foreach (ref other; plan.beans)
        {
            const plain = sanitize(other.name);
            const owner = other.configBean.length ? other.configBean : other.className;
            const id = plain in taken ? plain ~ "_" ~ sanitize(owner) : plain;
            if (&other is &bean)
                return id;
            taken[id] = true;
            taken[plain] = true;
        }
        return sanitize(bean.name);
    }

    string beanFunctions(const ref BeanPlan bean)
    {
        const id = beanId(bean);
        string text = "private Object create_" ~ id ~ "(BeanFactory factory)\n{\n    return " ~ creation(
                bean) ~ ";\n}\n\n";
        if (needsInitialize(bean))
            text ~= initializeFunction(bean, id);
        if (needsDestroy(bean))
            text ~= destroyFunction(bean, id);
        if (bean.condition.length)
        {
            used["condition"] = true;
            text ~= "private bool condition_" ~ id ~ "(ConditionContext c)\n{\n    return " ~ bean.condition
                ~ ";\n}\n\n";
        }
        if (bean.proxied)
            text ~= proxyFactory(bean, id);
        return text;
    }

    string creation(const ref BeanPlan bean)
    {
        import flint_tool.engine.aot.conditions : literal;
        import flint_tool.engine.aot.merge : shortName;
        import flint_tool.engine.aot.plan : FactoryKind;

        final switch (bean.factory)
        {
        case FactoryKind.constructor:
            return "new " ~ bean.className ~ "(" ~ arguments(bean.arguments) ~ ")";
        case FactoryKind.configuration:
            return "new " ~ shortName(bean.className) ~ "__FlintConfiguration(factory" ~ (
                    bean.arguments.length ? ", " ~ arguments(bean.arguments) : "") ~ ")";
        case FactoryKind.staticMethod:
            return "cast(Object) " ~ bean.className ~ "." ~ bean.method ~ "(" ~ arguments(bean.arguments) ~ ")";
        case FactoryKind.expression:
            foreach (name; bean.expressionModules)
                imports[name] = true;
            return bean.expression;
        case FactoryKind.method:
            const owner = bean.configProxied
                ? shortName(bean.className) ~ "__FlintConfiguration" : bean.className;
            const call = bean.configProxied ? "__flintCall_" ~ bean.method : bean.method;
            return "cast(Object) (cast(" ~ owner ~ ") factory.getBean(" ~ literal(
                    bean.configBean) ~ "))." ~ call ~ "(" ~ arguments(bean.arguments) ~ ")";
        }
    }

    static bool needsInitialize(const ref BeanPlan bean)
    {
        return bean.fields.length || bean.postConstruct.length || bean.initializingBean
            || bean.initMethod.length || bean.propertiesPrefix.length;
    }

    static bool needsDestroy(const ref BeanPlan bean)
    {
        return bean.preDestroy.length || bean.disposableBean || bean.destroyMethod.length;
    }

    string initializeFunction(const ref BeanPlan bean, string id)
    {
        import flint_tool.engine.aot.conditions : literal;

        string text = "private void initialize_" ~ id
            ~ "(Object bean, BeanFactory factory)\n{\n    auto target = cast(" ~ bean.type ~ ") bean;\n";
        foreach (ref field; bean.fields)
        {
            const owner = field.owner == bean.type ? "target" : "(cast(" ~ field.owner ~ ") target)";
            text ~= "    " ~ owner ~ ".tupleof[" ~ indexText(field.index) ~ "] = " ~ point(field.point) ~ ";\n";
        }
        if (bean.propertiesPrefix.length)
            text ~= "    factory.bind(" ~ literal(bean.propertiesPrefix) ~ ", Any.of(target));\n";
        foreach (method; bean.postConstruct)
            text ~= "    target." ~ method ~ "();\n";
        if (bean.initializingBean)
            text ~= "    target.afterPropertiesSet();\n";
        if (bean.initMethod.length)
            text ~= "    target." ~ bean.initMethod ~ "();\n";
        return text ~ "}\n\n";
    }

    static string indexText(long index)
    {
        import std.conv : to;

        return index.to!string;
    }

    string destroyFunction(const ref BeanPlan bean, string id)
    {
        string text = "private void destroy_" ~ id ~ "(Object bean)\n{\n    auto target = cast("
            ~ bean.type ~ ") bean;\n";
        foreach (method; bean.preDestroy)
            text ~= "    target." ~ method ~ "();\n";
        if (bean.disposableBean)
            text ~= "    target.destroy();\n";
        if (bean.destroyMethod.length && !(bean.disposableBean && bean.destroyMethod == "destroy"))
            text ~= "    target." ~ bean.destroyMethod ~ "();\n";
        return text ~ "}\n\n";
    }

    string proxyFactory(const ref BeanPlan bean, string id)
    {
        import flint_tool.engine.aot.merge : shortName;

        const proxy = shortName(bean.type) ~ "__FlintProxy";
        const described = sanitize(shortName(bean.type));
        return "private Object proxy_" ~ id ~ "(Object target, BeanFactory factory)\n{\n"
            ~ "    auto permanent = Permanent(describeBytes_" ~ described ~ ");\n    auto descriptor = describe_"
            ~ described ~ "(permanent);\n    auto proxy = cast(" ~ proxy ~ ") allocateProxy(typeid("
            ~ proxy ~ "));\n    proxy.__flintBind(cast(" ~ bean.type
            ~ ") target, adviceChain(factory, descriptor), descriptor);\n    return proxy;\n}\n\n";
    }

    string beanDefinition(const ref BeanPlan bean)
    {
        import std.conv : to;
        import flint_tool.engine.aot.conditions : literal;

        const id = beanId(bean);
        string text = "    {\n        BeanDefinition definition;\n        definition.name = " ~ literal(
                bean.name) ~ ";\n        definition.type = " ~ literal(
                bean.type) ~ ";\n        definition.types = " ~ strings(bean.types) ~ ";\n";
        if (bean.objectTypes.length)
            text ~= "        definition.objectTypes = " ~ strings(bean.objectTypes) ~ ";\n";
        text ~= "        definition.rank = " ~ (bean.rank + 1).to!string ~ ";\n";
        if (bean.dependsOn.length)
            text ~= "        definition.dependsOn = " ~ strings(bean.dependsOn) ~ ";\n";
        if (bean.qualifiers.length)
            text ~= "        definition.qualifiers = " ~ strings(bean.qualifiers) ~ ";\n";
        if (bean.scope_ != "singleton")
            text ~= "        definition.scope_ = ScopeKind." ~ sanitize(bean.scope_) ~ ";\n";
        foreach (flag, set; [
            "primary": bean.primary,
            "fallback": bean.fallback,
            "lazyInit": bean.lazyInit,
            "autoConfiguration": bean.autoConfiguration
        ])
        {
            if (set)
                text ~= "        definition." ~ flag ~ " = true;\n";
        }
        text ~= "        definition.order = " ~ (bean.order == int.max
                ? "int.max" : bean.order.to!string) ~ ";\n" ~ "        definition.source = " ~ literal(
                bean.source) ~ ";\n        definition.create = &create_" ~ id ~ ";\n";
        if (needsInitialize(bean))
            text ~= "        definition.initialize = &initialize_" ~ id ~ ";\n";
        if (needsDestroy(bean))
            text ~= "        definition.destroy = &destroy_" ~ id ~ ";\n";
        if (bean.condition.length)
            text ~= "        definition.condition = &condition_" ~ id ~ ";\n";
        if (bean.proxied)
            text ~= "        definition.proxy = &proxy_" ~ id ~ ";\n";
        return text ~ "        registry.bean(definition);\n    }\n";
    }

    // ---- configuration and proxy subclasses ----

    static string postfixAttributes(const ref Method method)
    {
        string text;
        foreach (attribute; method.attributes)
        {
            if (attribute == "ref" || attribute == "@safe" || attribute == "@trusted"
                    || attribute == "@system" || attribute == "@live")
                continue;
            text ~= " " ~ attribute;
        }
        return text;
    }

    string signature(const ref Method method, string name)
    {
        need(method.returns);
        const parameters = parameterList(method);
        return (method.has("ref") ? "ref " : "") ~ method.returns.name ~ " " ~ name ~ "(" ~ parameters
            ~ ")" ~ postfixAttributes(method);
    }

    string parameterList(const ref Method method)
    {
        import std.array : join;

        string[] parameters;
        foreach (index, ref parameter; method.parameters)
        {
            need(parameter.type);
            string storage;
            foreach (item; parameter.storage)
                storage ~= item ~ " ";
            parameters ~= storage ~ parameter.type.name ~ " " ~ parameterName(parameter, index);
        }
        return parameters.join(", ");
    }

    static string parameterName(const ref Parameter parameter, size_t index)
    {
        import std.conv : to;

        return parameter.name.length ? parameter.name : "__flintArgument" ~ index.to!string;
    }

    static string callArguments(const ref Method method)
    {
        import std.array : join;

        string[] names;
        foreach (index, ref parameter; method.parameters)
            names ~= parameterName(parameter, index);
        return names.join(", ");
    }

    string configuration(const ref ConfigPlan config)
    {
        import std.array : join;
        import flint_tool.engine.aot.conditions : literal;

        string[] parameters;
        string[] names;
        foreach (index, ref parameter; config.parameters)
        {
            need(parameter.type);
            parameters ~= parameter.type.name ~ " " ~ parameterName(parameter, index);
            names ~= parameterName(parameter, index);
        }
        string text = "/// `@Configuration` " ~ config.simple ~ " with bean methods that return the container's "
            ~ "instances (aot-contract.md section 5.3).\nfinal class " ~ config.simple ~ "__FlintConfiguration : "
            ~ config.className ~ "\n{\n    private BeanFactory __flintFactory;\n\n    this(BeanFactory factory" ~ (
                    parameters.length ? ", " ~ parameters.join(", ") : "") ~ ")\n    {\n" ~ (names.length
                    ? "        super(" ~ names.join(", ") ~ ");\n" : "") ~ "        __flintFactory = factory;\n    }\n";
        foreach (index, ref method; config.methods)
        {
            text ~= "\n    override " ~ signature(method,
                    method.name) ~ "\n    {\n        return cast(" ~ method.returns.name
                ~ ") __flintFactory.getBean(" ~ literal(config.beans[index]) ~ ");\n    }\n\n    " ~ signature(method,
                        "__flintCall_" ~ method.name) ~ "\n    {\n        return super."
                ~ method.name ~ "(" ~ callArguments(method) ~ ");\n    }\n";
        }
        return text ~ "}\n\n";
    }

    string proxyClass(const ref ProxyPlan proxy)
    {
        string text = "/// The AOP proxy of " ~ proxy.simple ~ ": advised methods run the advice chain, every other "
            ~ "public method forwards to the target (aot-contract.md section 7).\nfinal class "
            ~ proxy.simple ~ "__FlintProxy : " ~ proxy.className ~ "\n{\n    private " ~ proxy.className
            ~ " __flintTarget;\n    private AdviceChain __flintChain;\n    private Descriptor __flintDescriptor;\n\n"
            ~ proxyConstructor(proxy) ~ "    void __flintBind(" ~ proxy.className
            ~ " target, AdviceChain chain, Descriptor descriptor)\n    {\n        __flintTarget = target;\n"
            ~ "        __flintChain = chain;\n        __flintDescriptor = descriptor;\n    }\n";
        foreach (ref item; proxy.methods)
            text ~= "\n" ~ proxyMethod(item);
        return text ~ "}\n\n";
    }

    /// Never called (allocateProxy runs no constructor), but D requires one when the base has no default.
    string proxyConstructor(const ref ProxyPlan proxy)
    {
        import std.array : join;

        const(Method)* chosen;
        foreach (ref constructor; proxy.constructors)
        {
            if (constructor.parameters.length == 0)
                return "";
            bool usable = true;
            foreach (ref parameter; constructor.parameters)
            {
                foreach (storage; parameter.storage)
                    usable = usable && storage != "ref" && storage != "out";
            }
            if (usable && chosen is null)
                chosen = &constructor;
        }
        if (chosen is null)
            return "";
        string[] initial;
        foreach (ref parameter; chosen.parameters)
        {
            need(parameter.type);
            initial ~= "(" ~ parameter.type.name ~ ").init";
        }
        return "    private this()\n    {\n        super(" ~ initial.join(", ") ~ ");\n    }\n\n";
    }

    string proxyMethod(const ref imported!"flint_tool.engine.aot.plan".ProxyMethod item)
    {
        import std.array : join;
        import std.conv : to;

        const method = &item.method;
        const call = "__flintTarget." ~ method.name ~ "(" ~ callArguments(*method) ~ ")";
        const returnsVoid = method.returns.name == "void";
        const header = "    override " ~ signature(*method, method.name) ~ "\n    {\n";
        if (!item.advised)
            return header ~ "        " ~ (returnsVoid ? "" : "return ") ~ call ~ ";\n    }\n";
        string[] boxed;
        foreach (index, ref parameter; method.parameters)
            boxed ~= "Any.of(" ~ parameterName(parameter, index) ~ ")";
        const index = item.index.to!string;
        const arguments = boxed.length ? "[" ~ boxed.join(", ") ~ "]" : "null";
        const invocation = "        auto invocation = Invocation(&__flintDescriptor.methods["
            ~ index ~ "], __flintTarget, " ~ arguments ~ ");\n";
        const names = callArguments(*method);
        if (item.async_)
            return header ~ invocation ~ "        auto target = __flintTarget;\n        __flintChain.invokeDetached("
                ~ "invocation, (ref Invocation call) { target." ~ method.name ~ "(" ~ names ~ "); });\n    }\n";
        const chain = "        __flintChain.invoke(invocation, (ref Invocation call) { " ~ (returnsVoid
                ? call : "call.result = Any.of(" ~ call ~ ")") ~ "; });\n";
        if (returnsVoid)
            return header ~ invocation ~ chain ~ "    }\n";
        const result = method.returns.name;
        if (!anyForm(item))
            return header ~ invocation ~ chain ~ "        return invocation.result.get!(" ~ result ~ ")();\n    }\n";
        // The result as the chain left it, for a caller that boxes it anyway (an array invoker); the typed method
        // unboxes it, so the value is boxed once on that path.
        const any = anyName(*method);
        const typed = header ~ "        return " ~ any ~ "(" ~ names ~ ").get!(" ~ result ~ ")();\n    }\n";
        const attributes = postfixAttributes(*method);
        const anyHeader = "    Any " ~ any ~ "(" ~ parameterList(*method) ~ ")" ~ attributes ~ "\n    {\n";
        const anyResult = "        if (invocation.result.holds!(" ~ result
            ~ "))\n            return invocation.result;\n"
            ~ "        return Any.of(invocation.result.get!(" ~ result ~ ")());\n    }\n";
        return typed ~ "\n" ~ anyHeader ~ invocation ~ chain ~ anyResult;
    }

    /// Whether an advised method also gets the `Any` form (`__flintAny_<name>`): it returns a value by value, runs
    /// synchronously, and is not a template.
    static bool anyForm(const ref imported!"flint_tool.engine.aot.plan".ProxyMethod item)
    {
        return item.advised && !item.async_ && item.method.returns.name != "void" && !item.method.has("ref");
    }

    static string anyName(const ref Method method)
    {
        return "__flintAny_" ~ method.name;
    }

    // ---- descriptors ----

    string descriptorFunctions(const ref DescriptorPlan descriptor)
    {
        import std.conv : to;
        import flint_tool.engine.aot.conditions : literal;

        const id = sanitize(descriptor.simple);
        descriptorLocal[descriptor.type] = "descriptor_" ~ id;
        string text;
        foreach (ref property; descriptor.properties)
        {
            foreach (name; property.modules)
                imports[name] = true;
            text ~= accessors(descriptor, property, id);
        }
        if (descriptor.create.length)
            text ~= "private Any new_" ~ id ~ "()\n{\n    return Any.of(" ~ (descriptor.create == "init"
                    ? descriptor.type ~ ".init" : "new " ~ descriptor.type ~ "()") ~ ");\n}\n\n";
        foreach (index, ref constructor; descriptor.constructors)
            text ~= constructorFunction(descriptor, constructor, id, index);
        text ~= expressionFunctions(descriptor, id);
        if (descriptor.constants.length)
            text ~= enumFunction(descriptor, id);
        return text ~ describeFunction(descriptor, id);
    }

    /// `describe_<id>`, which builds the descriptor.
    string describeFunction(const ref DescriptorPlan descriptor, string id)
    {
        import std.conv : to;
        import flint_tool.engine.aot.conditions : literal;

        beginPermanent();
        string text = "private Descriptor describe_" ~ id ~ "(ref Permanent permanent)\n{\n    auto descriptor = "
            ~ object("Descriptor", literal(descriptor.type) ~ ", TypeKind." ~ descriptor.kind) ~ ";\n";
        if (descriptor.supertypes.length)
            text ~= "    descriptor.supertypes = " ~ strings(descriptor.supertypes) ~ ";\n";
        if (descriptor.annotations.items.length || hasInherited(descriptor))
            text ~= "    descriptor.annotations = " ~ mergedArray(descriptor.annotations, "    ",
                    descriptor.inherited) ~ ";\n";
        if (descriptor.properties.length)
        {
            string[] properties;
            foreach (ref property; descriptor.properties)
                properties ~= "\n        PropertyDescriptor(" ~ literal(property.name) ~ ", " ~ typeNameText(
                        property.type) ~ ", " ~ mergedArray(property.annotations,
                        "        ") ~ ", &get_" ~ id ~ "_" ~ sanitize(property.name) ~ ", " ~ (property.writable
                        ? "&set_" ~ id ~ "_" ~ sanitize(property.name) : "null") ~ ")";
            text ~= "    descriptor.properties = " ~ list("PropertyDescriptor", properties, ",") ~ ";\n";
        }
        if (descriptor.methods.length)
        {
            string[] methods;
            foreach (index, ref method; descriptor.methods)
                methods ~= "\n        MethodDescriptor(" ~ literal(method.method.name) ~ ", " ~ literal(
                        method.method.returns.name) ~ ", " ~ parameterDescriptors(method) ~ ", " ~ mergedArray(
                        method.annotations, "        ", method.inherited) ~ ", " ~ index.to!string ~ ")";
            text ~= "    descriptor.methods = " ~ list("MethodDescriptor", methods, ",") ~ ";\n";
            text ~= expressionTables(descriptor, id);
        }
        if (descriptor.constructors.length)
        {
            string[] constructors;
            foreach (index, ref constructor; descriptor.constructors)
                constructors ~= "\n        ConstructorDescriptor(" ~ constructorParameters(
                        constructor) ~ ", " ~ mergedArray(constructor.annotations,
                        "        ") ~ ", &construct_" ~ id ~ "_" ~ index.to!string ~ (constructor.kind == "literal"
                        ? ", true" : "") ~ ")";
            text ~= "    descriptor.constructors = " ~ list("ConstructorDescriptor", constructors, ",") ~ ";\n";
        }
        if (descriptor.create.length)
            text ~= "    descriptor.create = &new_" ~ id ~ ";\n";
        if (descriptor.constants.length)
            text ~= "    descriptor.enumConstants = " ~ strings(
                    descriptor.constants) ~ ";\n" ~ "    descriptor.enumValue = &enum_" ~ id ~ ";\n";
        text ~= "    return descriptor;\n}\n\n";
        // The registration reserves this with its own tables; a proxy factory reserves it alone.
        describeBytes ~= "describeBytes_" ~ id;
        return text ~ "private enum size_t describeBytes_" ~ id ~ " = " ~ endPermanent() ~ ";\n\n";
    }

    /// Contract 2: an enum constant by its declaration index (Java's ordinal), or `Any.init`.
    string enumFunction(const ref DescriptorPlan descriptor, string id)
    {
        import std.conv : to;

        string text = "private Any enum_" ~ id ~ "(long ordinal)\n{\n    switch (ordinal)\n    {\n";
        foreach (index, constant; descriptor.constants)
            text ~= "    case " ~ index.to!string ~ ":\n        return Any.of(" ~ descriptor.type
                ~ "." ~ constant ~ ");\n";
        return text ~ "    default:\n        return Any.init;\n    }\n}\n\n";
    }

    string constructorParameters(const ref imported!"flint_tool.engine.aot.plan".ConstructorPlan constructor)
    {
        import flint_tool.engine.aot.conditions : literal;

        string[] parts;
        foreach (index, ref parameter; constructor.parameters)
        {
            const annotations = mergedArray(constructor.parameterAnnotations[index], "        ");
            parts ~= "ParameterDescriptor(" ~ literal(parameter.name) ~ ", " ~ literal(
                    parameter.type.name) ~ ", " ~ annotations ~ ")";
        }
        return list("ParameterDescriptor", parts);
    }

    string constructorFunction(const ref DescriptorPlan descriptor,
            const ref imported!"flint_tool.engine.aot.plan".ConstructorPlan constructor, string id, size_t index)
    {
        import std.array : join;
        import std.conv : to;

        string[] arguments;
        foreach (position, ref parameter; constructor.parameters)
        {
            need(parameter.type);
            arguments ~= "arguments[" ~ position.to!string ~ "].get!(" ~ parameter.type.name ~ ")()";
        }
        const call = (constructor.kind == "class" ? "new " : "") ~ descriptor.type ~ "(" ~ arguments.join(", ") ~ ")";
        return "private Any construct_" ~ id ~ "_" ~ index.to!string
            ~ "(scope Any[] arguments)\n{\n    return Any.of(" ~ call ~ ");\n}\n\n";
    }

    string parameterDescriptors(const ref imported!"flint_tool.engine.aot.plan".MethodPlan method)
    {
        import flint_tool.engine.aot.conditions : literal;

        string[] parts;
        foreach (index, ref parameter; method.method.parameters)
            parts ~= "ParameterDescriptor(" ~ literal(parameter.name) ~ ", " ~ literal(
                    parameter.type.name) ~ ", " ~ mergedArray(method.parameters[index], "        ",
                    index < method.parameterInherited.length ? method.parameterInherited[index] : null) ~ ")";
        return list("ParameterDescriptor", parts);
    }

    string accessors(const ref DescriptorPlan descriptor,
            const ref imported!"flint_tool.engine.aot.plan".PropertyPlan property, string id)
    {
        const name = id ~ "_" ~ sanitize(property.name);
        const self = "self.get!(" ~ descriptor.type ~ ")()";
        string read;
        string write;
        switch (property.access)
        {
        case "field":
            read = self ~ "." ~ property.field;
            write = self ~ "." ~ property.field ~ " = value.get!(" ~ property.type ~ ")()";
            break;
        case "tuple":
            read = self ~ ".tupleof[" ~ indexText(property.index) ~ "]";
            write = read ~ " = value.get!(" ~ property.type ~ ")()";
            break;
        default:
            read = self ~ "." ~ property.getter ~ "()";
            write = self ~ "." ~ property.setter ~ "(value.get!(" ~ property.type ~ ")())";
            break;
        }
        string text = "private Any get_" ~ name ~ "(ref Any self)\n{\n    return Any.of(" ~ read ~ ");\n}\n\n";
        if (property.writable)
            text ~= "private void set_" ~ name ~ "(ref Any self, Any value)\n{\n    " ~ write ~ ";\n}\n\n";
        return text;
    }

    // ---- web, events, queries ----

    string handlerInvoker(const ref HandlerPlan handler)
    {
        const id = sanitize(handler.className) ~ "_" ~ sanitize(handler.method.name);
        const callee = "(cast(" ~ handler.className ~ ") bean)." ~ handler.method.name;
        // Two forms: the HandlerArguments one, and invokeArguments' (b181a524), which takes the resolved arguments
        // as a scope slice, so the runtime needs no wrapper object or heap array per request.
        const proxy = advisedProxy(handler);
        const boxed = invocation(callee, handler.method, handler.arguments, false, proxy);
        const slice = invocation(callee, handler.method, handler.arguments, true, proxy);
        return "private void handle_" ~ id ~ "(Object bean, HandlerArguments arguments, ref Any result)\n{\n    "
            ~ boxed ~ "\n}\n\nprivate void handleArray_"
            ~ id ~ "(Object bean, scope Any[] arguments, ref Any result)\n{\n    " ~ slice ~ "\n}\n\n";
    }

    /// The proxy class of `handler`'s bean in this module, when the handler's method has the proxy's `Any` form
    /// (`proxyMethod`): the invoker then takes the chain's result as it is instead of boxing it a second time.
    string advisedProxy(const ref HandlerPlan handler)
    {
        foreach (ref proxy; plan.proxies)
        {
            if (proxy.className != handler.className)
                continue;
            foreach (ref item; proxy.methods)
                if (anyForm(item) && item.method.name == handler.method.name
                        && sameParameters(item.method, handler.method))
                    return proxy.simple ~ "__FlintProxy";
        }
        return null;
    }

    static bool sameParameters(const ref Method a, const ref Method b)
    {
        if (a.parameters.length != b.parameters.length)
            return false;
        foreach (index, ref parameter; a.parameters)
            if (parameter.type.name != b.parameters[index].type.name)
                return false;
        return true;
    }

    string invocation(string callee, const ref Method method, const ArgumentPlan[] arguments,
            bool slice = false, string proxy = null)
    {
        import std.array : join;
        import std.conv : to;

        need(method.returns);
        string[] parts;
        foreach (index, ref argument; arguments)
        {
            need(method.parameters[index].type);
            const value = slice ? "arguments[" ~ index.to!string ~ "]" : "arguments.get(" ~ index.to!string ~ ")";
            parts ~= argument.exception ? "cast(" ~ argument.type ~ ") exception" : value ~ ".get!("
                ~ argument.type ~ ")()";
        }
        const call = callee ~ "(" ~ parts.join(", ") ~ ")";
        if (method.returns.name == "void")
            return call ~ ";\n    result = Any.init;";
        if (proxy is null)
            return "result = Any.of(" ~ call ~ ");";
        const viaProxy = "proxy." ~ anyName(method) ~ "(" ~ parts.join(", ") ~ ")";
        return "if (auto proxy = cast(" ~ proxy ~ ") bean)\n    {\n        result = " ~ viaProxy
            ~ ";\n        return;\n    }\n    result = Any.of(" ~ call ~ ");";
    }

    string exceptionInvoker(const ref ExceptionPlan handler)
    {
        const id = sanitize(handler.className) ~ "_" ~ sanitize(handler.method.name);
        const callee = "(cast(" ~ handler.className ~ ") bean)." ~ handler.method.name;
        const boxed = invocation(callee, handler.method, handler.arguments);
        const slice = invocation(callee, handler.method, handler.arguments, true);
        return "private void exception_" ~ id ~ "(Object bean, Exception exception, HandlerArguments arguments, "
            ~ "ref Any result)\n{\n    " ~ boxed ~ "\n}\n\nprivate void exceptionArray_"
            ~ id ~ "(Object bean, Exception exception, scope Any[] arguments, ref Any result)\n{\n    "
            ~ slice ~ "\n}\n\n";
    }

    string listenerInvoker(const ref ListenerPlan listener)
    {
        const id = sanitize(listener.className) ~ "_" ~ sanitize(listener.method);
        const argument = listener.parameterType.length ? "event.get!(" ~ listener.parameterType ~ ")()" : "";
        const call = "(cast(" ~ listener.className ~ ") bean)." ~ listener.method ~ "(" ~ argument ~ ")";
        // A non-void listener's result is published as replies (contract 3, invokeForResult).
        string text = listener.returnType == "void"
            ? "private void listen_" ~ id ~ "(Object bean, ref Any event)\n{\n    " ~ call ~ ";\n}\n\n"
            : "private Any listen_" ~ id ~ "(Object bean, ref Any event)\n{\n    return Any.of(" ~ call ~ ");\n}\n\n";
        if (listener.conditionCode.length)
        {
            used["expression"] = true;
            foreach (name; listener.conditionModules)
                imports[name] = true;
            text ~= "private Any condition_" ~ id ~ "(EvaluationContext context)\n{\n    return "
                ~ listener.conditionCode ~ ";\n}\n\n";
        }
        return text;
    }

    /// The erased-builder plan of a registered container type, or null.
    const(imported!"flint_tool.engine.aot.plan".ContainerPlan)* containerOf(string type) const
    {
        foreach (ref container; plan.containers)
        {
            if (container.type == type)
                return &container;
        }
        return null;
    }

    /// `registry.descriptor(rawListDescriptor(...))` for a `flint.java.util` collection or map: no descriptorOf
    /// instance of the type; a `create` function only when a binder or reader creates one.
    string erasedContainer(const ref imported!"flint_tool.engine.aot.plan".ContainerPlan container)
    {
        import std.algorithm.iteration : map;
        import std.array : join;
        import flint_tool.engine.aot.conditions : literal;

        string create;
        if (container.create.length)
        {
            const id = "newContainer_" ~ sanitize(container.type);
            body_ ~= "private Any " ~ id ~ "()\n{\n    return Any.of(cast(" ~ container.type
                ~ ") new " ~ container.create ~ "());\n}\n\n";
            create = ", &" ~ id;
        }
        const builder = container.kind == "map" ? "rawMapDescriptor" : container.kind == "set"
            ? "rawSetDescriptor" : "rawListDescriptor";
        return "    registry.descriptor(imported!\"flint.java.util.descriptors\"." ~ builder ~ "(" ~ literal(
                container.canonical) ~ ", " ~ container.arguments.map!(a => literal(a)).join(", ") ~ create ~ "));\n";
    }

    /// Contract 3: one function per compiled method-level expression (aot-contract.md section 9.1).
    string expressionFunctions(const ref DescriptorPlan descriptor, string id)
    {
        import std.conv : to;

        string text;
        foreach (index, ref method; descriptor.methods)
        {
            foreach (position, ref expression; method.expressions)
            {
                used["expression"] = true;
                foreach (name; expression.modules)
                    imports[name] = true;
                text ~= "private Any spel_" ~ id ~ "_" ~ index.to!string ~ "_" ~ position.to!string
                    ~ "(EvaluationContext context)\n{\n    return " ~ expression.code ~ ";\n}\n\n";
            }
        }
        return text;
    }

    /// Contract 3: each method's `expressions` table.
    string expressionTables(const ref DescriptorPlan descriptor, string id)
    {
        import std.conv : to;
        import flint_tool.engine.aot.conditions : literal;

        string text;
        foreach (index, ref method; descriptor.methods)
        {
            if (method.expressions.length == 0)
                continue;
            string[] specs;
            foreach (position, ref expression; method.expressions)
                specs ~= "\n        ExpressionSpec(" ~ literal(expression.annotation) ~ ", " ~ literal(
                        expression.attribute) ~ ", " ~ literal(
                        expression.source) ~ ", &spel_" ~ id ~ "_" ~ index.to!string ~ "_" ~ position.to!string ~ ")";
            text ~= "    descriptor.methods[" ~ index.to!string ~ "].expressions = " ~ list("ExpressionSpec",
                    specs, ",") ~ ";\n";
        }
        return text;
    }

    string argumentSpecs(const ArgumentPlan[] arguments)
    {
        import flint_tool.engine.aot.conditions : literal;

        string[] parts;
        foreach (ref argument; arguments)
        {
            string text = "\n";
            foreach (name; argument.modules)
                imports[name] = true;
            const required = argument.required ? "true" : "false";
            text ~= "            () { ArgumentSpec a; a.kind = ArgumentKind." ~ argument.kind ~ "; a.name = " ~ literal(
                    argument.name) ~ "; a.type = " ~ typeNameText(argument.type) ~ "; a.required = " ~ required ~ "; ";
            if (argument.hasDefault)
                text ~= "a.defaultValue = " ~ literal(argument.defaultValue) ~ "; ";
            if (argument.elementType.length)
                text ~= "a.elementType = " ~ typeNameText(argument.elementType) ~ "; ";
            if (argument.validate)
                text ~= "a.validate = true; ";
            // The descriptor this module builds (no descriptorOf!(T) instance); a type described elsewhere is
            // looked up by name at dispatch, as before contract 3.
            if (argument.described)
            {
                if (const local = argument.type in descriptorLocal)
                    text ~= "a.descriptor = " ~ *local ~ "; ";
            }
            if (argument.annotations.items.length)
                text ~= "a.annotations = " ~ mergedArray(argument.annotations, "            ") ~ "; ";
            parts ~= text ~ "return a; }()";
        }
        return list("ArgumentSpec", parts, ",");
    }

    string mappingRegistration(const ref HandlerPlan handler)
    {
        import std.conv : to;
        import flint_tool.engine.aot.conditions : literal;

        const id = sanitize(handler.className) ~ "_" ~ sanitize(handler.method.name);
        string text = "    {\n        HandlerMapping mapping;\n        mapping.bean = " ~ literal(
                handler.bean) ~ ";\n        mapping.paths = " ~ strings(handler.paths) ~ ";\n";
        foreach (field, items; [
            "methods": handler.methods,
            "params": handler.params,
            "headers": handler.headers,
            "consumes": handler.consumes,
            "produces": handler.produces
        ])
        {
            if (items.length)
                text ~= "        mapping." ~ field ~ " = " ~ strings(items) ~ ";\n";
        }
        text ~= "        mapping.beanType = " ~ literal(handler.className) ~ ";\n";
        if (handler.typeAnnotations.items.length)
            text ~= "        mapping.typeAnnotations = " ~ mergedArray(handler.typeAnnotations, "        ") ~ ";\n";
        text ~= "        mapping.arguments = " ~ argumentSpecs(
                handler.arguments) ~ ";\n        mapping.returnType = " ~ literal(
                handler.method.returns.name) ~ ";\n        mapping.responseBody = " ~ (handler.responseBody
                ? "true" : "false") ~ ";\n";
        if (handler.returnDescribed)
        {
            if (const local = handler.method.returns.name in descriptorLocal)
                text ~= "        mapping.returnDescriptor = " ~ *local ~ ";\n";
        }
        if (handler.status)
            text ~= "        mapping.responseStatus = " ~ handler.status.to!string ~ ";\n";
        if (handler.reason.length)
            text ~= "        mapping.reason = " ~ literal(handler.reason) ~ ";\n";
        if (auto local = handler.className in descriptorLocal)
            text ~= "        mapping.method = &" ~ *local ~ ".methods[" ~ handler.index.to!string ~ "];\n";
        text ~= "        mapping.invoke = &handle_" ~ id ~ ";\n";
        text ~= "        mapping.invokeArguments = &handleArray_" ~ id ~ ";\n";
        return text ~ "        mapping.source = " ~ literal(
                handler.source) ~ ";\n        registry.mapping(mapping);\n    }\n";
    }

    string exceptionRegistration(const ref ExceptionPlan handler)
    {
        import std.conv : to;
        import flint_tool.engine.aot.conditions : literal;

        const id = sanitize(handler.className) ~ "_" ~ sanitize(handler.method.name);
        string text = "    {\n        ExceptionHandlerSpec handler;\n        handler.bean = " ~ literal(
                handler.bean) ~ ";\n        handler.exceptionTypes = " ~ strings(
                handler.exceptionTypes) ~ ";\n        handler.advice = " ~ (handler.advice ? "true" : "false") ~ ";\n";
        text ~= "        handler.beanType = " ~ literal(handler.className) ~ ";\n";
        foreach (field, items; [
            "adviceBasePackages": handler.basePackages,
            "adviceAssignableTypes": handler.assignableTypes,
            "adviceAnnotations": handler.adviceAnnotations,
            "produces": handler.produces
        ])
        {
            if (items.length)
                text ~= "        handler." ~ field ~ " = " ~ strings(items) ~ ";\n";
        }
        text ~= "        handler.arguments = " ~ argumentSpecs(
                handler.arguments) ~ ";\n        handler.returnType = " ~ literal(
                handler.method.returns.name) ~ ";\n        handler.responseBody = " ~ (handler.responseBody
                ? "true" : "false") ~ ";\n";
        if (handler.status)
            text ~= "        handler.responseStatus = " ~ handler.status.to!string ~ ";\n";
        text ~= "        handler.invoke = &exception_" ~ id ~ ";\n";
        text ~= "        handler.invokeArguments = &exceptionArray_" ~ id ~ ";\n";
        return text ~ "        handler.source = " ~ literal(
                handler.source) ~ ";\n        registry.exceptionHandler(handler);\n    }\n";
    }

    string listenerRegistration(const ref ListenerPlan listener)
    {
        import std.conv : to;
        import flint_tool.engine.aot.conditions : literal;

        const id = sanitize(listener.className) ~ "_" ~ sanitize(listener.method);
        const order = listener.order == int.max ? "int.max" : listener.order.to!string;
        const condition = listener.conditionCode.length
            ? "        listener.conditionExpression = &condition_" ~ id ~ ";\n" : "";
        string text;
        foreach (eventType; listener.eventTypes)
            text ~= "    {\n        EventListenerSpec listener;\n        listener.bean = " ~ literal(
                    listener.bean) ~ ";\n        listener.eventType = " ~ literal(
                    eventType) ~ ";\n        listener.condition = " ~ literal(
                    listener.condition) ~ ";\n        listener.order = " ~ order ~ ";\n        listener." ~ (
                    listener.returnType == "void" ? "invoke" : "invokeForResult") ~ " = &listen_"
                ~ id ~ ";\n" ~ condition ~ "        registry.listener(listener);\n    }\n";
        return text;
    }

    string queryRegistration(const ref QueryPlan query)
    {
        import std.conv : to;
        import flint_tool.engine.aot.conditions : literal;

        return "    {\n        DerivedQuery query;\n        query.repository = " ~ literal(
                query.repository) ~ ";\n        query.method = " ~ literal(
                query.query.method) ~ ";\n        query.domainType = " ~ literal(
                query.domainType) ~ ";\n        query.sql = " ~ literal(
                query.query.sql) ~ ";\n        query.parameters = " ~ strings(
                query.query.parameters) ~ ";\n        query.likeTransforms = " ~ strings(
                query.query.likeTransforms) ~ ";\n        query.kind = QueryKind."
            ~ query.query.kind.to!string ~ ";\n        query.limit = " ~ query.query.limit.to!string
            ~ ";\n        query.source = " ~ literal(query.source) ~ ";\n        registry.query(query);\n    }\n";
    }

    string registration()
    {
        import std.array : join;
        import flint_tool.engine.aot.names : entryPoint;

        beginPermanent();
        string text;
        if (plan.exportsDescriptors)
        {
            // Compiled once with the platform module: no descriptorOf or accessor instances here.
            imports[plan.name] = true;
            text ~= "    foreach (descriptor; " ~ plan.name ~ ".flintAotDescriptors())\n"
                ~ "        registry.descriptor(descriptor);\n";
        }
        foreach (ref descriptor; plan.descriptors)
        {
            const id = sanitize(descriptor.simple);
            text ~= "    auto descriptor_" ~ id ~ " = describe_" ~ id
                ~ "(permanent);\n    registry.descriptor(descriptor_" ~ id ~ ");\n";
        }
        enum describe = "    registry.descriptor(imported!\"flint.engine.aot.descriptor\".descriptorOf!(";
        foreach (type; plan.containerDescriptors)
        {
            const container = containerOf(type);
            text ~= container is null ? describe ~ type ~ ")());\n" : erasedContainer(*container);
        }
        foreach (ref bean; plan.beans)
            text ~= beanDefinition(bean);
        foreach (ref handler; plan.handlers)
            text ~= mappingRegistration(handler);
        foreach (ref handler; plan.exceptionHandlers)
            text ~= exceptionRegistration(handler);
        foreach (ref listener; plan.listeners)
            text ~= listenerRegistration(listener);
        foreach (ref query; plan.queries)
            text ~= queryRegistration(query);
        const own = endPermanent();
        enum comment = "/// Registers this module's definitions, descriptors and tables (aot-contract.md section 3).\n";
        const header = comment ~ "extern (C) void " ~ entryPoint(plan.name) ~ "(scope AotRegistry registry)\n{\n";
        if (own == "0" && describeBytes.length == 0)
            return header ~ text ~ "}\n";
        // One block for every table the registration and its descriptors build (flint.engine.aot.permanent).
        used["permanent"] = true;
        const terms = describeBytes ~ (own == "0" ? null : [own]);
        return "private enum size_t permanentBytes = " ~ terms.join(
                "\n    + ") ~ ";\n\n" ~ header ~ "    auto permanent = Permanent(permanentBytes);\n" ~ text ~ "}\n";
    }
}
