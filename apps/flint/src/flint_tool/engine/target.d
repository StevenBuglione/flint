/// Build targets of `flint package` (ADR-021 section 9, ADR-023).
///
/// The host target builds natively. `linux-x86_64-musl` cross-links on any Linux x86-64 host: the pinned LDC
/// compiles for the musl triple against the pinned Alpine LDC runtime, and the pinned clang links fully static
/// position-independent executables against the checksum-pinned musl sysroot (policy/toolchains.json).
module flint_tool.engine.target;

import flint_tool.diagnostics.report : Report;
import flint_tool.home.policy : Home;

@safe:

/// The musl target's pinned pieces, relative to the toolchain directory.
enum muslTarget = "linux-x86_64-musl";
/// The glibc target.
enum glibcTarget = "linux-x86_64-glibc";
/// LLVM triple of the musl target.
enum muslTriple = "x86_64-alpine-linux-musl";
/// The Alpine LDC release (druntime and Phobos built for musl).
enum muslRuntime = "ldc2-1.43.0-alpine-x86_64";
/// The sysroot directory tools/install_toolchains.py --compiler musl-sysroot assembles.
enum muslSysroot = "musl-sysroot-alpine-3.22-x86_64";

/// One build target.
struct BuildTarget
{
    /// Target name, such as linux-x86_64-musl.
    string name;
    /// Built by cross-linking rather than natively.
    bool cross;
    /// The executable has no interpreter and no shared libraries.
    bool fullyStatic;
    /// LLVM triple (cross targets).
    string triple;
    /// Absolute sysroot (cross targets).
    string sysroot;
    /// Absolute LDC runtime directory (cross targets).
    string runtime;
    /// Absolute pinned clang.
    string clang;
    /// OCI architecture name.
    string architecture = "amd64";
    /// The C library, for SBOMs.
    string libc;
}

/// The target this machine builds natively.
string hostTarget()
{
    import std.file : exists;

    version (OSX)
    {
        version (AArch64)
            return "macos-arm64";
        else
            return "unknown";
    }
    else version (X86_64)
    {
        return exists("/lib/ld-musl-x86_64.so.1") ? muslTarget : glibcTarget;
    }
    else version (AArch64)
    {
        return exists("/lib/ld-musl-aarch64.so.1") ? "linux-aarch64-musl" : "linux-aarch64-glibc";
    }
    else
        return "unknown";
}

/// Targets flint can package for from this host.
string[] availableTargets()
{
    const host = hostTarget();
    return host == glibcTarget ? [glibcTarget, muslTarget] : [host];
}

/// Select a target by name; FLINT-E0817 when it cannot be built here or its toolchain is missing.
bool selectTarget(const ref Home home, string name, out BuildTarget target, ref Report report)
{
    import std.algorithm.searching : canFind;
    import std.array : join;
    import std.file : exists;
    import std.path : buildPath;
    import flint_tool.toolchain.toolchain : toolchainDirectory;

    const directory = toolchainDirectory(home);
    target.name = name;
    target.clang = buildPath(directory, "LLVM-22.1.8-Linux-X64", "bin", "clang");
    if (!availableTargets().canFind(name))
    {
        report.error("FLINT-E0817", "target `" ~ name ~ "` cannot be built on this " ~ hostTarget() ~ " host",
                "choose one of: " ~ availableTargets().join(", "));
        return false;
    }
    target.libc = name.canFind("musl") ? "musl" : "glibc";
    if (name == hostTarget())
        return true;
    target.cross = true;
    target.fullyStatic = true;
    target.triple = muslTriple;
    target.sysroot = buildPath(directory, muslSysroot);
    target.runtime = buildPath(directory, muslRuntime);
    foreach (required; [
        buildPath(target.sysroot, "flint-musl-sysroot.json"),
        buildPath(target.runtime, "lib", "libdruntime-ldc.a"), target.clang
    ])
    {
        if (!exists(required))
        {
            report.error("FLINT-E0817", "the " ~ name ~ " toolchain is not installed (" ~ required ~ " is missing)",
                    "flint toolchain install --musl");
            return false;
        }
    }
    return true;
}

/// The ldc2.conf of a cross target: its runtime, the static-PIE link through the pinned clang, and the
/// sysroot for ImportC's preprocessor.
string ldcConfiguration(const ref BuildTarget target)
{
    string text = "// Generated by flint for " ~ target.name ~ ". Do not edit.\n\"" ~ target.triple
        ~ "\":\n{\n    switches = [\n";
    foreach (flag; [
        "-defaultlib=phobos2-ldc,druntime-ldc", "-link-defaultlib-shared=false",
        "-gcc=" ~ target.clang, "-Xcc=--target=" ~ target.triple,
        "-Xcc=--sysroot=" ~ target.sysroot, "-Xcc=-static-pie", "-P=--target=" ~ target.triple,
        "-P=--sysroot=" ~ target.sysroot
    ])
        text ~= "        \"" ~ flag ~ "\",\n";
    return text ~ "    ];\n    post-switches = [\n        \"-I" ~ target.runtime
        ~ "/import\",\n    ];\n" ~ "    lib-dirs = [\n        \"" ~ target.runtime ~ "/lib\",\n    ];\n};\n";
}

/// Compiler flags a target adds to the D build. `configuration` is the path of its ldc2.conf.
string[] targetDflags(const ref BuildTarget target, string configuration)
{
    if (!target.cross)
        return null;
    return ["-conf=" ~ configuration, "-mtriple=" ~ target.triple, "-relocation-model=pic"];
}

/// Flags a target adds to embedded C.
string[] targetCflags(const ref BuildTarget target)
{
    if (!target.cross)
        return null;
    return ["--target=" ~ target.triple, "--sysroot=" ~ target.sysroot];
}
