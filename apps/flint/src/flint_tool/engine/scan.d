/// Compile-time component scanning for `@FlintApplication` (ADR-029 section 2, ADR-028 section 9).
///
/// `flint build` writes `.flint/generated/scan/flint_scan.d` when a module under `src/<project>/` declares an
/// `@FlintApplication` class. The generated module imports every module under `src/<project>/` and the
/// auto-configuration of every starter the project resolves, and its module constructor registers the scanned
/// runner with `FlintApplication`. No module imports it, so scanning adds no import cycle.
module flint_tool.engine.scan;

import flint_tool.home.policy : Home;
import flint_tool.project.manifest : Manifest;
import flint_tool.project.resolve : Resolution;

@safe:

/// Where the scan module goes, relative to the project root.
enum scanDirectory = ".flint/generated/scan";

/// The application class and the modules under `src/<project>/`.
struct Scan
{
    /// `module.Class` of the `@FlintApplication` class, or empty.
    string application;
    /// Every module under `src/<project>/`, sorted.
    string[] modules;
}

/// Read the project's sources for the application class and its modules.
Scan scanProject(const ref Manifest manifest)
{
    import std.algorithm.searching : startsWith;
    import std.algorithm.sorting : sort;
    import std.file : readText;
    import std.path : buildPath;
    import flint_tool.check.rules : SourceScan, scanSource;
    import flint_tool.diagnostics.report : Report;
    import flint_tool.support.files : dSources;

    Scan result;
    foreach (relative; dSources(manifest.root))
    {
        if (!relative.startsWith("src/"))
            continue;
        SourceScan scan;
        Report ignored;
        if (!scanSource(relative, readText(buildPath(manifest.root, relative)), scan, ignored)
                || scan.moduleName.length == 0)
            continue;
        result.modules ~= scan.moduleName;
        const name = applicationClass(scan.tokens);
        if (name.length && result.application.length == 0)
            result.application = scan.moduleName ~ "." ~ name;
    }
    sort(result.modules);
    return result;
}

/// The class annotated `@FlintApplication` in `tokens`, or empty.
string applicationClass(scope const imported!"flint_tool.check.lexer".Token[] tokens)
{
    foreach (index; 1 .. tokens.length)
    {
        if (tokens[index].value != "FlintApplication" || tokens[index - 1].value != "@")
            continue;
        foreach (next; index + 1 .. tokens.length)
        {
            const value = tokens[next].value;
            if ((value == "class" || value == "struct") && next + 1 < tokens.length)
                return tokens[next + 1].value;
            if (value == ";" || value == "{")
                break;
        }
    }
    return null;
}

/// The scan module's source, or null when the project has no `@FlintApplication` class.
string renderScan(const ref Home home, const ref Resolution resolution, const ref Scan scan)
{
    import std.algorithm.searching : canFind, startsWith;
    import std.algorithm.sorting : sort;
    import std.array : join;
    import std.string : indexOf;

    if (scan.application.length == 0)
        return null;
    string[] imports;
    string[] lists;
    foreach (ref item; resolution.packages)
    {
        if (!item.name.startsWith("flint:starter"))
            continue;
        const starter = home.findStarter(item.name[6 .. $]);
        if (starter is null)
            continue;
        foreach (entry; starter.autoconfiguration)
        {
            const colon = entry.indexOf(':');
            const line = "import " ~ entry[0 .. colon] ~ " : " ~ entry[colon + 1 .. $] ~ ";";
            if (!imports.canFind(line))
            {
                imports ~= line;
                lists ~= entry[colon + 1 .. $];
            }
        }
    }
    sort(imports);
    sort(lists);
    string moduleImports;
    foreach (name; scan.modules)
        moduleImports ~= "import " ~ name ~ ";\n";
    return "// Generated by flint build from src/ and the declared starters (ADR-029 section 2). Do not edit.\n"
        ~ "module flint_scan;\n\nimport flint.boot : AutoConfigurationList, FlintApplication;\n"
        ~ moduleImports ~ (imports.length
                ? imports.join("\n") ~ "\n" : "") ~ "\n@safe:\n\nshared static this()\n{\n"
        ~ "    FlintApplication.register!(" ~ scan.application ~ ", AutoConfigurationList!(" ~ lists.join(
                ", ") ~ "), " ~ scan.modules.join(", ") ~ ")();\n}\n";
}

unittest
{
    import flint_tool.check.lexer : LexFailure, Token, tokenize;

    Token[] tokens;
    LexFailure failure;
    assert(tokenize("module shop.app;\nimport flint.boot;\n@FlintApplication\nfinal class ShopApplication\n{\n}\n",
            tokens, failure));
    assert(applicationClass(tokens) == "ShopApplication");
    assert(tokenize("module shop.app;\nstruct Other {}\n", tokens, failure));
    assert(applicationClass(tokens).length == 0);
}
