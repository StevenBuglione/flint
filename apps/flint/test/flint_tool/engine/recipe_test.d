module flint_tool.engine.recipe_test;

import flint_tool.engine.recipe : quoted, renderDependencyRecipe, renderRecipe;
import flint_tool.fixtures : fixtureHome;
import flint_tool.project.manifest : Manifest;
import flint_tool.project.resolve : ResolvedPackage, Resolution;
import flint.test : expect;

@safe:

@("the generated recipe has one configuration per profile and a unittest configuration")
unittest
{
    const home = fixtureHome();
    Manifest manifest;
    manifest.name = "shop";
    manifest.executable = "shopd";
    Resolution resolution;
    resolution.packages = [
        ResolvedPackage("flint:log", "core"), ResolvedPackage("flint:test", "core"),
        ResolvedPackage("model", "path", null, "/m", "../model", "model")
    ];
    resolution.direct = ["flint:log", "model"];
    resolution.directTest = ["flint:test"];
    enum expected = `// Generated by flint from flint.toml. Do not edit: flint rewrites it on every build.
name "shop"
targetName "shopd"
targetType "executable"
sourcePaths "../../../src"
importPaths "../../../src"
dflags "-preview=dip1000"
dependency "flint:log" path="/flint"
dependency "model" path="../deps/model"
configuration "dev" {
    targetPath "../../build/dev"
}
configuration "release" {
    targetPath "../../build/release"
}
configuration "size" {
    targetPath "../../build/size"
}
configuration "sanitize" {
    targetPath "../../build/sanitize"
}
configuration "unittest" {
    targetType "executable"
    targetName "shopd-test"
    targetPath "../../build/test"
    sourcePaths "../../../test"
    importPaths "../../../test"
    buildOptions "unittests" "debugInfo"
    dependency "flint:test" path="/flint"
}
`;
    expect(renderRecipe(home, manifest, resolution)).toEqual(expected);
}

@("libraries test with -main, and path dependencies get absolute source paths")
unittest
{
    import std.algorithm.searching : canFind;

    const home = fixtureHome();
    Manifest manifest;
    manifest.name = "model";
    manifest.type = "library";
    Resolution resolution;
    expect(renderRecipe(home, manifest, resolution).canFind("    dflags \"-main\"\n")).toEqual(true);
    const dependency = ResolvedPackage("model", "path", null, "/work/model", "../model", "model");
    expect(renderDependencyRecipe(home, dependency, resolution).canFind("sourcePaths \"/work/model/src\"")).toEqual(
            true);
    expect(quoted("a\"b")).toEqual("\"a\\\"b\"");
}

@("embedded C objects become source files, and executables get the linker hardening")
unittest
{
    import std.algorithm.searching : canFind;
    import flint_tool.engine.recipe : RecipeExtras;

    const home = fixtureHome();
    Manifest manifest;
    manifest.name = "shop";
    Resolution resolution;
    RecipeExtras extras;
    extras.objects = ["/p/.flint/cache/c/ab.o", "/p/.flint/cache/c/cd.o"];
    extras.linkHardening = ["-z", "relro", "-z", "now"];
    const text = renderRecipe(home, manifest, resolution, extras);
    expect(text.canFind("sourceFiles \"/p/.flint/cache/c/ab.o\" \"/p/.flint/cache/c/cd.o\"\n")).toEqual(true);
    expect(text.canFind("\nlflags \"-z\" \"relro\" \"-z\" \"now\"\n")).toEqual(true);
    expect(renderRecipe(home, manifest, resolution).canFind("sourceFiles")).toEqual(false);
}

@("packages from a platform module's checkout build through one joined flint recipe")
unittest
{
    import flint_tool.engine.recipe : joinsRepos, renderJoinedRoot;
    import std.algorithm.searching : canFind;

    const home = fixtureHome();
    Manifest manifest;
    manifest.name = "shop";
    Resolution resolution;
    auto arena = ResolvedPackage("flint:arena", "core");
    arena.directory = "/flint/packages/arena";
    arena.repoRoot = "/flint";
    auto web = ResolvedPackage("flint:engine-web", "core");
    web.directory = "/flint/.flint/platform/framework-abc/engine/web";
    web.repoRoot = "/flint/.flint/platform/framework-abc";
    resolution.packages = [arena];
    resolution.direct = ["flint:arena"];
    expect(joinsRepos(home, resolution)).toEqual(false);
    expect(renderRecipe(home, manifest, resolution).canFind(`dependency "flint:arena" path="/flint"`)).toEqual(true);

    resolution.packages ~= web;
    resolution.direct ~= "flint:engine-web";
    expect(joinsRepos(home, resolution)).toEqual(true);
    const recipe = renderRecipe(home, manifest, resolution);
    expect(recipe.canFind(`dependency "flint:arena" path="../deps/../flint"`)).toEqual(true);
    expect(recipe.canFind(`dependency "flint:engine-web" path="../deps/../flint"`)).toEqual(true);
    enum joined = `// Generated by flint from flint.toml. Do not edit: flint rewrites it on every build.
name "flint"
targetType "none"
subPackage "../../../../../flint/packages/arena"
subPackage "../../../../../flint/.flint/platform/framework-abc/engine/web"
`;
    expect(renderJoinedRoot(home, resolution, "/projects/shop/.flint/generated/flint")).toEqual(joined);
}

@("Flint AOT's modules for platform modules build as a library that a project edit does not recompile")
unittest
{
    import flint_tool.engine.recipe : RecipeExtras, renderAotLibraryLink, renderAotLibraryRecipe;
    import std.algorithm.searching : canFind;

    const home = fixtureHome();
    Manifest manifest;
    manifest.name = "shop";
    Resolution resolution;
    resolution.packages = [ResolvedPackage("flint:boot-starter-web", "core")];
    resolution.direct = ["flint:boot-starter-web"];
    RecipeExtras extras;
    extras.aot = true;
    expect(renderRecipe(home, manifest, resolution, extras).canFind("sourcePaths \"../aot\"\n")).toEqual(true);

    extras.aotOwn = ["../aot/flint_aot/shop/package.d", "../aot/flint_aot_registry.d"];
    const recipe = renderRecipe(home, manifest, resolution, extras);
    expect(recipe.canFind("sourcePaths \"../aot\"")).toEqual(false);
    expect(recipe.canFind("importPaths \"../aot\"\nsourceFiles \"../aot/flint_aot/shop/package.d\" "
            ~ "\"../aot/flint_aot_registry.d\" \"../aot-library/flint_aot_library.d\"\n"
            ~ "dependency \"flint-aot-library\" path=\"../aot-library\"\n")).toEqual(true);

    enum library = `// Generated by flint from flint.toml. Do not edit: flint rewrites it on every build.
name "flint-aot-library"
targetType "library"
targetPath "../../build/aot-library"
importPaths "../aot"
sourceFiles "../aot/flint_aot/flint/boot/autoconfigure/web.d"
dflags "-preview=dip1000"
dflags "-verror-hide=/flint"
dependency "flint:boot-starter-web" path="../deps/../platform"
`;
    expect(renderAotLibraryRecipe(home, resolution,
            ["../aot/flint_aot/flint/boot/autoconfigure/web.d"], ["-verror-hide=/flint"], true)).toEqual(library);
    // From the platform cache: the archive is linked with the platform's, and DUB does not build the library.
    extras.aotArchive = "/cache/platform/k/libflint-aot-library.a";
    const cached = renderRecipe(home, manifest, resolution, extras);
    expect(cached.canFind("dependency \"flint-aot-library\"")).toEqual(false);
    expect(cached.canFind("sourceFiles \"../aot/flint_aot/shop/package.d\"")).toEqual(true);
    expect(renderAotLibraryLink(["flint_aot.flint.boot.web.server"])).toEqual(
            "// Generated by flint: keeps the AOT library's modules and their imports in the link.\n"
            ~ "module flint_aot_library;\nstatic import flint_aot.flint.boot.web.server;\n");
}

@("the joined recipe also lists the flint packages a resolved recipe names in a configuration the build never selects")
unittest
{
    import flint_tool.engine.recipe : renderJoinedRoot;
    import std.algorithm.searching : canFind;
    import std.file : mkdirRecurse, rmdirRecurse, tempDir, write;
    import std.path : buildPath;
    import std.uuid : randomUUID;

    const work = buildPath(tempDir(), "flint-joined-" ~ randomUUID().toString());
    scope (exit)
        rmdirRecurse(work);
    const webmvc = buildPath(work, "boot", "module", "flint-boot-webmvc");
    mkdirRecurse(webmvc);
    write(buildPath(webmvc, "dub.sdl"), "name \"boot-webmvc\"\ndependency \"flint:log\" version=\"*\"\n"
            ~ "configuration \"unittest\" {\n    dependency \"flint:test\" version=\"*\"\n}\n");
    const home = fixtureHome();
    Resolution resolution;
    auto item = ResolvedPackage("flint:boot-webmvc", "core");
    item.directory = webmvc;
    auto log = ResolvedPackage("flint:log", "core");
    log.directory = "/flint/packages/log";
    resolution.packages = [item, log];
    const joined = renderJoinedRoot(home, resolution, buildPath(work, "joined"));
    expect(joined.canFind("subPackage \"../boot/module/flint-boot-webmvc\"\n")).toEqual(true);
    expect(joined.canFind("packages/test\"\n")).toEqual(true);
    expect(joined.canFind("packages/log\"\nsubPackage")).toEqual(true);

    // A Spring-layer module named only by a unittest configuration (flint:framework-test) is found too.
    import flint_tool.home.policy : CorePackage;

    auto withFramework = fixtureHome();
    CorePackage frameworkTest;
    frameworkTest.name = "framework-test";
    frameworkTest.directory = "framework/framework-test";
    frameworkTest.framework = true;
    withFramework.frameworkModules = [frameworkTest];
    write(buildPath(webmvc, "dub.sdl"), "name \"boot-webmvc\"\nconfiguration \"unittest\" {\n"
            ~ "    dependency \"flint:framework-test\" version=\"*\"\n}\n");
    expect(renderJoinedRoot(withFramework, resolution, buildPath(work, "joined"))
            .canFind("framework/framework-test\"\n")).toEqual(true);
}
