// Ported from spring-ai v2.1.0, spring-ai-model/src/main/java/org/springframework/ai/chat/messages/{Message,MessageType}.java
// Modified by the Flint authors.
module flint.ai.chat.messages;

import flint.ai.content : Content;

@safe:

/// The role of a message in a model conversation.
struct MessageType
{
    /// A message from a user.
    static immutable MessageType USER = MessageType(0);
    /// A message generated by the model.
    static immutable MessageType ASSISTANT = MessageType(1);
    /// Instructions for the conversation.
    static immutable MessageType SYSTEM = MessageType(2);
    /// The result of a tool call.
    static immutable MessageType TOOL = MessageType(3);

    private static immutable string[4] names = ["USER", "ASSISTANT", "SYSTEM", "TOOL"];
    private static immutable string[4] roles = ["user", "assistant", "system", "tool"];
    private int ordinal_;

    private this(int ordinal) pure nothrow @nogc
    {
        ordinal_ = ordinal;
    }

    /// Returns the role value sent to a model.
    string getValue() const pure nothrow @nogc
    {
        return roles[ordinal_];
    }

    /// Returns the enum constant's name.
    string name() const pure nothrow @nogc
    {
        return names[ordinal_];
    }

    /// Returns the constant's zero-based declaration index.
    int ordinal() const pure nothrow @nogc
    {
        return ordinal_;
    }

    /// Returns a fresh array of message types in Java declaration order.
    static MessageType[] values() pure nothrow
    {
        return [USER, ASSISTANT, SYSTEM, TOOL];
    }

    /// Finds a message type by its exact enum name.
    static MessageType valueOf(string name)
    {
        import flint.ai.chat.messages.part : joinRecord;
        import flint.java.lang : IllegalArgumentException, NullPointerException;

        if (name is null)
            throw new NullPointerException("Name is null");
        foreach (i, candidate; names)
            if (candidate == name)
                return MessageType(cast(int) i);
        string[2] parts = ["No enum constant flint.ai.chat.messages.MessageType.", name];
        throw new IllegalArgumentException(joinRecord(parts[]));
    }

    /// Returns the enum constant's name.
    string toString() const pure nothrow @nogc
    {
        return name();
    }
}

/// A message with text, metadata and a role in a model conversation.
interface Message : Content
{
    /// Returns the role of this message.
    MessageType getMessageType();
}
