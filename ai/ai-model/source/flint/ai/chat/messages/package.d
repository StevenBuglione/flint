@safe:

/// The role of a message in a model conversation.
struct MessageType
{
    /// A message from a user.
    static immutable MessageType USER = MessageType(0);
    /// A message generated by the model.
    static immutable MessageType ASSISTANT = MessageType(1);
    /// Instructions for the conversation.
    static immutable MessageType SYSTEM = MessageType(2);
    /// The result of a tool call.
    static immutable MessageType TOOL = MessageType(3);

    private static immutable string[4] names = ["USER", "ASSISTANT", "SYSTEM", "TOOL"];
    private static immutable string[4] roles = ["user", "assistant", "system", "tool"];
    private int ordinal_;

    private this(int ordinal) pure nothrow @nogc
    {
        ordinal_ = ordinal;
    }

    /// Returns the role value sent to a model.
    string getValue() const pure nothrow @nogc
    {
        return roles[ordinal_];
    }

    /// Returns the enum constant's name.
    string name() const pure nothrow @nogc
    {
        return names[ordinal_];
    }

    /// Returns the constant's zero-based declaration index.
    int ordinal() const pure nothrow @nogc
    {
        return ordinal_;
    }

    /// Returns a fresh array of message types in Java declaration order.
    static MessageType[] values() pure nothrow
    {
        return [USER, ASSISTANT, SYSTEM, TOOL];
    }

    /// Finds a message type by its exact enum name.
    static MessageType valueOf(string name)
    {
        import flint.ai.chat.messages.response_value : joinRecord;
        import flint.java.lang : IllegalArgumentException, NullPointerException;

        if (name is null)
            throw new NullPointerException("Name is null");
        foreach (i, candidate; names)
            if (candidate == name)
                return MessageType(cast(int) i);
        string[2] parts = ["No enum constant flint.ai.chat.messages.MessageType.", name];
        throw new IllegalArgumentException(joinRecord(parts[]));
    }

    /// Returns the enum constant's name.
    string toString() const pure nothrow @nogc
    {
        return name();
    }
}

/// A message with text, metadata and a role in a model conversation.
interface Message : Content
{
    /// Returns the role of this message.
    MessageType getMessageType();
}

private alias MessageText = Nullable!string;
private alias MessageParts = List!MessagePart;
private alias MessageMetadata = Map!(string, Any);

/// Base implementation of a message with ordered content parts.
abstract class AbstractMessage : Message
{
    /// The metadata key for the message type.
    enum string MESSAGE_TYPE = "messageType";

    private MessageType messageType_;
    private MessageText text_;
    private MessageMetadata metadata_;
    private MessageParts parts_;

    /// Creates a message from its legacy nullable text.
    protected this(MessageType messageType, MessageText text, MessageMetadata metadata)
    {
        this(messageType, legacyParts(text), metadata);
    }

    /// Takes a read-only snapshot of the parts and a mutable copy of the metadata.
    protected this(MessageType messageType, MessageParts parts, MessageMetadata metadata)
    {
        import flint.java.lang : IllegalArgumentException;

        if (parts is null)
            throw new IllegalArgumentException("Parts must not be null");
        if (metadata is null)
            throw new IllegalArgumentException("Metadata must not be null");

        auto snapshot = MessageParts.copyOf(parts);
        const empty = snapshot.isEmpty();
        if (empty && (messageType == MessageType.SYSTEM || messageType == MessageType.USER))
            throw new IllegalArgumentException("Content must not be null for SYSTEM or USER messages");

        const text = joinTextParts(snapshot);

        messageType_ = messageType;
        parts_ = snapshot;
        text_ = empty ? MessageText.init : MessageText(text is null ? "" : text);
        metadata_ = copyContentMetadata(metadata);
        metadata_.put(MESSAGE_TYPE, Any.of(messageType));
    }

    /// Converts legacy nullable text into zero or one part.
    protected static MessageParts legacyParts(MessageText text)
    {
        if (text.isNull)
            return MessageParts.of();
        const content = text.get();
        return MessageParts.of(TextPart.of(content.length == 0 ? "" : content));
    }

    /// Returns the unmodifiable snapshot in message order.
    MessageParts getParts()
    {
        return parts_;
    }

    /// Returns absent text only when the message has no parts.
    override MessageText getText()
    {
        return text_;
    }

    /// Returns the message's live metadata map.
    override MessageMetadata getMetadata()
    {
        return metadata_;
    }

    /// Returns the message role supplied during construction.
    override MessageType getMessageType()
    {
        return messageType_;
    }

    /// Compares the stored role, metadata and ordered parts across message subtypes.
    bool equals(Object other)
    {
        if (other is this)
            return true;
        auto that = cast(AbstractMessage) other;
        return that !is null && messageType_ == that.messageType_
            && metadata_.equals(cast(Object) that.metadata_) && parts_.equals(cast(Object) that.parts_);
    }

    /// Hashes the role, metadata and ordered parts in Java field order.
    int hashCode()
    {
        // The R15 value enum uses its stable ordinal where Java uses reference identity.
        uint hash = 31 + cast(uint) messageType_.ordinal();
        hash = 31 * hash + cast(uint) metadata_.hashCode();
        return cast(int)(31 * hash + cast(uint) parts_.hashCode());
    }

    mixin JavaObject;
}

/// A system instruction for a model conversation.
class SystemMessage : AbstractMessage
{
    /// Creates a system message from its text.
    this(MessageText text)
    {
        this(text, MessageMetadata.of());
    }

    private this(MessageText text, MessageMetadata metadata)
    {
        super(MessageType.SYSTEM, text, metadata);
    }

    /// Copies the message text and snapshots its metadata.
    SystemMessage copy()
    {
        import flint.java.lang : NullPointerException;

        const text = getText();
        // The base constructor copies the metadata. Check Java Map.copyOf's null contract here.
        metadata_.forEach((string key, Any value) {
            if (key is null || value.isNull)
                throw new NullPointerException();
        });
        return new SystemMessage(text, metadata_);
    }

    /// Starts a builder with this message's current text and metadata.
    Builder mutate()
    {
        auto result = builder();
        result.text(getText()).metadata(metadata_);
        return result;
    }

    /// Starts an empty system message builder.
    static Builder builder() pure nothrow @nogc
    {
        return Builder.init;
    }

    /// Configures the text and metadata for a system message.
    static struct Builder
    {
        private MessageText text_;
        private MessageMetadata metadata_;
        private bool metadataSet_;

        /// Sets the text, or clears it when the input is null.
        ref Builder text(string textContent) return pure nothrow @nogc
        {
            return text(textContent is null ? MessageText.init : MessageText(textContent));
        }

        /// Sets text with explicit presence, including an empty value (R5).
        ref Builder text(MessageText textContent) return pure nothrow @nogc
        {
            text_ = textContent;
            return this;
        }

        /// Replaces the metadata supplied for the message.
        ref Builder metadata(MessageMetadata metadata) return pure nothrow @nogc
        {
            metadata_ = metadata;
            metadataSet_ = true;
            return this;
        }

        /// Builds a message from the current text and metadata.
        SystemMessage build()
        {
            return new SystemMessage(text_, metadataSet_ ? metadata_ : MessageMetadata.of());
        }
    }
}

