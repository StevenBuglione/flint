module flint.ai.model;

import flint.java.lang : JavaObject, stringHashCode;
import std.typecons : Nullable;

@safe:

/// Describes a model's name, description, and version.
interface ModelDescription
{
    /// Returns the model's name.
    string getName();

    /// Returns a description of the model.
    string getDescription();

    /// Returns the model's version.
    string getVersion();

    /// Supplies the description and version defaults (R3).
    mixin template Defaults()
    {
        override string getDescription() pure nothrow @nogc
        {
            return "";
        }

        override string getVersion() pure nothrow @nogc
        {
            return "";
        }
    }
}

/// Marks a description of a chat model.
interface ChatModelDescription : ModelDescription
{
}

/// Describes an embedding model.
interface EmbeddingModelDescription : ModelDescription
{
    /// Returns the embedding dimensionality, or -1 when unknown.
    int getDimensions();

    /// Supplies the base model defaults and the embedding dimension default (R3).
    mixin template Defaults()
    {
        import flint.ai.model : ModelDescription;

        mixin ModelDescription.Defaults;

        override int getDimensions() pure nothrow @nogc
        {
            return -1;
        }
    }
}

/// Marker for options that customize an AI model request.
interface ModelOptions
{
}

/// Typed instructions and optional settings for an AI model invocation.
interface ModelRequest(T)
{
    /// Returns the instructions required by the model.
    T getInstructions();

    /// Returns the request options, or null to use the model defaults.
    ModelOptions getOptions();
}

/// A typed output from an AI model with its associated metadata.
interface ModelResult(T)
{
    /// Returns the output generated by the model.
    T getOutput();

    /// Returns the metadata associated with this output.
    ResultMetadata getMetadata();
}

/// Marker for metadata associated with the result of an AI model.
interface ResultMetadata
{
}

/// Conversion utilities for embedding vectors.
final class EmbeddingUtils
{
    @disable this();

    /// Copies primitive values to a new array of boxed floats (R5).
    static Nullable!float[] toFloatArray(scope const(float)[] array) pure
    {
        // One allocation site; empty input still returns a distinct non-null slice.
        auto result = new Nullable!float[array.length == 0 ? 1 : array.length];
        foreach (i, value; array)
            result[i] = Nullable!float(value);
        return result[0 .. array.length];
    }
}

