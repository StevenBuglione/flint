+/*****************************
+ * Apple AArch64 passes a composite of up to 16 bytes that is not a homogeneous
+ * floating point aggregate in 8-byte aligned stack slots, as in general registers,
+ * while scalars are packed at their natural alignment.
+ */
+@trusted
+bool appleStackComposite(const type* t)
+{
+    const ty = tybasic(t.Tty);
+    if (ty != TYstruct && ty != TYarray)
+        return false;
+    const sz = type_size(t);
+    if (sz == 0 || sz > 2 * REGSIZE)
+        return false;
+    if (ty == TYstruct)
+    {
+        const t1 = t.Ttag.Sstruct.Sarg1type;
+        const t2 = t.Ttag.Sstruct.Sarg2type;
+        if (t1 && tyfloating(t1.Tty) && (!t2 || tyfloating(t2.Tty)))
+            return false;   // HFA: natural alignment
+    }
+    return true;
+}
