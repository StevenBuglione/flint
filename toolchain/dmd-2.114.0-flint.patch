+/*********************************************************************
+ * Child-side compatibility checks
+ */
+
+/// True when a user identifier was queried by the prelude.
+bool queriedByPrelude(ref Array!Identifier queried, Identifier id)
+{
+    foreach (q; queried)
+        if (q is id)
+            return true;
+    return false;
+}
+
+/// True when `dir` contains an entry that could shadow a preloaded package.
+bool shadowsPrelude(const(char)* dir)
+{
+    char[4096] path;
+    foreach (top; zygoteTopLevel)
+    {
+        snprintf(path.ptr, path.length, "%s/%s", dir, top);
+        if (fileExists(path.ptr))
+            return true;
+        snprintf(path.ptr, path.length, "%s/%s.d", dir, top);
+        if (fileExists(path.ptr))
+            return true;
+        snprintf(path.ptr, path.length, "%s/%s.di", dir, top);
+        if (fileExists(path.ptr))
+            return true;
+    }
+    return false;
+}
+
+/// True when `name` is a preloaded top level package or module.
+bool preloadedTopLevel(const(char)[] name)
+{
+    foreach (top; zygoteTopLevel)
+        if (strlen(top) == name.length && strncmp(top, name.ptr, name.length) == 0)
+            return true;
+    return false;
+}
