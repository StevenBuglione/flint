+/// Flint: hold an error raised inside a hidden directory, with its supplemental trace, until the trace is
+/// complete. Returns true when the diagnostic was held.
+private bool condenseDiagnostic(const SourceLoc loc, const(char)* format, va_list ap, ErrorKind kind,
+    bool supplemental, bool gagged)
+{
+    import dmd.flintdiag : Frame, anchorFrame, condensing, held, hiddenFile, rewriteLibraryMessage, swallowing;
+
+    if (!condensing() || gagged || kind == ErrorKind.message || kind == ErrorKind.tip)
+        return false;
+    if (supplemental && swallowing)
+        return true;
+    if (!supplemental)
+    {
+        swallowing = false;
+        // An error raised during CTFE in library code has no user frame in its own trace; the compiler then
+        // reports "error instantiating" at the user's line. Report the library's message there instead.
+        if (held.active && anchorFrame() == size_t.max)
+        {
+            OutBuffer generic;
+            generic.vprintf(format, ap);
+            const instantiating = strstr(generic.peekChars(), "error instantiating") !is null;
+            if (instantiating && hiddenFile(loc.filename))
+                return true; // keep the library's message and adopt this error's trace to the user's line
+            if (instantiating)
+            {
+                held.frames.push(Frame(loc, null));
+                swallowing = true;
+                flushCondensed();
+                return true;
+            }
+            flushCondensed();
+            if (!hiddenFile(loc.filename))
+            {
+                printHeld(loc, kind, false, "%s", generic.peekChars());
+                return true;
+            }
+            held.active = true;
+            held.loc = loc;
+            held.kind = kind;
+            held.text = rewriteLibraryMessage(generic.extractChars());
+            held.frames.setDim(0);
+            return true;
+        }
+        flushCondensed();
+        if (!hiddenFile(loc.filename))
+            return false;
+        OutBuffer text;
+        text.vprintf(format, ap);
+        held.active = true;
+        held.loc = loc;
+        held.kind = kind;
+        held.text = rewriteLibraryMessage(text.extractChars());
+        held.frames.setDim(0);
+        return true;
+    }
+    if (!held.active)
+        return false;
+    OutBuffer text;
+    text.vprintf(format, ap);
+    held.frames.push(Frame(loc, text.extractChars()));
+    return true;
+}
+
+/// Flint: print the held error at its innermost user frame, the user's outer frames, and one line for the hidden
+/// ones; or unchanged when every frame is hidden.
+void flushCondensed()
+{
+    import dmd.flintdiag : anchorFrame, held, hiddenFile;
+
+    if (!held.active)
+        return;
+    held.active = false;
+    const anchor = anchorFrame();
+    if (anchor == size_t.max)
+    {
+        printHeld(held.loc, held.kind, false, "%s", held.text);
+        foreach (ref frame; held.frames[])
+            printHeld(frame.loc, held.kind, true, "%s", frame.text);
+        return;
+    }
+    printHeld(held.frames[anchor].loc, held.kind, false, "%s", held.text);
+    size_t hidden;
+    foreach (i, ref frame; held.frames[])
+    {
+        if (i <= anchor || hiddenFile(frame.loc.filename))
+            hidden += i < anchor;
+        else if (frame.text)
+            printHeld(frame.loc, held.kind, true, "%s", frame.text);
+    }
+    OutBuffer origin;
+    writeSourceLoc(origin, held.loc, Loc.showColumns, Loc.messageStyle);
+    printHeld(SourceLoc.init, held.kind, true, "raised in library code at %s, through %d hidden frame%s (`flint build --verbose` shows them)",
+        origin.extractChars(), cast(int) hidden + 1, hidden ? "s".ptr : "".ptr);
+}
+
+private void printHeld(const SourceLoc loc, ErrorKind kind, bool supplemental, const(char)* format, ...)
+{
+    va_list ap;
+    va_start(ap, format);
+    DiagnosticContext info = DiagnosticContext(loc, kind, null, null);
+    info.supplemental = supplemental;
+    info.headerColor = classificationFor(kind);
+    printDiagnostic(format, ap, info, false);
+    va_end(ap);
+}
+
 /// Map an `ErrorKind` to the color used for its header in stderr output.
