+/**
+ * The shape of a homogeneous floating point aggregate of 3 or 4 float or double elements,
+ * which AAPCS64 passes and returns in 3 or 4 SIMD registers: the number of elements, plus 8
+ * when they are doubles. 0 for any other type.
+ * The back end has register pairs only, so C calls lower these (dmd.glue.e2ir, dmd.glue).
+ */
+uint hfaShape(Type t)
+{
+    Type rewrite;
+    if (!isHFVA(t, 4, &rewrite))
+        return 0;
+    auto sa = rewrite.isTypeSArray();
+    if (!sa)
+        return 0;
+    const n = cast(uint) sa.dim.toUInteger();
+    if (n < 3)
+        return 0;
+    switch (sa.nextOf().toBasetype().ty)
+    {
+        case Tfloat32: return n;
+        case Tfloat64: return n | 8;
+        default:       return 0;        // vectors
+    }
+}
