+@trusted
+private void prologStoreParamAArch64(ref CodeBuilder cdb, reg_t preg, reg_t base, uint offset, uint size)
+{
+    if (offset % size || offset / size >= 0x1000)
+    {
+        assert(offset < 0x100_0000);
+        cdb.gen1(INSTR.add_addsub_imm(1, 0, offset & 0xFFF, base, 16));         // ADD x16,base,#lo12
