+/**
+ * Flint: the backend state `backend_init` sets, as a fresh process has it. The compile server runs `backend_init`
+ * before preloading, as an ordinary compile runs it before semantic analysis: the inline assembler encodes
+ * addresses by the target's pointer size, and without it assembled 16-bit addressing into preloaded instances.
+ * Each request then starts from the fresh state again, so its own `backend_init` (`config` accumulates flags) gives
+ * what it would give without the server.
+ */
+private struct FreshBackend
+{
+    import dmd.backend.cc : config;
+    import dmd.backend.cdef : Config;
+    import dmd.backend.ty : tytab, _tyrelax, tyequiv, _tysize, _tyalignsize, TYMAX;
+
+    Config config_;
+    uint[256] tytab_;
+    ubyte[TYMAX] tyrelax_, tyequiv_;
+    byte[256] tysize_, tyalignsize_;
+
+    void save()
+    {
+        config_ = config;
+        tytab_ = tytab;
+        tyrelax_ = _tyrelax;
+        tyequiv_ = tyequiv;
+        tysize_ = _tysize;
+        tyalignsize_ = _tyalignsize;
+    }
+
+    void restore()
+    {
+        config = config_;
+        tytab = tytab_;
+        _tyrelax = tyrelax_;
+        tyequiv = tyequiv_;
+        _tysize = tysize_;
+        _tyalignsize = tyalignsize_;
+    }
