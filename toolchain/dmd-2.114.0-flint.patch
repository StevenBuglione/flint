+/**
+ * Load and analyse one prelude module exactly as an import would.
+ */
+bool preloadModule(const(char)[] name)
+{
+    Identifier[] packages;
+    Identifier ident;
+    size_t start = 0;
+    foreach (i; 0 .. name.length + 1)
+    {
+        if (i == name.length || name[i] == '.')
+        {
+            auto id = Identifier.idPool(name[start .. i]);
+            if (i == name.length)
+                ident = id;
+            else
+                packages ~= id;
+            start = i + 1;
+        }
+    }
+    // Already loaded transitively?
+    foreach (m; Module.amodules)
+        if (m.ident is ident && m.md && m.md.packages.length == packages.length)
+        {
+            bool same = true;
+            foreach (i, p; packages)
+                same &= m.md.packages[i] is p;
+            if (same)
+                return true;
+        }
+    recordConditionQueries = true;
+    scope (exit) recordConditionQueries = false;
+    auto m = Module.load(Loc.initial, packages, ident);
+    if (!m)
+        return false;
+    m.importAll(null);
+    m.dsymbolSemantic(null);
+    runDeferredSemantic();
+    m.semantic2(null);
+    runDeferredSemantic2();
+    zygoteModules.setDim(0);
+    foreach (am; Module.amodules)
+    {
+        zygoteModules.push(am);
+        const(char)[] top = am.md && am.md.packages.length ? am.md.packages[0].toString()
+            : am.md ? am.md.id.toString() : am.ident.toString();
+        if (!preloadedTopLevel(top))
+        {
+            auto c = cast(char*) malloc(top.length + 1);
+            memcpy(c, top.ptr, top.length);
+            c[top.length] = 0;
+            zygoteTopLevel.push(c);
+        }
+    }
+    return true;
+}
