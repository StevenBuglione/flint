+/*****************************
+ * Apple AArch64 passes a composite of up to 16 bytes that is not a homogeneous
+ * floating point aggregate in 8-byte aligned stack slots, as in general registers,
+ * while scalars are packed at their natural alignment.
+ */
+@trusted
+bool appleStackComposite(const type* t)
+{
+    const ty = tybasic(t.Tty);
+    if (ty != TYstruct && ty != TYarray)
+        return false;
+    const sz = type_size(t);
+    if (sz == 0 || sz > 2 * REGSIZE)
+        return false;
+    if (ty == TYstruct)
+    {
+        const t1 = t.Ttag.Sstruct.Sarg1type;
+        const t2 = t.Ttag.Sstruct.Sarg2type;
+        if (t1 && tyfloating(t1.Tty) && (!t2 || tyfloating(t2.Tty)))
+            return false;   // HFA: natural alignment
+    }
+    return true;
+}
+
+
+/*****************************
+ * A register variable read or written in part, such as one field of a struct
+ * held in a register: x86 can use a sub-register, AArch64 would need to extract
+ * and insert the bits, so such a variable stays in memory. The halves of a
+ * register pair are whole registers.
+ */
+@trusted
+bool partialRegisterAccess(const Symbol* s, uint sz, targ_size_t offset)
+{
+    const vsz = cast(uint)type_size(s.Stype);
+    if (sz >= vsz && offset == 0)
+        return false;
+    if (isRegisterPair(true, s.Stype.Tty, 0))
+    {
+        const half = vsz / 2;
+        return !(sz == half && (offset == 0 || offset == half));
+    }
+    return true;
+}
