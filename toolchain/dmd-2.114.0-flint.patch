+/*****************************************
+ * Select the ELF relocation for a symbol reference from an AArch64 instruction.
+ * Params:
+ *      ins = the instruction, with its symbol field zero
+ *      isTLS = the symbol is thread local
+ *      viaGOT = the instruction addresses the symbol's GOT entry
+ * Returns:
+ *      the R_AARCH64_xxx relocation
+ */
+private reltype_t aarch64InstructionReloc(uint ins, bool isTLS, bool viaGOT)
+{
+    if ((ins & 0x7C00_0000) == 0x1400_0000)             // B, BL
+        return (ins & 0x8000_0000) ? R_AARCH64_CALL26 : R_AARCH64_JUMP26;
+    if ((ins & 0x9F00_0000) == 0x9000_0000)             // ADRP
+    {
+        if (isTLS)
+            return R_AARCH64_TLSIE_ADR_GOTTPREL_PAGE21;
+        return viaGOT ? R_AARCH64_ADR_GOT_PAGE : R_AARCH64_ADR_PREL_PG_HI21;
+    }
+    if ((ins & 0x7F80_0000) == 0x1100_0000)             // ADD (immediate)
+    {
+        if (isTLS)
+            return (ins & 0x0040_0000) ? R_AARCH64_TLSLE_ADD_TPREL_HI12 : R_AARCH64_TLSLE_ADD_TPREL_LO12_NC;
+        return R_AARCH64_ADD_ABS_LO12_NC;
+    }
+    if ((ins & 0x3B00_0000) == 0x3900_0000)             // LDR/STR (unsigned immediate)
+    {
+        const size = ins >> 30;
+        const simd = (ins >> 26) & 1;
+        const opc  = (ins >> 22) & 3;
+        if (isTLS)
+        {
+            assert(size == 3 && !simd);
+            return R_AARCH64_TLSIE_LD64_GOTTPREL_LO12_NC;
+        }
+        if (viaGOT)
+        {
+            assert(size == 3 && !simd);
+            return R_AARCH64_LD64_GOT_LO12_NC;
+        }
+        if (simd && size == 0 && (opc & 2))
+            return R_AARCH64_LDST128_ABS_LO12_NC;
+        static immutable reltype_t[4] ldst = [R_AARCH64_LDST8_ABS_LO12_NC, R_AARCH64_LDST16_ABS_LO12_NC,
+                                              R_AARCH64_LDST32_ABS_LO12_NC, R_AARCH64_LDST64_ABS_LO12_NC];
+        return ldst[size];
+    }
+    printf("unrecognized AArch64 instruction %08x for relocation\n", ins);
+    assert(0);
+}
