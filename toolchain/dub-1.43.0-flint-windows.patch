+/// Write `objects` into a Microsoft COFF archive at `path` atomically.
+void writeCoffArchive(string path, const string[] objects)
+{
+	import std.algorithm.sorting : sort;
+	import std.bitmanip : nativeToLittleEndian;
+
+	static void header(ref Appender!(ubyte[]) o, string name, size_t size)
+	{
+		auto h = format("%-16s%-12s%-6s%-6s%-8s%-10s`\n", name, "0", "", "", "0", size);
+		assert(h.length == 60);
+		o ~= cast(const(ubyte)[]) h;
+	}
+	static size_t pad(size_t n) { return n + (n & 1); }
+
+	ubyte[][] data;
+	string[][] syms;
+	string[] names;
+	auto longNames = appender!string;
+	foreach (f; objects) {
+		auto bytes = cast(ubyte[]) read(f);
+		data ~= bytes;
+		syms ~= coffDefinedSymbols(bytes);
+		auto n = baseName(f);
+		if (n.length <= 15)
+			names ~= n ~ "/";
+		else {
+			names ~= format("/%s", longNames.data.length);
+			longNames ~= n ~ "\0";
+		}
+	}
+	static struct Entry { string name; size_t member; }
+	Entry[] entries;
+	size_t symNameBytes;
+	foreach (i, s; syms) foreach (n; s) { entries ~= Entry(n, i); symNameBytes += n.length + 1; }
+	const firstSize = 4 + 4 * entries.length + symNameBytes;
+	const secondSize = 4 + 4 * objects.length + 4 + 2 * entries.length + symNameBytes;
+
+	size_t off = 8 + 60 + pad(firstSize) + 60 + pad(secondSize);
+	if (longNames.data.length) off += 60 + pad(longNames.data.length);
+	auto offsets = new size_t[](objects.length);
+	foreach (i, d; data) {
+		offsets[i] = off;
+		off += 60 + pad(d.length);
+	}
+
+	auto o = appender!(ubyte[]);
+	o.reserve(off);
+	o ~= cast(const(ubyte)[]) "!<arch>\n";
+	// First linker member: symbols in member order, big-endian offsets.
+	header(o, "/", firstSize);
+	o ~= nativeToBigEndian(cast(uint) entries.length)[];
+	foreach (e; entries) o ~= nativeToBigEndian(cast(uint) offsets[e.member])[];
+	foreach (e; entries) { o ~= cast(const(ubyte)[]) e.name; o ~= cast(ubyte) 0; }
+	if (firstSize & 1) o ~= cast(ubyte) '\n';
+	// Second linker member: member offsets, then symbols sorted by name with 1-based member indices.
+	auto sorted = entries.dup;
+	sorted.sort!((a, b) => a.name < b.name);
+	header(o, "/", secondSize);
+	o ~= nativeToLittleEndian(cast(uint) objects.length)[];
+	foreach (offset; offsets) o ~= nativeToLittleEndian(cast(uint) offset)[];
+	o ~= nativeToLittleEndian(cast(uint) sorted.length)[];
+	foreach (e; sorted) o ~= nativeToLittleEndian(cast(ushort)(e.member + 1))[];
+	foreach (e; sorted) { o ~= cast(const(ubyte)[]) e.name; o ~= cast(ubyte) 0; }
+	if (secondSize & 1) o ~= cast(ubyte) '\n';
+	if (longNames.data.length) {
+		header(o, "//", longNames.data.length);
+		o ~= cast(const(ubyte)[]) longNames.data;
+		if (longNames.data.length & 1) o ~= cast(ubyte) '\n';
+	}
+	foreach (i, d; data) {
+		header(o, names[i], d.length);
+		o ~= d;
+		if (d.length & 1) o ~= cast(ubyte) '\n';
+	}
