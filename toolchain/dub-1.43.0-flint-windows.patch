-/// Write `objects` into the archive at `path` atomically.
+/// External symbols defined by a Microsoft COFF or big-object COFF file (empty for other formats).
+string[] coffDefinedSymbols(const(ubyte)[] obj)
+{
+	static T get(T)(const(ubyte)[] b, size_t off) {
+		if (off + T.sizeof > b.length) return T.init;
+		T v;
+		(cast(ubyte*) &v)[0 .. T.sizeof] = b[off .. off + T.sizeof];
+		return v;
+	}
+	string[] result;
+	size_t symbols, count, entry;
+	bool big;
+	if (obj.length >= 56 && get!ushort(obj, 0) == 0 && get!ushort(obj, 2) == 0xFFFF && get!ushort(obj, 4) >= 2) {
+		// ANON_OBJECT_HEADER_BIGOBJ: 32-bit section numbers, 20-byte symbol records.
+		big = true;
+		symbols = get!uint(obj, 48);
+		count = get!uint(obj, 52);
+		entry = 20;
+	} else if (obj.length >= 20) {
+		symbols = get!uint(obj, 8);
+		count = get!uint(obj, 12);
+		entry = 18;
+	} else
+		return result;
+	const strings = symbols + count * entry;
+	if (symbols == 0 || strings > obj.length) return result;
+	for (size_t i = 0; i < count; i++) {
+		const e = symbols + i * entry;
+		const value = get!uint(obj, e + 8);
+		const long section = big ? get!int(obj, e + 12) : get!short(obj, e + 12);
+		const storage = obj[e + (big ? 18 : 16)];
+		const aux = obj[e + (big ? 19 : 17)];
+		// IMAGE_SYM_CLASS_EXTERNAL, defined in a section or as a common symbol.
+		if (storage == 2 && (section > 0 || (section == 0 && value != 0))) {
+			string name;
+			if (get!uint(obj, e) == 0) {
+				size_t start = strings + get!uint(obj, e + 4), end = start;
+				while (end < obj.length && obj[end]) end++;
