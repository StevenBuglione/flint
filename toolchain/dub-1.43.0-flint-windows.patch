+			} else {
+				size_t end = 0;
+				while (end < 8 && obj[e + end]) end++;
+				name = cast(string) obj[e .. e + end].idup;
+			}
+			if (name.length) result ~= name;
+		}
+		i += aux;
+	}
+	return result;
