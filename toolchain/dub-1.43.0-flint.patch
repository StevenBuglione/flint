+	foreach (k, v; env) envp ~= (k ~ "=" ~ v).toStringz;
+	envp ~= null;
+	// Resolve the program through PATH as execvp would.
+	string prog = args[0];
+	if (!prog.canFind('/'))
+		foreach (dir; env.get("PATH", "").splitter(':')) {
+			auto cand = dir ~ "/" ~ prog;
+			if (existsFile(cand)) { prog = cand; break; }
+		}
+	posix_spawn_file_actions_t actions;
+	posix_spawn_file_actions_init(&actions);
+	scope (exit) posix_spawn_file_actions_destroy(&actions);
+	enforce(posix_spawn_file_actions_addchdir_np(&actions, cwd.toStringz) == 0, "posix_spawn chdir");
+	pid_t pid;
+	const rc = posix_spawn(&pid, prog.toStringz, &actions, null, cast(char**) argv.ptr, cast(char**) envp.ptr);
+	enforce(rc == 0, "failed to spawn " ~ prog);
+	return pid;
+}
