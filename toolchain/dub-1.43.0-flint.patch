diff --git a/source/dub/internal/flintar.d b/source/dub/internal/flintar.d
new file mode 100644
index 0000000..332ffe4
--- /dev/null
+++ b/source/dub/internal/flintar.d
@@ -0,0 +1,122 @@
+/**
+	In-process static library writer for the Flint DUB fork.
+
+	Produces a GNU/SysV `ar` archive with a `/` symbol index and a `//` long
+	name table, equivalent to `ar rcs` for ELF64 objects, without spawning a
+	process.  Members are stored in the given order with zero timestamps.
+*/
+module dub.internal.flintar;
+
+import std.array : appender, Appender;
+import std.bitmanip : nativeToBigEndian;
+import std.file : read, write, rename, remove, exists;
+import std.format : format;
+import std.path : baseName;
+
+/// Global symbols defined by an ELF64 relocatable object (empty for other formats).
+string[] definedSymbols(const(ubyte)[] obj)
+{
+	static T get(T)(const(ubyte)[] b, size_t off) {
+		if (off + T.sizeof > b.length) return T.init;
+		T v;
+		(cast(ubyte*) &v)[0 .. T.sizeof] = b[off .. off + T.sizeof];
+		return v;
+	}
+	string[] result;
+	if (obj.length < 64 || obj[0 .. 4] != [0x7f, 'E', 'L', 'F'] || obj[4] != 2 || obj[5] != 1)
+		return result;
+	const shoff = get!ulong(obj, 0x28);
+	const shentsize = get!ushort(obj, 0x3A);
+	const shnum = get!ushort(obj, 0x3C);
+	foreach (i; 0 .. shnum) {
+		const sh = shoff + i * shentsize;
+		if (get!uint(obj, sh + 4) != 2) continue; // SHT_SYMTAB
+		const symoff = get!ulong(obj, sh + 0x18);
+		const symsize = get!ulong(obj, sh + 0x20);
+		const link = get!uint(obj, sh + 0x28);
+		const entsize = get!ulong(obj, sh + 0x38);
+		const strsh = shoff + link * shentsize;
+		const stroff = get!ulong(obj, strsh + 0x18);
+		const strsize = get!ulong(obj, strsh + 0x20);
+		if (!entsize) continue;
+		foreach (s; 0 .. symsize / entsize) {
+			const e = symoff + s * entsize;
+			const name = get!uint(obj, e);
+			const info = obj[e + 4];
+			const shndx = get!ushort(obj, e + 6);
+			const bind = info >> 4;
+			const type = info & 0xf;
+			if ((bind != 1 && bind != 2 && bind != 10) || shndx == 0 || type == 4 /*FILE*/ || type == 3 /*SECTION*/)
+				continue;
+			if (name >= strsize) continue;
+			size_t end = stroff + name;
+			while (end < stroff + strsize && end < obj.length && obj[end]) end++;
+			result ~= cast(string) obj[stroff + name .. end].idup;
+		}
+	}
+	return result;
+}
+
+/// Write `objects` into the archive at `path` atomically.
+void writeArchive(string path, const string[] objects)
+{
+	static void header(ref Appender!(ubyte[]) o, string name, size_t size)
+	{
+		auto h = format("%-16s%-12s%-6s%-6s%-8s%-10s`\n", name, "0", "0", "0", "644", size);
+		assert(h.length == 60);
+		o ~= cast(const(ubyte)[]) h;
+	}
+
+	ubyte[][] data;
+	string[][] syms;
+	string[] names;
+	auto longNames = appender!string;
+	foreach (f; objects) {
+		auto bytes = cast(ubyte[]) read(f);
+		data ~= bytes;
+		syms ~= definedSymbols(bytes);
+		auto n = baseName(f);
+		if (n.length <= 15)
+			names ~= n ~ "/";
+		else {
+			names ~= format("/%s", longNames.data.length);
+			longNames ~= n ~ "/\n";
+		}
+	}
+	size_t nsyms;
+	size_t symNameBytes;
+	foreach (s; syms) foreach (n; s) { nsyms++; symNameBytes += n.length + 1; }
+	const symtabSize = 4 + 4 * nsyms + symNameBytes;
+	size_t pad(size_t n) { return n + (n & 1); }
+
+	// Member offsets.
+	size_t off = 8 + 60 + pad(symtabSize);
+	if (longNames.data.length) off += 60 + pad(longNames.data.length);
+	auto offsets = new size_t[](objects.length);
+	foreach (i, d; data) {
+		offsets[i] = off;
+		off += 60 + pad(d.length);
+	}
+
+	auto o = appender!(ubyte[]);
+	o.reserve(off);
+	o ~= cast(const(ubyte)[]) "!<arch>\n";
+	header(o, "/", symtabSize);
+	o ~= nativeToBigEndian(cast(uint) nsyms)[];
+	foreach (i, s; syms) foreach (n; s) o ~= nativeToBigEndian(cast(uint) offsets[i])[];
+	foreach (s; syms) foreach (n; s) { o ~= cast(const(ubyte)[]) n; o ~= cast(ubyte) 0; }
+	if (symtabSize & 1) o ~= cast(ubyte) '\n';
+	if (longNames.data.length) {
+		header(o, "//", longNames.data.length);
+		o ~= cast(const(ubyte)[]) longNames.data;
+		if (longNames.data.length & 1) o ~= cast(ubyte) '\n';
+	}
+	foreach (i, d; data) {
+		header(o, names[i], d.length);
+		o ~= d;
+		if (d.length & 1) o ~= cast(ubyte) '\n';
+	}
+	const tmp = path ~ ".tmp";
+	write(tmp, o.data);
+	rename(tmp, path);
+}
diff --git a/source/dub/internal/flinttrace.d b/source/dub/internal/flinttrace.d
new file mode 100644
index 0000000..fcc3657
--- /dev/null
+++ b/source/dub/internal/flinttrace.d
@@ -0,0 +1,24 @@
+/// Lightweight phase timing for the Flint DUB fork (FLINT_DUB_TRACE=1).
+module dub.internal.flinttrace;
+
+import core.time : MonoTime;
+
+private __gshared MonoTime start;
+private __gshared int enabled = -1;
+
+shared static this() { start = MonoTime.currTime; }
+
+void ftrace(lazy string what) nothrow
+{
+	import core.stdc.stdlib : getenv;
+	import core.stdc.stdio : fprintf, stderr;
+	if (enabled < 0)
+		enabled = getenv("FLINT_DUB_TRACE") !is null;
+	if (!enabled)
+		return;
+	try {
+		const us = (MonoTime.currTime - start).total!"usecs";
+		auto w = what;
+		fprintf(stderr, "[flint-dub %6.1fms] %.*s\n", us / 1000.0, cast(int) w.length, w.ptr);
+	} catch (Exception) {}
+}
