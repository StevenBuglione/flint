+{
+    version (linux)
+        package(core) enum realIsNarrowerThanCLongDouble = real.mant_dig == 53;
+    else
+        package(core) enum realIsNarrowerThanCLongDouble = false;
+}
+else
+    package(core) enum realIsNarrowerThanCLongDouble = false;
+
+package(core) template longDoubleMangle(string name, string doubleName)
+{
+    static if (realIsNarrowerThanCLongDouble)
+        enum longDoubleMangle = doubleName;
+    else
+        enum longDoubleMangle = name;
+}
