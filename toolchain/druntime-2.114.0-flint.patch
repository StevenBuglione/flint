new file mode 100644
index 0000000..0f472ea
--- /dev/null
+++ b/src/core/internal/atomic_aarch64.c
@@ -0,0 +1,134 @@
+/**
+ * Atomic operations for DMD's AArch64 code generator, which has no atomic
+ * intrinsics and no AArch64 inline assembler. core.internal.atomic calls these.
+ *
+ * The memory order argument uses the C11 numbering, which core.atomic.MemoryOrder
+ * shares (raw = relaxed = 0, acq = 2, rel = 3, acq_rel = 4, seq = 5). A
+ * non-constant order is treated as sequentially consistent by the compiler,
+ * which is always correct.
+ *
+ * Copyright: The D Language Foundation and the Flint authors.
+ * License:   $(LINK2 http://www.boost.org/LICENSE_1_0.txt, Boost License 1.0)
+ */
+#if defined(__aarch64__) || defined(__arm64__)
+#include <stdint.h>
+#include <stdbool.h>
+
+#define DEFINE(N, T)                                                                 \
+    T _d_atomic_load_##N(const volatile T *p, int order)                             \
+    { (void)order; return __atomic_load_n(p, __ATOMIC_SEQ_CST); }                    \
+    void _d_atomic_store_##N(volatile T *p, T v, int order)                          \
+    { (void)order; __atomic_store_n(p, v, __ATOMIC_SEQ_CST); }                       \
+    T _d_atomic_fetch_add_##N(volatile T *p, T v, int order)                         \
+    { (void)order; return __atomic_fetch_add(p, v, __ATOMIC_SEQ_CST); }              \
+    T _d_atomic_exchange_##N(volatile T *p, T v, int order)                          \
+    { (void)order; return __atomic_exchange_n(p, v, __ATOMIC_SEQ_CST); }             \
+    bool _d_atomic_cas_##N(volatile T *p, T *expected, T desired, int succ, int fail) \
+    {                                                                                \
+        (void)succ; (void)fail;                                                      \
+        return __atomic_compare_exchange_n(p, expected, desired, false,              \
+                                           __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);      \
+    }
+
+DEFINE(1, uint8_t)
+DEFINE(2, uint16_t)
+DEFINE(4, uint32_t)
+DEFINE(8, uint64_t)
+
+/* 16 byte compare-and-swap with an exclusive pair loop, which every ARMv8 core
+ * supports and which the C compilers would otherwise route to libatomic.
+ */
+typedef unsigned __int128 u128;
+
+static bool cas16(volatile u128 *p, uint64_t *expected, uint64_t dlo, uint64_t dhi)
+{
+    uint64_t olo, ohi;
+    uint32_t failed;
+    __asm__ __volatile__(
+        "1: ldaxp   %0, %1, [%3]\n"
+        "   cmp     %0, %4\n"
+        "   ccmp    %1, %5, #0, eq\n"
+        "   b.ne    2f\n"
+        "   stlxp   %w2, %6, %7, [%3]\n"
+        "   cbnz    %w2, 1b\n"
+        "   b       3f\n"
+        "2: stlxp   %w2, %0, %1, [%3]\n"     /* store back what was read, so the read is atomic */
+        "   cbnz    %w2, 1b\n"
+        "   mov     %w2, #1\n"
+        "3:\n"
+        : "=&r"(olo), "=&r"(ohi), "=&r"(failed)
+        : "r"(p), "r"(expected[0]), "r"(expected[1]), "r"(dlo), "r"(dhi)
+        : "cc", "memory");
+    if (failed)
+    {
+        expected[0] = olo;
+        expected[1] = ohi;
+        return false;
+    }
+    return true;
+}
+
+bool _d_atomic_cas_16(volatile u128 *p, u128 *expected, const u128 *desired, int succ, int fail)
+{
+    (void)succ; (void)fail;
+    const uint64_t *d = (const uint64_t *)desired;
+    return cas16(p, (uint64_t *)expected, d[0], d[1]);
+}
+
+void _d_atomic_load_16(volatile u128 *p, u128 *result, int order)
+{
+    (void)order;
+    uint64_t e[2] = {0, 0};
+    cas16(p, e, 0, 0);          /* fails and loads the value, or stores the 0 that is there */
+    ((uint64_t *)result)[0] = e[0];
+    ((uint64_t *)result)[1] = e[1];
+}
+
+void _d_atomic_store_16(volatile u128 *p, const u128 *value, int order)
+{
+    (void)order;
+    const uint64_t *v = (const uint64_t *)value;
+    uint64_t e[2] = {0, 0};
+    while (!cas16(p, e, v[0], v[1]))
+    {
+    }
+}
+
+void _d_atomic_fence(int order)
+{
+    (void)order;
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+}
+
+void _d_atomic_pause(void)
+{
+    __asm__ __volatile__("yield");
+}
+
+/* Floating point status (FPSR) and control (FPCR) registers, for
+ * std.math.hardware under DMD.
+ */
+uint32_t _d_aarch64_get_fpsr(void)
+{
+    uint64_t v;
+    __asm__ __volatile__("mrs %0, fpsr" : "=r"(v));
+    return (uint32_t)v;
+}
+
+void _d_aarch64_set_fpsr(uint32_t v)
+{
+    __asm__ __volatile__("msr fpsr, %0" : : "r"((uint64_t)v));
+}
+
+uint32_t _d_aarch64_get_fpcr(void)
+{
+    uint64_t v;
+    __asm__ __volatile__("mrs %0, fpcr" : "=r"(v));
+    return (uint32_t)v;
+}
+
+void _d_aarch64_set_fpcr(uint32_t v)
+{
+    __asm__ __volatile__("msr fpcr, %0" : : "r"((uint64_t)v));
+}
+#endif
