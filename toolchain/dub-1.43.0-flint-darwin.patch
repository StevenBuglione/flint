+/// Write `objects` into a BSD archive with a sorted table of contents at `path` atomically.
+void writeDarwinArchive(string path, const string[] objects)
+{
+	import std.algorithm.sorting : sort;
+	import std.bitmanip : nativeToLittleEndian;
+
+	enum symdef = "__.SYMDEF SORTED";
+	static size_t align8(size_t n) { return (n + 7) & ~cast(size_t) 7; }
+	// A `#1/N` name length that ends the 60-byte header and the name on an 8-byte boundary.
+	static size_t nameLength(size_t n) { size_t l = n + 1; while ((60 + l) % 8) l++; return l; }
+	static void header(ref Appender!(ubyte[]) o, string name, size_t size)
+	{
+		const length = nameLength(name.length);
+		auto h = format("%-16s%-12s%-6s%-6s%-8s%-10s`\n", format("#1/%s", length), "0", "0", "0", "100644", length + size);
+		assert(h.length == 60);
+		o ~= cast(const(ubyte)[]) h;
+		o ~= cast(const(ubyte)[]) name;
+		foreach (_; name.length .. length) o ~= cast(ubyte) 0;
+	}
+
+	ubyte[][] data;
+	string[] names;
+	static struct Entry { string name; size_t member; }
+	Entry[] entries;
+	foreach (i, f; objects) {
+		auto bytes = cast(ubyte[]) read(f);
+		data ~= bytes;
+		names ~= baseName(f);
+		foreach (n; machoDefinedSymbols(bytes)) entries ~= Entry(n, i);
+	}
+	// Sorted by name; the first member defining a name wins, as the linker would load it.
+	entries.sort!((a, b) => a.name < b.name || (a.name == b.name && a.member < b.member));
+	Entry[] unique;
+	foreach (e; entries) if (!unique.length || unique[$ - 1].name != e.name) unique ~= e;
+	size_t strtab;
+	foreach (e; unique) strtab += e.name.length + 1;
+	strtab = align8(strtab);
+	const tocSize = 4 + 8 * unique.length + 4 + strtab;
+
+	size_t off = 8 + 60 + nameLength(symdef.length) + tocSize;
+	auto offsets = new size_t[](objects.length);
+	foreach (i, d; data) {
+		offsets[i] = off;
+		off += 60 + nameLength(names[i].length) + align8(d.length);
+	}
+
+	auto o = appender!(ubyte[]);
+	o.reserve(off);
+	o ~= cast(const(ubyte)[]) "!<arch>\n";
+	header(o, symdef, tocSize);
+	o ~= nativeToLittleEndian(cast(uint)(8 * unique.length))[];
+	size_t strx;
+	foreach (e; unique) {
+		o ~= nativeToLittleEndian(cast(uint) strx)[];
+		o ~= nativeToLittleEndian(cast(uint) offsets[e.member])[];
+		strx += e.name.length + 1;
+	}
+	o ~= nativeToLittleEndian(cast(uint) strtab)[];
+	foreach (e; unique) { o ~= cast(const(ubyte)[]) e.name; o ~= cast(ubyte) 0; }
+	foreach (_; strx .. strtab) o ~= cast(ubyte) 0;
+	foreach (i, d; data) {
+		assert(o.data.length == offsets[i]);
+		header(o, names[i], align8(d.length));
+		assert(o.data.length % 8 == 0);
+		o ~= d;
+		foreach (_; d.length .. align8(d.length)) o ~= cast(ubyte) 0;
+	}
+	assert(o.data.length == off);
+	const tmp = path ~ ".tmp";
+	write(tmp, o.data);
+	rename(tmp, path);
+}
