+/// External symbols defined by a 64-bit Mach-O object (empty for other formats).
+string[] machoDefinedSymbols(const(ubyte)[] obj)
+{
+	static T get(T)(const(ubyte)[] b, size_t off) {
+		if (off + T.sizeof > b.length) return T.init;
+		T v;
+		(cast(ubyte*) &v)[0 .. T.sizeof] = b[off .. off + T.sizeof];
+		return v;
+	}
+	string[] result;
+	if (obj.length < 32 || get!uint(obj, 0) != 0xFEEDFACF) return result;
+	const ncmds = get!uint(obj, 16);
+	size_t cmd = 32;
+	foreach (_; 0 .. ncmds) {
+		const kind = get!uint(obj, cmd);
+		const size = get!uint(obj, cmd + 4);
+		if (size < 8) break;
+		if (kind == 0x2) { // LC_SYMTAB
+			const symoff = get!uint(obj, cmd + 8);
+			const nsyms = get!uint(obj, cmd + 12);
+			const stroff = get!uint(obj, cmd + 16);
+			const strsize = get!uint(obj, cmd + 20);
+			foreach (i; 0 .. nsyms) {
+				const e = symoff + i * 16;
+				if (e + 16 > obj.length) break;
+				const strx = get!uint(obj, e);
+				const type = obj[e + 4];
+				// Not a debugging entry, external, and defined (not N_UNDF): what `ranlib` lists.
+				if ((type & 0xE0) || !(type & 0x01) || !(type & 0x0E) || strx >= strsize) continue;
+				size_t start = stroff + strx, end = start;
+				while (end < stroff + strsize && end < obj.length && obj[end]) end++;
+				if (end > start) result ~= cast(string) obj[start .. end].idup;
+			}
+		}
+		cmd += size;
+	}
+	return result;
+}
