+    assert(to!double("0.7") is 0x1.6666666666666p-1);
+    assert(to!double("0.3") is 0x1.3333333333333p-2);
+    assert(to!double("2.675") is 0x1.5666666666666p+1);
+    assert(to!double("-12345.6789e-3") is -0x1.8b0fcd324d5a2p+3);
+    assert(to!double("1e22") is 0x1.0f0cf064dd592p+73);
+    assert(to!real("0.1") == to!double("0.1"));
+}
