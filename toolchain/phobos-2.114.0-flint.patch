+    /* Clinger's fast path: a mantissa of at most 2^53 and a power of ten of at most 22 are exact in a
+     * double, so one multiplication or division rounds correctly. With a 64-bit real (DMD and LDC on
+     * AArch64), the loop below rounds at every step and was one ulp off for "0.7" or "2.675".
+     */
+    bool exact = false;
+    static if (real.mant_dig == double.mant_dig && !is(Unqual!Target == float))
+    {
+        static immutable double[23] exactPow10 = [1e0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10,
+            1e11, 1e12, 1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19, 1e20, 1e21, 1e22];
+        if (!isHex && msscale == 1 && msdec <= (1UL << 53) && exp >= -22 && exp <= 22)
+        {
+            const double mantissa = msdec;
+            ldval = exp < 0 ? mantissa / exactPow10[-exp] : mantissa * exactPow10[exp];
+            exact = true;
+        }
+    }
+
+    if (!exact)
+        ldval = msdec;
+    if (!exact && msscale != 1)     /* if stuff was accumulated in lsdec */
         ldval = ldval * msscale + lsdec;
