name "bench-micro"
description "Independent Flint operation measurements"
targetType "executable"
targetPath "../../build"
targetName "bench-micro"
sourcePaths "source"
sourceFiles "../bench-rest/source/flint_bench_rest/profile.d" "../hot-gc/source/flint_bench_gc/sys/loopback.d"
importPaths "source" "../bench-rest/source" "../hot-gc/source"
dflags "-preview=dip1000"
dependency "flint:arena" path="../.."
dependency "flint:conc" path="../.."
dependency "flint:reactor" path="../.."
dependency "flint:serde" path="../.."
dependency "flint:validate" path="../.."
dependency "flint:web" path="../.."
