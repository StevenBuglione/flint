module data_contract_tests;

import flint.arena : Buffer, Error, RequestArena, Status, Text;
import flint.conc : CancelSource, Context, Deadline;
import flint.engine.data : Column, Id, Nullable, Query, ReadOnly, SqlRepository, Table, Version, mapRow;
import flint.engine.sql : Driver, Pool, PoolOptions;
import std.process : environment;

@safe:

@Table("records")
private struct Entity
{
    @Id
    ulong id;
    @Column("display_name")
    Text name;
    bool active;
    long amount;
    Nullable!Text alias_;
    Nullable!long count;
    Buffer wire;
    @ReadOnly
    Text label;
    @Version
    ulong revision;
}

@Table("records")
private struct WrongType
{
    @Id
    ulong id;
    @Column("display_name")
    int textAsInteger;
}

@Table("records")
private struct NonNullable
{
    @Id
    ulong id;
    @Column("alias_")
    Text required;
}

@Table("records")
private struct AbsentColumn
{
    @Id
    ulong id;
    @Column("missing_column")
    Text unavailable;
}

private struct Projection
{
    @Column("display")
    Text name;
    long amount;
}

@Query("SELECT display_name AS \"display\", amount FROM records "
        ~ "WHERE amount = :required AND (id = :key OR id = :key) "
        ~ "AND ':not_a_param' = ':not_a_param' /* :ignored */; -- :trailing")
private struct Match
{
    ulong key;
    long required;
}

@Query("SELECT display_name AS \"display\", amount FROM records ORDER BY id -- :ignored")
private struct Projections
{
}

@Query("SELECT 7::bigint AS amount, $tag$:ignored$tag$ AS \"display\" WHERE :key = :key")
private struct DollarQuoted
{
    long key;
}

private void runSql(ref Pool pool, scope const(char)[] statement)
{
    Context context;
    auto acquired = pool.acquire(context);
    assert(acquired.ok(), acquired.error.message);
    scope (exit)
        assert(pool.release(acquired.value).code == Status.ok);
    scope RequestArena arena;
    const outcome = acquired.value.execute(statement, [], arena, context);
    assert(outcome.ok(), outcome.error.message);
}

private Pool open(Driver driver, string address)
{
    PoolOptions settings;
    settings.driver = driver;
    settings.connectionString = address;
    settings.maxConnections = 1;
    Pool pool;
    const opened = pool.open(settings);
    assert(opened.code == Status.ok, opened.message);
    const id = driver == Driver.sqlite ? "INTEGER PRIMARY KEY" : "BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY";
    runSql(pool, "CREATE TEMP TABLE records(id " ~ id ~ ", display_name TEXT NOT NULL, "
            ~ "active BOOLEAN NOT NULL, amount BIGINT NOT NULL, alias_ TEXT, count BIGINT, "
            ~ "wire BYTEA NOT NULL, label TEXT NOT NULL DEFAULT 'from_database', revision BIGINT NOT NULL)");
    return pool;
}

private Buffer store(ref scope RequestArena arena, scope const(char)[] bytes) nothrow @nogc
{
    const result = arena.copyIn(cast(const(ubyte)[]) bytes);
    assert(result.ok());
    return result.value;
}

private void expectBytes(ref scope RequestArena arena, Buffer value, scope const(char)[] expected) nothrow @nogc
{
    bool equal;
    const status = arena.read(value, (scope const(ubyte)[] found) @safe nothrow @nogc {
        equal = found == cast(const(ubyte)[]) expected;
    });
    assert(status == Status.ok && equal);
}

private Entity rowForTest(ref scope RequestArena arena)
{
    Entity input;
    input.name = Text(store(arena, "Robert'); -- bound data"));
    input.active = true;
    input.amount = long.min;
    input.count = Nullable!long(true, 0);
    input.wire = store(arena, "blob\0value");
    return input;
}

private void expectInitial(scope const ref Entity entity, ref scope RequestArena arena)
{
    assert(entity.id != 0 && entity.active && entity.amount == long.min && entity.revision == 0);
    assert(!entity.alias_.present && entity.count.present && entity.count.value == 0);
    expectBytes(arena, entity.name.bytes, "Robert'); -- bound data");
    expectBytes(arena, entity.wire, "blob\0value");
    expectBytes(arena, entity.label.bytes, "from_database");
}

private void expectSchemaFailure(T)(ref Pool pool)
{
    bool rejected;
    try
        new SqlRepository!(T, ulong)(pool);
    catch (Exception error)
    {
        assert(error.msg == "could not verify SQL repository schema for records");
        rejected = true;
    }
    assert(rejected);
}

private void optimisticLock(SqlRepository!(Entity, ulong) repository, ulong id, ref Context context)
{
    ubyte[4096] firstBytes;
    ubyte[4096] secondBytes;
    scope firstArena = RequestArena(firstBytes[]);
    scope secondArena = RequestArena(secondBytes[]);
    auto first = repository.findById(id, firstArena, context);
    auto second = repository.findById(id, secondArena, context);
    assert(first.ok() && second.ok());
    assert(first.value.revision == second.value.revision);
    first.value.name = Text(store(firstArena, "updated"));
    first.value.active = false;
    first.value.amount = long.max;
    first.value.alias_ = Nullable!Text(true, Text(store(firstArena, "")));
    first.value.count = Nullable!long.init;
    const changed = repository.save(first.value, firstArena, context);
    assert(changed.ok(), changed.error.message);
    assert(changed.value.revision == 1 && !changed.value.active && changed.value.amount == long.max);
    assert(changed.value.alias_.present && changed.value.alias_.value.bytes.length() == 0);
    assert(!changed.value.count.present);
    second.value.name = Text(store(secondArena, "stale"));
    assert(repository.save(second.value, secondArena, context).error.code == Status.conflict);
    const read = repository.findById(id, firstArena, context);
    assert(read.ok() && read.value.revision == 1);
    expectBytes(firstArena, read.value.name.bytes, "updated");

    const expired = read.value.name.bytes;
    assert(firstArena.reset() == Status.ok);
    assert(firstArena.read(expired, (scope const(ubyte)[]) @safe nothrow @nogc {}) != Status.ok);
}

private void namedQueries(SqlRepository!(Entity, ulong) repository, ulong id, Driver driver,
        ref scope RequestArena arena, ref Context context)
{
    const parameters = Match(id, long.max);
    const projected = repository.queryOne!Projection(parameters, arena, context);
    assert(projected.ok(), projected.error.message);
    assert(projected.value.amount == long.max);
    expectBytes(arena, projected.value.name.bytes, "updated");
    const many = Projections.init;
    assert(repository.queryOne!Projection(many, arena, context).error.code == Status.conflict);
    if (driver == Driver.postgres)
    {
        const dollar = DollarQuoted(3);
        const quoted = repository.queryOne!Projection(dollar, arena, context);
        assert(quoted.ok() && quoted.value.amount == 7);
        expectBytes(arena, quoted.value.name.bytes, ":ignored");
    }
}

private void badTypes(ref Pool pool, ulong id, ref scope RequestArena arena, ref Context context)
{
    auto scalar = new SqlRepository!(WrongType, ulong)(pool);
    assert(scalar.findById(id, arena, context).error.code == Status.invalidArgument);
    auto required = new SqlRepository!(NonNullable, ulong)(pool);
    assert(required.findById(id, arena, context).error.code == Status.invalidArgument);
}

private void exercise(Driver driver, string address)
{
    auto pool = open(driver, address);
    Context context;
    scope (exit)
        assert(pool.close(context).code == Status.ok);
    auto addressCopy = pool;
    auto repository = new SqlRepository!(Entity, ulong)(addressCopy);
    addressCopy = Pool.init;
    expectSchemaFailure!AbsentColumn(pool);

    ubyte[8192] bytes;
    scope arena = RequestArena(bytes[]);
    const input = rowForTest(arena);
    const created = repository.save(input, arena, context);
    assert(created.ok(), created.error.message);
    expectInitial(created.value, arena);
    const id = created.value.id;
    badTypes(pool, id, arena, context);
    optimisticLock(repository, id, context);

    Entity explicit = input;
    explicit.id = cast(ulong) long.max;
    const inserted = repository.insert(explicit, arena, context);
    assert(inserted.ok() && inserted.value.id == explicit.id);
    assert(repository.insert(explicit, arena, context).error.code == Status.conflict);
    assert(repository.insert(input, arena, context).error.code == Status.invalidArgument);
    assert(repository.existsById(ulong.max, context).error.code == Status.invalidArgument);
    namedQueries(repository, id, driver, arena, context);
    assert(repository.existsById(id, context).value);
    assert(repository.deleteById(id, context).code == Status.ok);
    assert(repository.deleteById(id, context).code == Status.ok);
    const absent = repository.existsById(id, context);
    assert(absent.ok() && !absent.value);
    assert(repository.findById(id, arena, context).error.code == Status.notFound);

    auto expiry = CancelSource.create(Context.init, Deadline.afterMillis(0));
    assert(expiry.ok());
    auto expired = expiry.value.context();
    assert(repository.findById(explicit.id, arena, expired).error.code == Status.timedOut);
    runSql(pool, "ALTER TABLE records RENAME COLUMN display_name TO old_name");
    expectSchemaFailure!Entity(pool);
}

@("raw mapRow preserves ownership, checks types and rejects null substitutes")
unittest
{
    ubyte[512] scratch;
    scope arena = RequestArena(scratch[]);
    Entity entity;
    assert(mapRow(entity, arena, "display_name", cast(const(ubyte)[]) "Āβ").code == Status.ok);
    expectBytes(arena, entity.name.bytes, "Āβ");
    assert(mapRow(entity, arena, "active", cast(const(ubyte)[]) "t").code == Status.ok);
    assert(entity.active);
    assert(mapRow(entity, arena, "amount", cast(const(ubyte)[]) "-9223372036854775808").code == Status.ok);
    assert(entity.amount == long.min);
    assert(mapRow(entity, arena, "id", cast(const(ubyte)[]) "9223372036854775808").code == Status.invalidArgument);
    assert(mapRow(entity, arena, "alias_", []).code == Status.ok && entity.alias_.present);
    assert(mapRow(entity, arena, "display_name", cast(const(ubyte)[]) "\xC0\x80").code == Status.invalidArgument);
    assert(mapRow(entity, arena, "no_column", []).code == Status.notFound);
}

version (FlintNativeSqlite)
{
    @("SQLite repository roundtrip, schema drift, named query and optimistic lock")
    unittest
    {
        exercise(Driver.sqlite, ":memory:");
    }
}

version (FlintNativeLibpq)
{
    @("PostgreSQL repository roundtrip, schema drift, named query and optimistic lock")
    unittest
    {
        const address = environment.get("FLINT_DATA_PG_TEST_DSN");
        if (address.length != 0)
            exercise(Driver.postgres, address);
    }
}

@Query("SELECT \"t:x\".display_name AS \"display\", \"t:x\".amount FROM records AS \"t:x\" "
        ~ "WHERE \"t:x\".id = :key AND \"t:x\".amount = :amount AND \"t:x\".id = :key")
private struct QuotedIdentifierColon
{
    long amount;
    ulong key;
}

private void exerciseLexerAndOwnership(Driver driver, string address)
{
    auto pool = open(driver, address);
    Context context;
    scope (exit)
        assert(pool.close(context).code == Status.ok);
    auto repository = new SqlRepository!(Entity, ulong)(pool);
    ubyte[8192] bytes;
    scope arena = RequestArena(bytes[]);
    const input = rowForTest(arena);
    const created = repository.save(input, arena, context);
    assert(created.ok(), created.error.message);
    const second = repository.save(input, arena, context);
    assert(second.ok() && second.value.id != 0 && second.value.id != created.value.id);

    // query_lexer: a colon inside a quoted identifier is not a parameter; :key is repeated and bound once.
    const arguments = QuotedIdentifierColon(long.min, created.value.id);
    const projected = repository.queryOne!Projection(arguments, arena, context);
    assert(projected.ok(), projected.error.message);
    assert(projected.value.amount == long.min);
    expectBytes(arena, projected.value.name.bytes, "Robert'); -- bound data");

    // ownership: a raw struct copy shares the arena handles and fails the generation check after reset.
    ubyte[4096] ownedBytes;
    scope owned = RequestArena(ownedBytes[]);
    const found = repository.findById(created.value.id, owned, context);
    assert(found.ok());
    const Entity cached = found.value;
    expectBytes(owned, cached.name.bytes, "Robert'); -- bound data");
    assert(owned.reset() == Status.ok);
    assert(owned.read(cached.name.bytes, (scope const(ubyte)[]) @safe nothrow @nogc {}) != Status.ok);
    assert(owned.read(cached.wire, (scope const(ubyte)[]) @safe nothrow @nogc {}) != Status.ok);
    assert(owned.read(cached.label.bytes, (scope const(ubyte)[]) @safe nothrow @nogc {}) != Status.ok);
    // The handle does not resolve against another live arena either.
    assert(arena.read(cached.name.bytes, (scope const(ubyte)[]) @safe nothrow @nogc {}) != Status.ok);

    // schema_drift: dropping a mapped column after generation fails startup validation.
    runSql(pool, "ALTER TABLE records DROP COLUMN count");
    expectSchemaFailure!Entity(pool);
}

version (FlintNativeSqlite)
{
    @("query_lexer, ownership, identity_policy and schema_drift (drop column) on SQLite")
    unittest
    {
        exerciseLexerAndOwnership(Driver.sqlite, ":memory:");
    }
}

version (FlintNativeLibpq)
{
    @("query_lexer, ownership, identity_policy and schema_drift (drop column) on PostgreSQL")
    unittest
    {
        const address = environment.get("FLINT_DATA_PG_TEST_DSN");
        if (address.length != 0)
            exerciseLexerAndOwnership(Driver.postgres, address);
    }
}
