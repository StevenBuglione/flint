module probe;

import core.stdc.stdio : printf;
import core.time : MonoTime;
import flint.arena : RequestArena, Status;
import flint.conc : Context;
import flint.engine.sql : Driver, Pool, PoolOptions;

@safe:

/// One generated create/find/update/delete cycle for each payload.
enum rows = 128;

/// Check an invariant in debug and release.
void require(bool condition) nothrow @nogc
{
    if (!condition)
        assert(0, "data benchmark invariant failed");
}

/// An implementation or direct SQL control of the same SQL workload.
alias Workload = ulong function(ref Pool pool, ref Context context) @safe;

private ulong replay(Driver driver, string address, Workload workload, out long elapsed)
{
    PoolOptions settings;
    settings.driver = driver;
    settings.connectionString = address;
    settings.maxConnections = 1;
    Pool pool;
    require(pool.open(settings).code == Status.ok);
    Context context;
    scope (exit)
        require(pool.close(context).code == Status.ok);

    {
        auto initialized = pool.acquire(context);
        require(initialized.ok());
        scope (exit)
            require(pool.release(initialized.value).code == Status.ok);
        scope RequestArena arena;
        const id = driver == Driver.sqlite
            ? "INTEGER PRIMARY KEY" : "BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY";
        const sql = "CREATE TEMP TABLE probe_rows(id " ~ id ~ ", payload BIGINT NOT NULL, revision BIGINT NOT NULL)";
        require(initialized.value.execute(sql, [], arena, context).ok());
    }
    const started = MonoTime.currTime;
    const total = workload(pool, context);
    elapsed = (MonoTime.currTime - started).total!"nsecs";
    require(total == rows * (rows + 1) / 2 + rows * 2);
    return total;
}

// SAFETY: These C format strings are fixed terminated literals with matching scalar arguments.
private void print(ulong total, bool measure, uint samples, long elapsed) @trusted nothrow @nogc
{
    printf("data checksum %llu\n", total);
    if (measure)
        printf("data rows_per_trial=%u trials=%u elapsed_ns=%lld\n", rows, samples, elapsed);
}

private struct Timing
{
    long elapsed;
}

/// Run the repository workload for SQLite or a supplied loopback PostgreSQL DSN.
void benchmark(string[] args, Workload workload)
{
    const measure = args.length > 1 && args[1] == "--measure";
    const next = measure ? 2 : 1;
    const driver = args.length > next ? Driver.postgres : Driver.sqlite;
    const address = driver == Driver.postgres ? args[next] : ":memory:";
    ulong checksum;
    uint samples;
    long elapsed;
    do
    {
        Timing timing;
        checksum = replay(driver, address, workload, timing.elapsed);
        elapsed += timing.elapsed;
        ++samples;
    }
    while (measure && elapsed < 100_000_000);
    print(checksum, measure, samples, elapsed);
}
