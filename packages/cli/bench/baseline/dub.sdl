name "probe-cli-baseline"
targetType "executable"
sourcePaths "source" "../harness"
importPaths "source" "../harness"
targetPath "build"
targetName "probe-cli-baseline"
dflags "-preview=dip1000"
dependency "flint:arena" path="../../../.."
dependency "flint:validate" path="../../../.."

configuration "fixture" {
    targetType "executable"
}

configuration "scale" {
    targetType "executable"
    versions "FlintCliScale"
}
