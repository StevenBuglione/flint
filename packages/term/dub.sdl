name "term"
description "Flint term subpackage"
license "Apache-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
preBuildCommands "sh native/build.sh" platform="linux"
sourceFiles "build/terminal-linux.o" platform="linux"
extraDependencyFiles "native/linux.c" "native/build.sh" platform="linux"
dependency "flint:arena" version="*"

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
    excludedSourceFiles "tests/betterc.d"
}
