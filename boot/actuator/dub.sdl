name "boot-actuator"
description "Flint Boot actuator: health, readiness and Prometheus metrics endpoints, and OTLP export"
license "Apache-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "flint:arena" version="*"
dependency "flint:conc" version="*"
dependency "flint:engine-di" version="*"
dependency "flint:config" version="*"
dependency "flint:engine-web" version="*"
dependency "flint:engine-actuator" version="*"

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}
