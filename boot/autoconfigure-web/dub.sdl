name "boot-autoconfigure-web"
description "Flint Boot auto-configuration for flint:web: the server from [server], controllers, SPA serving and OpenAPI"
license "Apache-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "flint:arena" version="*"
dependency "flint:di" version="*"
dependency "flint:config" version="*"
dependency "flint:web" version="*"
dependency "flint:term" version="*"
dependency "flint:boot" version="*"

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}
