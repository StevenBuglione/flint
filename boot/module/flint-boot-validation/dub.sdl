name "boot-validation"
description "Flint Boot validation (spring-boot v4.2.0 module/spring-boot-validation): the default Validator and its auto-configuration"
license "Apache-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "flint:boot-core" version="*"
dependency "flint:boot-autoconfigure" version="*"
dependency "flint:context" version="*"
dependency "flint:jakarta-validation" version="*"
dependency "flint:java" version="*"
dependency "flint:engine-aot" version="*"

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
    dependency "flint:hibernate-validator" version="*"
}
