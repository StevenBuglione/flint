name "boot-webmvc"
description "Flint Boot MVC (spring-boot v4.2.0 module/spring-boot-webmvc): WebMvcProperties, then the MVC and error auto-configurations"
license "Apache-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "boot" path="../../core/flint-boot"
dependency "flint:java" path="../../.."
dependency "flint:engine-aot" path="../../.."

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}
