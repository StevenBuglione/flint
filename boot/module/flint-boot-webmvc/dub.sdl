name "boot-webmvc"
description "Flint Boot MVC (spring-boot v4.2.0 module/spring-boot-webmvc): WebMvcProperties, then the MVC and error auto-configurations"
license "Apache-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "flint:boot-core" version="*"
dependency "flint:boot-autoconfigure" version="*"
dependency "flint:boot-web-server" version="*"
dependency "flint:boot-actuate" version="*"
dependency "flint:beans" version="*"
dependency "flint:context" version="*"
dependency "flint:core" version="*"
dependency "flint:jackson-databind" version="*"
dependency "flint:jakarta-servlet" version="*"
dependency "flint:java" version="*"
dependency "flint:web" version="*"
dependency "flint:webmvc" version="*"
dependency "flint:engine-aot" version="*"

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    dependency "flint:framework-test" version="*"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}
