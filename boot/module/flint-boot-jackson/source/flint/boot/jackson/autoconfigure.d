/// Callback interface that can be implemented by beans wishing to further customize the `JsonMapper` through
/// `JsonMapper.Builder`, to fine-tune its auto-configuration.
interface JsonMapperBuilderCustomizer
{
    /// Customize the builder.
    void customize(JsonMapper.Builder builder);
}

/// Auto-configuration for Jackson: a prototype `JsonMapper.Builder` and the primary `JsonMapper`.
@AutoConfiguration
@ConditionalOnClass(null, ["flint.jackson.databind.JsonMapper"])
@EnableConfigurationProperties([ClassRef(typeNameOf!JacksonProperties)])
final class JacksonAutoConfiguration
{
    /// A new builder for each injection point, over the context's Flint AOT descriptors (Jackson's reflection),
    /// customised in order by every `JsonMapperBuilderCustomizer`.
    @Bean
    @Scope("prototype")
    @ConditionalOnMissingBean
    JsonMapper.Builder jsonMapperBuilder(JsonMapperBuilderCustomizer[] customizers, ApplicationContext context = null)
    {
        import flint.context.support : GenericApplicationContext;

        auto builder = JsonMapper.builder();
        if (auto generic = cast(GenericApplicationContext) context)
            builder.descriptors(generic.getDescriptorTable());
        foreach (customizer; customizers)
            customizer.customize(builder);
        return builder;
    }

    /// The application's `JsonMapper`.
    @Bean
    @Primary
    @ConditionalOnMissingBean
    JsonMapper jacksonJsonMapper(JsonMapper.Builder builder)
    {
        return builder.build();
    }

    /// The customizer that applies `flint.jackson.*`.
    @Bean
    StandardJsonMapperBuilderCustomizer standardJsonMapperBuilderCustomizer(JacksonProperties jacksonProperties)
    {
        return new StandardJsonMapperBuilderCustomizer(jacksonProperties);
    }
}

/// Applies `JacksonProperties` to a `JsonMapper.Builder`, as Boot's `StandardJsonMapperBuilderCustomizer` does:
/// feature maps, the default property inclusion, the property naming strategy (a `PropertyNamingStrategies`
/// constant name), the constructor detector and Jackson 2 defaults. The time zone, locale, date format and
/// leniency wait on `flint.java.time` and the builder methods that use it.
final class StandardJsonMapperBuilderCustomizer : JsonMapperBuilderCustomizer
{
    private JacksonProperties properties;

    /// A customizer for `properties`.
    this(JacksonProperties properties) pure nothrow @nogc
    {
        this.properties = properties;
    }

    /// Boot's order: 0.
    int getOrder() const pure nothrow @nogc
    {
        return 0;
    }

    /// Apply the properties.
    void customize(JsonMapper.Builder builder)
    {
        import flint.jackson.databind.cfg : DateTimeFeature, DeserializationFeature, MapperFeature;

        if (properties.isUseJackson2Defaults())
        {
            builder.disable(DateTimeFeature.WRITE_DATES_AS_TIMESTAMPS, DateTimeFeature.WRITE_DURATIONS_AS_TIMESTAMPS);
            builder.disable(DeserializationFeature.FAIL_ON_UNKNOWN_PROPERTIES);
            builder.disable(MapperFeature.DEFAULT_VIEW_INCLUSION);
        }
        if (properties.isFindAndAddModules())
            builder.findAndAddModules();
        if (properties.getDefaultPropertyInclusion().isPresent())
        {
            const inclusion = properties.getDefaultPropertyInclusion().get();
            builder.changeDefaultPropertyInclusion(inclusion, inclusion);
        }
        configureFeatures!DeserializationFeature(builder, properties.getDeserialization());
        configureFeatures!SerializationFeature(builder, properties.getSerialization());
        configureFeatures!MapperFeature(builder, properties.getMapper());
        configureFeatures!DateTimeFeature(builder, properties.getDatatype().getDatetime());
        configureFeatures!EnumFeature(builder, properties.getDatatype().getEnum());
        configureFeatures!StreamReadFeature(builder, properties.getRead());
        configureFeatures!StreamWriteFeature(builder, properties.getWrite());
        configureFeatures!JsonReadFeature(builder, properties.getJson().getRead());
        configureFeatures!JsonWriteFeature(builder, properties.getJson().getWrite());
        if (properties.getPropertyNamingStrategy() !is null)
            builder.propertyNamingStrategy(namingStrategy(properties.getPropertyNamingStrategy()));
        configureConstructorDetector(builder);
    }

    // The feature maps are keyed by the name as bound; Boot's binder would have converted it to the enum.
    private static void configureFeatures(F)(JsonMapper.Builder builder, Map!(string, bool) features)
    {
        features.forEach((string name, bool state) {
            builder.configure(featureNamed!F(name), state);
        });
    }

    private void configureConstructorDetector(JsonMapper.Builder builder)
    {
        final switch (properties.getConstructorDetector())
        {
        case JacksonProperties.ConstructorDetectorStrategy.DEFAULT:
            return;
        case JacksonProperties.ConstructorDetectorStrategy.EXPLICIT_ONLY:
            builder.constructorDetector(ConstructorDetector.EXPLICIT_ONLY);
            return;
        case JacksonProperties.ConstructorDetectorStrategy.USE_PROPERTIES_BASED:
        case JacksonProperties.ConstructorDetectorStrategy.USE_DELEGATING:
            throw new IllegalStateException("flint.jackson.constructor-detector=" ~ (
                    properties.getConstructorDetector() == JacksonProperties.ConstructorDetectorStrategy.USE_DELEGATING
                    ? "use-delegating" : "use-properties-based") ~ " is not supported by flint.jackson yet");
        }
    }

    // Boot reads the strategy as a constant of PropertyNamingStrategies (by reflection in Java; by name here).
    private static PropertyNamingStrategy namingStrategy(string name)
    {
        switch (name)
        {
        case "LOWER_CAMEL_CASE":
            return PropertyNamingStrategies.LOWER_CAMEL_CASE();
        case "UPPER_CAMEL_CASE":
            return PropertyNamingStrategies.UPPER_CAMEL_CASE();
        case "SNAKE_CASE":
            return PropertyNamingStrategies.SNAKE_CASE();
        case "UPPER_SNAKE_CASE":
            return PropertyNamingStrategies.UPPER_SNAKE_CASE();
        case "LOWER_CASE":
            return PropertyNamingStrategies.LOWER_CASE();
        case "KEBAB_CASE":
            return PropertyNamingStrategies.KEBAB_CASE();
        case "LOWER_DOT_CASE":
            return PropertyNamingStrategies.LOWER_DOT_CASE();
        default:
            throw new IllegalStateException("Constant named '" ~ name ~ "' not found");
        }
    }
}

/// The constant of the feature enum `F` that `name` names, as Boot's lenient enum conversion matches it: letters and
/// digits only, ignoring case (`indent-output` and `INDENT_OUTPUT` are `INDENT_OUTPUT`).
F featureNamed(F)(string name) if (is(F == enum))
{
    import flint.java.lang : IllegalArgumentException;
    import std.ascii : isAlphaNum, toLower;

    static string canonical(string text) pure nothrow
    {
        string result;
        foreach (char ch; text)
        {
            if (ch.isAlphaNum)
                result ~= ch.toLower;
        }
        return result;
    }

    const wanted = canonical(name);
    static foreach (member; __traits(allMembers, F))
    {
        if (canonical(member) == wanted)
            return __traits(getMember, F, member);
    }
    throw new IllegalArgumentException("No enum constant " ~ F.stringof ~ "." ~ name);
}

/++
Flint addition: the auto-configured `JsonMapper` when Jackson is configured as Boot leaves it, or `null`: the one
`JsonMapper` and `JsonMapper.Builder` beans are this auto-configuration's, its `StandardJsonMapperBuilderCustomizer`
is the only customizer, no `JacksonModule` bean is registered, and no `flint.jackson.*` property is set. The
default-JSON-404 specialization (coordination note web-http-404-specialization.md) requires the converter's mapper to
be this one, then compares its bytes with the generic path's at startup.
+/
JsonMapper stockJsonMapper(ApplicationContext context)
{
    import flint.jackson.databind : JacksonModule;

    if (context.getBeanNamesForType!JsonMapper() != ["jacksonJsonMapper"]
            || context.getBeanNamesForType!(JsonMapper.Builder)() != ["jsonMapperBuilder"]
            || context.getBeanNamesForType!JacksonModule().length != 0)
        return null;
    const customizers = context.getBeanNamesForType!JsonMapperBuilderCustomizer();
    if (customizers.length != 1
            || typeid(context.getBean(customizers[0])) !is typeid(StandardJsonMapperBuilderCustomizer))
        return null;
    const properties = context.getBeanNamesForType!JacksonProperties();
    if (properties.length != 1 || !isDefault(cast(JacksonProperties) context.getBean(properties[0])))
        return null;
    return cast(JsonMapper) context.getBean("jacksonJsonMapper");
}

// Whether no `flint.jackson.*` property is set: every field as a new `JacksonProperties` has it.
private bool isDefault(JacksonProperties p)
{
    static bool empty(V)(Map!(string, V) map)
    {
        return map is null || map.isEmpty();
    }

    return p !is null && p.getDateFormat() is null && p.getPropertyNamingStrategy() is null
        && empty(p.getVisibility()) && empty(p.getSerialization()) && empty(p.getDeserialization())
        && empty(p.getMapper()) && !p.getDefaultPropertyInclusion().isPresent() && !p.getDefaultLeniency()
            .isPresent() && p.getConstructorDetector() == JacksonProperties.ConstructorDetectorStrategy.DEFAULT
        && p.getTimeZone() is null && p.getLocale() is null && !p.isUseJackson2Defaults()
        && p.isFindAndAddModules() && empty(p.getDatatype().getEnum()) && empty(p.getDatatype()
                .getDatetime()) && empty(p.getRead()) && empty(p.getWrite()) && empty(p.getJson()
                .getRead()) && empty(p.getJson().getWrite());
}
