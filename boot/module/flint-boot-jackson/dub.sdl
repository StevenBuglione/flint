name "boot-jackson"
description "Flint Boot Jackson (spring-boot v4.2.0 module/spring-boot-jackson): JacksonProperties, then JacksonAutoConfiguration"
license "Apache-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "flint:boot-core" version="*"
dependency "flint:boot-autoconfigure" version="*"
dependency "flint:context" version="*"
dependency "flint:java" version="*"
dependency "flint:engine-aot" version="*"
dependency "flint:jackson-annotations" version="*"
dependency "flint:jackson-core" version="*"
dependency "flint:jackson-databind" version="*"

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}
