name "boot-web-server"
description "Flint Boot web server support (spring-boot v4.2.0 module/spring-boot-web-server): ServerProperties, then the servlet web server application context over Flint's server"
license "Apache-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "flint:boot-core" version="*"
dependency "flint:boot-autoconfigure" version="*"
dependency "flint:beans" version="*"
dependency "flint:context" version="*"
dependency "flint:core" version="*"
dependency "flint:engine-servlet" version="*"
dependency "flint:jakarta-servlet" version="*"
dependency "flint:java" version="*"
dependency "flint:engine-aot" version="*"

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
    dependency "flint:web" version="*"
}
