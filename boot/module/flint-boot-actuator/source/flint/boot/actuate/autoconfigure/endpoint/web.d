/// Filters endpoints by id: `include` (or the defaults when it is empty) less `exclude`, `*` matching every id (Boot's
/// `IncludeExcludeEndpointFilter`).
final class IncludeExcludeEndpointFilter
{
    private string[] include;
    private string[] exclude;

    /// Over `include` and `exclude`, with `defaultIncludes` when `include` is empty (`health` for the web).
    this(string[] include, string[] exclude, string[] defaultIncludes...) pure nothrow
    {
        this.include = include.length ? include : defaultIncludes.dup;
        this.exclude = exclude;
    }

    /// Whether `id` is exposed.
    bool match(string id) const pure
    {
        return matches(include, id) && !matches(exclude, id);
    }

    private static bool matches(const string[] ids, string id) pure
    {
        import std.uni : sicmp;

        foreach (candidate; ids)
        {
            if (candidate == "*" || sicmp(candidate, id) == 0)
                return true;
        }
        return false;
    }
}
