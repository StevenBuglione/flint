name "boot-jdbc-health"
description "Flint Boot's JDBC health support (spring-boot v4.2.0 module/spring-boot-jdbc, the health and autoconfigure.health packages compiled against its optional spring-boot-health dependency): the db health indicator and its auto-configuration (deviation D-JDBC-2)"
license "Apache-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "flint:boot-core" version="*"
dependency "flint:boot-autoconfigure" version="*"
dependency "flint:boot-health" version="*"
dependency "flint:boot-jdbc" version="*"
dependency "flint:beans" version="*"
dependency "flint:context" version="*"
dependency "flint:core" version="*"
dependency "flint:jdbc" version="*"
dependency "flint:tx" version="*"
dependency "flint:java" version="*"
dependency "flint:engine-aot" version="*"

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}
