/++
Auto-configuration for `DataSourceHealthIndicator`: the `db` health contributor, over every `DataSource` bean (a
composite named by bean name when there are several), unless `management.health.db.enabled` is false.

Flint: Boot's `@ConditionalOnEnabledHealthIndicator("db")` is `management.health.db.enabled` (true when missing),
as for the `ping` indicator; `management.health.defaults.enabled` is not consulted yet. Flint has no
`AbstractRoutingDataSource` and no `DataSourcePoolMetadataProvider`s, so no data source is a routing one
(`ignore-routing-data-sources` changes nothing) and the validation query is `isValid()`, which is also what a Hikari
pool without `connection-test-query` gives in Boot. The data sources come from the `ApplicationContext` (Boot's
`SimpleAutowireCandidateResolver` over the bean factory).
+/
@afterDataSource
@ConditionalOnClass(null, [
    "flint.jdbc.core.JdbcTemplate", "flint.boot.health.contributor.HealthContributor"
])
@ConditionalOnBean([ClassRef("flint.javax.sql.DataSource")])
@dbEnabled
@EnableConfigurationProperties([ClassRef(typeNameOf!DataSourceHealthIndicatorProperties)])
final class DataSourceHealthContributorAutoConfiguration
{
    /// The `db` contributor: one indicator, or a composite of one per `DataSource` bean.
    @Bean
    @missingDbContributor
    HealthContributor dbHealthContributor(ApplicationContext context,
            DataSourceHealthIndicatorProperties dataSourceHealthIndicatorProperties)
    {
        Map!(string, DataSource) dataSources = new LinkedHashMap!(string, DataSource);
        foreach (name; context.getBeanNamesForType!DataSource())
            dataSources.put(name, cast(DataSource) context.getBean(name));
        // dataSourceHealthIndicatorProperties.isIgnoreRoutingDataSources() filters routing data sources, which
        // Flint does not have.
        return createContributor(dataSources);
    }

    private HealthContributor createContributor(Map!(string, DataSource) beans)
    {
        import flint.util : Assert;

        Assert.notEmpty(beans, "'beans' must not be empty");
        if (beans.size() == 1)
            return createContributor(beans.values().iterator().next());
        return CompositeHealthContributor.fromMap(beans, (DataSource source) => createContributor(source));
    }

    private HealthContributor createContributor(DataSource source)
    {
        return new DataSourceHealthIndicator(source, getValidationQuery(source));
    }

    // Boot asks the pool's metadata (Hikari's connection-test-query); Flint's pool has none.
    private string getValidationQuery(DataSource source) pure nothrow @nogc
    {
        return null;
    }
}

// `@AutoConfiguration(after = DataSourceAutoConfiguration.class)`, as a constant (dfmt 0.15 cannot parse named UDA
// arguments).
private enum AutoConfiguration afterDataSource = () {
    AutoConfiguration configuration;
    configuration.afterName = ["flint.boot.jdbc.autoconfigure.DataSourceAutoConfiguration"];
    return configuration;
}();

// `@ConditionalOnEnabledHealthIndicator("db")`.
private enum ConditionalOnBooleanProperty dbEnabled = () {
    ConditionalOnBooleanProperty condition;
    condition.name = ["management.health.db.enabled"];
    condition.matchIfMissing = true;
    return condition;
}();

// `@ConditionalOnMissingBean(name = { "dbHealthIndicator", "dbHealthContributor" })`.
private enum ConditionalOnMissingBean missingDbContributor = () {
    ConditionalOnMissingBean condition;
    condition.name = ["dbHealthIndicator", "dbHealthContributor"];
    return condition;
}();
