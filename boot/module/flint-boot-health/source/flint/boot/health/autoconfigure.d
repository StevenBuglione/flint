/// Settings of the health endpoint. Bound under `management.endpoint.health`.
@ConfigurationProperties("management.endpoint.health")
final class HealthEndpointProperties
{
    /// When to show components or details.
    enum Show
    {
        /// Never show details in the health endpoint.
        NEVER,
        /// Show details in the health endpoint to authorized users.
        WHEN_AUTHORIZED,
        /// Always show details in the health endpoint.
        ALWAYS
    }

    /// Health status settings.
    static final class Status
    {
        private string[] order;
        private Map!(string, int) httpMapping;

        /// Boot's defaults.
        this() pure nothrow
        {
            httpMapping = new LinkedHashMap!(string, int);
        }

        /// List of health statuses in order of severity.
        string[] getOrder() pure nothrow @nogc
        {
            return order;
        }

        /// Set `order`.
        void setOrder(string[] order) pure nothrow @nogc
        {
            this.order = order;
        }

        /// Mapping of health statuses to HTTP status codes. By default, registered health statuses map to sensible
        /// defaults (for example, UP maps to 200).
        Map!(string, int) getHttpMapping() pure nothrow @nogc
        {
            return httpMapping;
        }
    }

    private Optional!Show showComponents;
    private Show showDetails = Show.NEVER;
    private string[] roles;
    private Status status;

    /// Boot's defaults.
    this() pure nothrow
    {
        status = new Status;
    }

    /// When to show components. If not specified the 'show-details' setting will be used.
    Optional!Show getShowComponents() const pure nothrow @nogc
    {
        return showComponents;
    }

    /// Set `showComponents`.
    void setShowComponents(Optional!Show showComponents) pure nothrow @nogc
    {
        this.showComponents = showComponents;
    }

    /// When to show full health details.
    Show getShowDetails() const pure nothrow @nogc
    {
        return showDetails;
    }

    /// Set `showDetails`.
    void setShowDetails(Show showDetails) pure nothrow @nogc
    {
        this.showDetails = showDetails;
    }

    /// Roles used to determine whether a user is authorized to be shown details. When empty, all authenticated users
    /// are authorized.
    string[] getRoles() pure nothrow @nogc
    {
        return roles;
    }

    /// Set `roles`.
    void setRoles(string[] roles) pure nothrow @nogc
    {
        this.roles = roles;
    }

    /// Health status settings (`status.*`).
    Status getStatus() pure nothrow @nogc
    {
        return status;
    }
}

