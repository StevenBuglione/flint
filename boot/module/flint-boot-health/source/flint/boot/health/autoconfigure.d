/// A health contributor's name from its bean name: without `HealthIndicator` or `HealthContributor` (Boot's
/// `HealthContributorNameGenerator.withoutStandardSuffixes`).
string healthContributorName(string beanName) pure
{
    import std.uni : sicmp;

    foreach (suffix; ["healthindicator", "healthcontributor"])
    {
        if (beanName.length > suffix.length && sicmp(beanName[$ - suffix.length .. $], suffix) == 0)
            return beanName[0 .. $ - suffix.length];
    }
    return beanName;
}

/// A group configured from properties: members by include/exclude (`*` for all, a name covers its descendants),
/// with its visibility, aggregator and status mapper.
class AutoConfiguredHealthEndpointGroup : HealthEndpointGroup
{
    private string[] include;
    private string[] exclude;
    private StatusAggregator statusAggregator;
    private HttpCodeStatusMapper httpCodeStatusMapper;
    private bool hasShowComponents;
    private HealthEndpointProperties.Show showComponentsValue;
    private HealthEndpointProperties.Show showDetailsValue;

    /// The group.
    this(string[] include, string[] exclude, StatusAggregator aggregator, HttpCodeStatusMapper mapper,
            bool hasShowComponents, HealthEndpointProperties.Show showComponents,
            HealthEndpointProperties.Show showDetails) pure nothrow
    {
        this.include = include;
        this.exclude = exclude;
        this.statusAggregator = aggregator;
        this.httpCodeStatusMapper = mapper;
        this.hasShowComponents = hasShowComponents;
        this.showComponentsValue = showComponents;
        this.showDetailsValue = showDetails;
    }

    /// Whether `name` is included and not excluded.
    bool isMember(string name)
    {
        return covers(include, name) && !covers(exclude, name);
    }

    /// `show-components`, else `show-details`.
    bool showComponents(const SecurityContext securityContext)
    {
        return hasShowComponents ? shown(showComponentsValue, securityContext) : showDetails(securityContext);
    }

    /// `show-details`.
    bool showDetails(const SecurityContext securityContext)
    {
        return shown(showDetailsValue, securityContext);
    }

    /// The group's aggregator.
    StatusAggregator getStatusAggregator()
    {
        return statusAggregator;
    }

    /// The group's status mapper.
    HttpCodeStatusMapper getHttpCodeStatusMapper()
    {
        return httpCodeStatusMapper;
    }

    // Boot's Show.isShown: WHEN_AUTHORIZED needs a principal, which Flint's SecurityContext.NONE never has.
    private static bool shown(HealthEndpointProperties.Show show, const SecurityContext securityContext)
    {
        final switch (show)
        {
        case HealthEndpointProperties.Show.NEVER:
            return false;
        case HealthEndpointProperties.Show.ALWAYS:
            return true;
        case HealthEndpointProperties.Show.WHEN_AUTHORIZED:
            return false;
        }
    }

    private static bool covers(const string[] names, string name) pure
    {
        import std.algorithm.searching : startsWith;

        foreach (candidate; names)
        {
            if (candidate == "*" || candidate == name || name.startsWith(candidate ~ "/"))
                return true;
        }
        return false;
    }
}

/// The primary group (every contributor) and the named groups, with the availability probes' `liveness` and
/// `readiness` groups when probes are enabled (Boot's `AutoConfiguredHealthEndpointGroups` with
/// `AvailabilityProbesHealthEndpointGroups`).
class AutoConfiguredHealthEndpointGroups : HealthEndpointGroups
{
    private HealthEndpointGroup primary;
    private string[] names;
    private HealthEndpointGroup[string] groups;

    /// The groups `properties` describe; `probes` adds the probe groups.
    this(HealthEndpointProperties properties, bool probes)
    {
        auto aggregator = properties.getStatus().getOrder().length
            ? new SimpleStatusAggregator(properties.getStatus().getOrder()) : new SimpleStatusAggregator;
        auto mapper = mapperOf(properties);
        const hasShowComponents = properties.getShowComponents().isPresent();
        const showComponents = hasShowComponents ? properties.getShowComponents()
            .get() : HealthEndpointProperties.Show.NEVER;
        primary = new AutoConfiguredHealthEndpointGroup(["*"], null, aggregator, mapper,
                hasShowComponents, showComponents, properties.getShowDetails());
        if (probes)
        {
            add("liveness", probeGroup("livenessState"));
            add("readiness", probeGroup("readinessState"));
        }
    }

    /// Every contributor.
    HealthEndpointGroup getPrimary()
    {
        return primary;
    }

    /// The group names.
    string[] getNames()
    {
        return names.dup;
    }

    /// The group named `name`, or `null`.
    HealthEndpointGroup get(string name)
    {
        if (auto group = name in groups)
            return *group;
        return null;
    }

    private void add(string name, HealthEndpointGroup group)
    {
        if (name !in groups)
            names ~= name;
        groups[name] = group;
    }

    // Boot's AvailabilityProbesHealthEndpointGroup: one member, status only, default aggregation and codes.
    private static HealthEndpointGroup probeGroup(string member)
    {
        return new AutoConfiguredHealthEndpointGroup([member], null, new SimpleStatusAggregator,
                new SimpleHttpCodeStatusMapper,
                false, HealthEndpointProperties.Show.NEVER, HealthEndpointProperties.Show.NEVER);
    }

    private static HttpCodeStatusMapper mapperOf(HealthEndpointProperties properties)
    {
        auto mapping = properties.getStatus().getHttpMapping();
        if (mapping.isEmpty())
            return new SimpleHttpCodeStatusMapper;
        int[string] codes = [
            "DOWN": WebEndpointResponse.STATUS_SERVICE_UNAVAILABLE,
            "OUT_OF_SERVICE": WebEndpointResponse.STATUS_SERVICE_UNAVAILABLE
        ];
        foreach (code; mapping.keySet().toArray())
            codes[code] = mapping.get(code);
        return new SimpleHttpCodeStatusMapper(codes);
    }
}

/// The health endpoint over HTTP: `health` (the system) and `health-path` (a group or a contributor), producing
/// the actuator's v3, v2 and plain JSON media types.
final class HealthWebEndpoint : ExposableWebEndpoint
{
    private HealthEndpointWebExtension extension;
    private WebOperation[] operations;

    /// Over `extension`.
    this(HealthEndpointWebExtension extension)
    {
        this.extension = extension;
        operations = [
            cast(WebOperation) new Operation("health", "health"),
            new Operation("health-path", "health/{*path}")
        ];
    }

    /// `health`.
    EndpointId getEndpointId()
    {
        return HealthEndpoint.ID;
    }

    /// `health`.
    string getRootPath()
    {
        return "health";
    }

    /// The two read operations.
    WebOperation[] getOperations()
    {
        return operations.dup;
    }

    private final class Operation : WebOperation
    {
        private string id;
        private WebOperationRequestPredicate predicate;

        this(string id, string path)
        {
            this.id = id;
            predicate = new WebOperationRequestPredicate(path, WebEndpointHttpMethod.GET, null,
                    [
                        getProducedMimeType(ApiVersion.V3), getProducedMimeType(ApiVersion.V2),
                        "application/json"
            ]);
        }

        string getId()
        {
            return id;
        }

        WebOperationRequestPredicate getRequestPredicate()
        {
            return predicate;
        }

        WebEndpointResponse invoke(string[] selectors)
        {
            return extension.health(ApiVersion.V3, SecurityContext.NONE, false, selectors);
        }
    }
}

/// Auto-configuration of the health endpoint: the contributor registry over every `HealthContributor` bean, the
/// groups, the endpoint, its web extension and its web exposure.
@AutoConfiguration @EnableConfigurationProperties([ClassRef(typeNameOf!HealthEndpointProperties)])
final class HealthEndpointAutoConfiguration
{
    /// The groups, with the probe groups unless `management.endpoint.health.probes.enabled` is false.
    @Bean @ConditionalOnMissingBean([
        ClassRef("flint.boot.health.actuate.endpoint.HealthEndpointGroups")
    ])
    AutoConfiguredHealthEndpointGroups healthEndpointGroups(HealthEndpointProperties properties, Environment env)
    {
        import std.uni : sicmp;

        const probes = env.getProperty("management.endpoint.health.probes.enabled", "true");
        return new AutoConfiguredHealthEndpointGroups(properties, sicmp(probes, "false") != 0);
    }

    /// Every `HealthContributor` bean, named by its bean name without the standard suffix.
    @Bean @ConditionalOnMissingBean([
        ClassRef("flint.boot.health.registry.HealthContributorRegistry")
    ])
    DefaultHealthContributorRegistry healthContributorRegistry(ApplicationContext context)
    {
        auto registry = new DefaultHealthContributorRegistry;
        import std.algorithm.searching : canFind;

        // The registry is a composite here (Boot 4's is not a contributor), so registries are left out.
        const registries = context.getBeanNamesForType!HealthContributorRegistry();
        foreach (name; context.getBeanNamesForType!HealthContributor())
        {
            if (registries.canFind(name))
                continue;
            auto contributor = cast(HealthContributor) context.getBean(name);
            registry.registerContributor(healthContributorName(name), contributor);
        }
        return registry;
    }

    /// The endpoint.
    @Bean @ConditionalOnMissingBean HealthEndpoint healthEndpoint(HealthContributorRegistry registry,
            HealthEndpointGroups groups)
    {
        return new HealthEndpoint(registry, groups);
    }

    /// The web extension.
    @Bean @ConditionalOnMissingBean HealthEndpointWebExtension healthEndpointWebExtension(
            HealthContributorRegistry registry, HealthEndpointGroups groups)
    {
        return new HealthEndpointWebExtension(registry, groups);
    }

    /// The endpoint's web exposure; registers the descriptors Jackson writes the responses with.
    @Bean HealthWebEndpoint healthWebEndpoint(HealthEndpointWebExtension extension, ApplicationContext context)
    {
        import flint.boot.health.actuate.endpoint : CompositeHealthDescriptor, HealthDescriptor,
            IndicatedHealthDescriptor, SystemHealthDescriptor;
        import flint.context.support : GenericApplicationContext;
        import flint.engine.aot.any : Any;
        import flint.engine.aot.descriptor : descriptorOf;
        import flint.java.util : LinkedHashMap;

        if (auto generic = cast(GenericApplicationContext) context)
        {
            auto descriptors = generic.getDescriptorTable();
            descriptors.add(descriptorOf!SystemHealthDescriptor());
            descriptors.add(descriptorOf!CompositeHealthDescriptor());
            descriptors.add(descriptorOf!IndicatedHealthDescriptor());
            descriptors.add(descriptorOf!(LinkedHashMap!(string, HealthDescriptor))());
            descriptors.add(descriptorOf!(LinkedHashMap!(string, Any))());
            descriptors.add(descriptorOf!(string[])());
        }
        return new HealthWebEndpoint(extension);
    }
}

/// Auto-configuration of the availability probes: `livenessState` and `readinessState` indicators, unless
/// `management.endpoint.health.probes.enabled` is false.
@AutoConfiguration @probesEnabled final class AvailabilityProbesAutoConfiguration
{
    /// The liveness indicator.
    @Bean @missingLiveness LivenessStateHealthIndicator livenessStateHealthIndicator(
            ApplicationAvailability applicationAvailability)
    {
        return new LivenessStateHealthIndicator(applicationAvailability);
    }

    /// The readiness indicator.
    @Bean @missingReadiness ReadinessStateHealthIndicator readinessStateHealthIndicator(
            ApplicationAvailability applicationAvailability)
    {
        return new ReadinessStateHealthIndicator(applicationAvailability);
    }
}

/// Auto-configuration of the `ping` indicator, unless `management.health.ping.enabled` is false.
@AutoConfiguration @pingEnabled final class PingHealthContributorAutoConfiguration
{
    /// Always `UP`.
    @Bean @missingPing PingHealthIndicator pingHealthContributor()
    {
        return new PingHealthIndicator;
    }
}

