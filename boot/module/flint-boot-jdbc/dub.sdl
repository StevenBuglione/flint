name "boot-jdbc"
description "Flint Boot JDBC (spring-boot v4.2.0 module/spring-boot-jdbc): the DataSource and JdbcTemplate properties, then their auto-configurations"
license "Apache-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "flint:boot-core" version="*"
dependency "flint:boot-autoconfigure" version="*"
dependency "flint:beans" version="*"
dependency "flint:context" version="*"
dependency "flint:jdbc" version="*"
dependency "flint:engine-jdbc" version="*"
dependency "flint:tx" version="*"
dependency "flint:java" version="*"
dependency "flint:engine-aot" version="*"

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}
