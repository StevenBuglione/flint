/// The JDBC URL of an embedded database named `databaseName`, or `null` for `NONE` and the JVM-only engines.
string getUrl(EmbeddedDatabaseConnection connection, string databaseName) pure
{
    if (connection != EmbeddedDatabaseConnection.SQLITE || databaseName is null)
        return null;
    return "jdbc:sqlite:file:" ~ databaseName ~ "?mode=memory&cache=shared";
}

/// The driver class of an embedded database, or `null` for `NONE` (Boot's `EmbeddedDatabaseConnection.getDriverClassName`).
string getDriverClassName(EmbeddedDatabaseConnection connection) pure nothrow @nogc
{
    final switch (connection)
    {
    case EmbeddedDatabaseConnection.NONE:
        return null;
    case EmbeddedDatabaseConnection.H2:
        return DatabaseDriver.H2.getDriverClassName();
    case EmbeddedDatabaseConnection.DERBY:
        return DatabaseDriver.DERBY.getDriverClassName();
    case EmbeddedDatabaseConnection.HSQLDB:
        return DatabaseDriver.HSQLDB.getDriverClassName();
    case EmbeddedDatabaseConnection.SQLITE:
        return DatabaseDriver.SQLITE.getDriverClassName();
    }
}

/// The driver class: `driver-class-name`, else the one the URL names, else the embedded database's (Boot's
/// `DataSourceProperties.determineDriverClassName`). Throws `DataSourceBeanCreationException` when there is none, and
/// `IllegalStateException` when an explicit `driver-class-name` cannot be loaded.
string determineDriverClassName(DataSourceProperties properties)
{
    const driverClassName = findDriverClassName(properties);
    if (driverClassName.length == 0)
        throw new DataSourceBeanCreationException("Failed to determine a suitable driver class",
                properties, properties.getEmbeddedDatabaseConnection());
    return driverClassName;
}

// Boot's findDriverClassName.
package string findDriverClassName(DataSourceProperties properties)
{
    import flint.java.lang : IllegalStateException;

    if (properties.getDriverClassName().length)
    {
        if (!driverClassIsLoadable(properties.getDriverClassName()))
            throw new IllegalStateException("Cannot load driver class: " ~ properties.getDriverClassName());
        return properties.getDriverClassName();
    }
    string driverClassName;
    if (properties.getUrl().length)
        driverClassName = DatabaseDriver.fromJdbcUrl(properties.getUrl()).getDriverClassName();
    if (driverClassName.length == 0)
        driverClassName = properties.getEmbeddedDatabaseConnection().getDriverClassName();
    return driverClassName;
}

// Java's `ClassUtils.forName(driverClassName)` for a driver: the class is present when the program registered a
// driver of that class with the DriverManager (a driver package registers its driver when it is linked).
private bool driverClassIsLoadable(string driverClassName)
{
    import flint.java.sql : DriverManager;

    foreach (driver; DriverManager.getDrivers())
        if (typeid(cast(Object) driver).name == driverClassName)
            return true;
    return false;
}

// Hikari's `setDriverClassName`, which fails when the class does not load, for Flint's pool, which finds its driver
// by URL: the data source fails at creation, at startup, unless the driver class is registered or a registered driver
// accepts the URL. The message names the package providing the driver.
private void requireDriver(DataSourceProperties properties, string driverClassName, string url)
{
    import flint.java.sql : DriverManager, SQLException;

    if (driverClassIsLoadable(driverClassName))
        return;
    try
    {
        DriverManager.getDriver(url);
        return;
    }
    catch (SQLException)
    {
    }
    string message = "Cannot load driver class: " ~ driverClassName;
    foreach (driver; DatabaseDriver.values())
        if (driver.getDriverClassName() == driverClassName && driver.flintDependency().length)
            message ~= " (add the " ~ driver.flintDependency() ~ " dependency)";
    throw new DataSourceBeanCreationException(message, properties, properties.getEmbeddedDatabaseConnection());
}

/// The database name: a unique one when `generate-unique-name` holds, else `name`, else `testdb` for an embedded
/// database, else `null` (Boot's `DataSourceProperties.determineDatabaseName`).
string determineDatabaseName(DataSourceProperties properties)
{
    if (properties.isGenerateUniqueName())
        return uniqueName(properties);
    if (properties.getName().length)
        return properties.getName();
    if (properties.getEmbeddedDatabaseConnection() != EmbeddedDatabaseConnection.NONE)
        return "testdb";
    return null;
}

/// The JDBC URL: `url`, else the embedded database's (Boot's `DataSourceProperties.determineUrl`). Throws
/// `DataSourceBeanCreationException` when neither is available.
string determineUrl(DataSourceProperties properties)
{
    if (properties.getUrl().length)
        return properties.getUrl();
    const url = properties.getEmbeddedDatabaseConnection().getUrl(determineDatabaseName(properties));
    if (url.length == 0)
        throw new DataSourceBeanCreationException("Failed to determine suitable jdbc url",
                properties, properties.getEmbeddedDatabaseConnection());
    return url;
}

/// Thrown when the `DataSource` cannot be configured from `flint.datasource.*` (Boot's
/// `DataSourceProperties.DataSourceBeanCreationException`).
final class DataSourceBeanCreationException : BeanCreationException
{
    private DataSourceProperties properties;
    private EmbeddedDatabaseConnection connection;

    /// `message`, about `properties` and the embedded `connection` they name.
    this(string message, DataSourceProperties properties, EmbeddedDatabaseConnection connection)
    {
        super(message);
        this.properties = properties;
        this.connection = connection;
    }

    /// The properties that failed.
    DataSourceProperties getProperties() pure nothrow @nogc
    {
        return properties;
    }

    /// The embedded connection they name.
    EmbeddedDatabaseConnection getConnection() const pure nothrow @nogc
    {
        return connection;
    }
}

/// The login username: `username`, else `sa` for an embedded database (Boot's `determineUsername`).
string determineUsername(DataSourceProperties properties)
{
    if (properties.getUsername().length)
        return properties.getUsername();
    return isEmbeddedUrl(determineUrl(properties)) ? "sa" : null;
}

/// The login password: `password`, else empty for an embedded database (Boot's `determinePassword`).
string determinePassword(DataSourceProperties properties)
{
    if (properties.getPassword().length)
        return properties.getPassword();
    return isEmbeddedUrl(determineUrl(properties)) ? "" : null;
}

// Boot's uniqueName: one random name per DataSourceProperties instance.
private string uniqueName(DataSourceProperties properties)
{
    import std.uuid : randomUUID;

    if (properties.uniqueName is null)
        properties.uniqueName = randomUUID().toString();
    return properties.uniqueName;
}

/// Auto-configuration of the `DataSource`: Flint's pooled `FlintDataSource` (Boot's `HikariDataSource`), configured
/// from `flint.datasource.*` and bound with `flint.datasource.hikari.*` (Hikari's property names), unless the
/// application defines a `DataSource`.
@AutoConfiguration
@ConditionalOnClass(null, ["flint.javax.sql.DataSource", "flint.engine.jdbc.FlintDataSource"])
@EnableConfigurationProperties([ClassRef(typeNameOf!DataSourceProperties)])
final class DataSourceAutoConfiguration
{
    /// The pooled data source.
    @Bean
    @ConditionalOnMissingBean([ClassRef("flint.javax.sql.DataSource")])
    @ConfigurationProperties("flint.datasource.hikari")
    FlintDataSource dataSource(DataSourceProperties properties)
    {
        const url = properties.determineUrl();
        requireDriver(properties, properties.determineDriverClassName(), url);
        auto dataSource = new FlintDataSource();
        dataSource.setJdbcUrl(url);
        if (auto username = properties.determineUsername())
            dataSource.setUsername(username);
        if (auto password = properties.determinePassword())
            dataSource.setPassword(password);
        if (properties.getName().length)
            dataSource.setPoolName(properties.getName());
        return dataSource;
    }
}

/// Auto-configuration of a `JdbcTransactionManager` for the single `DataSource`, unless the application defines a
/// `TransactionManager`; the `TransactionManagerCustomizers` (`flint.transaction.*`, execution listeners) apply to it.
@transactionManagerOrder
@ConditionalOnClass(null, [
    "flint.jdbc.support.JdbcTransactionManager", "flint.transaction.TransactionManager"
])
final class DataSourceTransactionManagerAutoConfiguration
{
    /// The transaction manager.
    @Bean
    @ConditionalOnMissingBean([ClassRef("flint.transaction.TransactionManager")])
    @ConditionalOnSingleCandidate(ClassRef("flint.javax.sql.DataSource"))
    JdbcTransactionManager transactionManager(DataSource dataSource,
            TransactionManagerCustomizers[] transactionManagerCustomizers = null)
    {
        auto transactionManager = new JdbcTransactionManager(dataSource);
        foreach (customizers; transactionManagerCustomizers)
            customizers.customize(transactionManager);
        return transactionManager;
    }
}

// `@AutoConfiguration(after = DataSourceAutoConfiguration.class)`, as a constant (dfmt 0.15 cannot parse named UDA
// arguments).
// `@AutoConfiguration(before = TransactionAutoConfiguration.class, after = { DataSourceAutoConfiguration.class,
// TransactionManagerCustomizationAutoConfiguration.class })`.
private enum AutoConfiguration transactionManagerOrder = () {
    AutoConfiguration configuration;
    configuration.beforeName = ["flint.boot.transaction.autoconfigure.TransactionAutoConfiguration"];
    configuration.afterName = [
        "flint.boot.jdbc.autoconfigure.DataSourceAutoConfiguration",
        "flint.boot.transaction.autoconfigure.TransactionManagerCustomizationAutoConfiguration"
    ];
    return configuration;
}();

private enum AutoConfiguration afterDataSource = () {
    AutoConfiguration configuration;
    configuration.afterName = ["flint.boot.jdbc.autoconfigure.DataSourceAutoConfiguration"];
    return configuration;
}();

/// Auto-configuration of a `JdbcTemplate` over the single `DataSource`, configured from `flint.jdbc.template.*`,
/// unless the application defines `JdbcOperations`, and of a `NamedParameterJdbcTemplate` over it. Boot's
/// `JdbcTemplateConfiguration` and `NamedParameterJdbcTemplateConfiguration` are folded in.
@afterDataSource
@ConditionalOnClass(null, ["flint.javax.sql.DataSource", "flint.jdbc.core.JdbcTemplate"])
@ConditionalOnSingleCandidate(ClassRef("flint.javax.sql.DataSource"))
@EnableConfigurationProperties([ClassRef(typeNameOf!JdbcProperties)])
final class JdbcTemplateAutoConfiguration
{
    /// The primary `JdbcTemplate`. A single `SQLExceptionTranslator` bean replaces the default translator.
    @Bean
    @Primary
    @ConditionalOnMissingBean([ClassRef("flint.jdbc.core.JdbcOperations")])
    JdbcTemplate jdbcTemplate(DataSource dataSource, JdbcProperties properties,
            SQLExceptionTranslator[] sqlExceptionTranslators)
    {
        auto jdbcTemplate = new JdbcTemplate(dataSource);
        auto template_ = properties.getTemplate();
        jdbcTemplate.setIgnoreWarnings(template_.isIgnoreWarnings());
        jdbcTemplate.setFetchSize(template_.getFetchSize());
        jdbcTemplate.setMaxRows(template_.getMaxRows());
        if (template_.getQueryTimeout().isPresent())
            jdbcTemplate.setQueryTimeout(cast(int) template_.getQueryTimeout().get().total!"seconds");
        jdbcTemplate.setSkipResultsProcessing(template_.isSkipResultsProcessing());
        jdbcTemplate.setSkipUndeclaredResults(template_.isSkipUndeclaredResults());
        jdbcTemplate.setResultsMapCaseInsensitive(template_.isResultsMapCaseInsensitive());
        if (sqlExceptionTranslators.length == 1)
            jdbcTemplate.setExceptionTranslator(sqlExceptionTranslators[0]);
        return jdbcTemplate;
    }

    /// The primary `NamedParameterJdbcTemplate` over the single `JdbcTemplate`, unless the application defines
    /// `NamedParameterJdbcOperations`.
    @Bean
    @Primary
    @ConditionalOnSingleCandidate(ClassRef("flint.jdbc.core.JdbcTemplate"))
    @ConditionalOnMissingBean([ClassRef("flint.jdbc.core.namedparam.NamedParameterJdbcOperations")])
    NamedParameterJdbcTemplate namedParameterJdbcTemplate(JdbcTemplate jdbcTemplate)
    {
        return new NamedParameterJdbcTemplate(jdbcTemplate);
    }
}

/// Auto-configuration of a `JdbcClient` over the single `NamedParameterJdbcTemplate`, unless the application defines
/// one.
@afterJdbcTemplate
@ConditionalOnSingleCandidate(ClassRef("flint.jdbc.core.namedparam.NamedParameterJdbcTemplate"))
@ConditionalOnMissingBean([ClassRef("flint.jdbc.core.simple.JdbcClient")])
final class JdbcClientAutoConfiguration
{
    /// The client.
    @Bean
    JdbcClient jdbcClient(NamedParameterJdbcTemplate jdbcTemplate)
    {
        return JdbcClient.create(jdbcTemplate);
    }
}

// `@AutoConfiguration(after = JdbcTemplateAutoConfiguration.class)`.
private enum AutoConfiguration afterJdbcTemplate = () {
    AutoConfiguration configuration;
    configuration.afterName = ["flint.boot.jdbc.autoconfigure.JdbcTemplateAutoConfiguration"];
    return configuration;
}();

/// The application's `DataSource` initializer, configured from `flint.sql.init.*`.
class ApplicationDataSourceScriptDatabaseInitializer : DataSourceScriptDatabaseInitializer,
    ApplicationScriptDatabaseInitializer
{
    /// Over `dataSource`, with the settings `properties` describe.
    this(DataSource dataSource, SqlInitializationProperties properties)
    {
        this(dataSource, ApplicationScriptDatabaseInitializer.getSettings(properties));
    }

    /// Over `dataSource`, with `settings`.
    this(DataSource dataSource, DatabaseInitializationSettings settings)
    {
        super(dataSource, settings);
    }
}

/// Auto-configuration of SQL initialization: the `DataSource` is initialized from `flint.sql.init.*`'s schema and
/// data scripts when the context creates the initializer, unless the application defines its own initializer.
/// Boot's `DataSourceBuilder` for `flint.sql.init.username`/`password` joins with `DataSourceBuilder`; the scripts run
/// on the application's data source until then.
@AutoConfiguration
@ConditionalOnSingleCandidate(ClassRef("flint.javax.sql.DataSource"))
@ConditionalOnMissingBean([
    ClassRef("flint.boot.sql.autoconfigure.init.ApplicationScriptDatabaseInitializer")
])
@ConditionalOnClass(null, ["flint.jdbc.datasource.init.DatabasePopulator"])
@EnableConfigurationProperties([ClassRef(typeNameOf!SqlInitializationProperties)])
final class DataSourceInitializationAutoConfiguration
{
    /// The initializer, which runs the scripts once its properties are set.
    @Bean
    ApplicationDataSourceScriptDatabaseInitializer dataSourceScriptDatabaseInitializer(DataSource dataSource,
            SqlInitializationProperties properties)
    {
        return new ApplicationDataSourceScriptDatabaseInitializer(dataSource, properties);
    }
}
