/// Settings of the Spring Security filter. Bound under `flint.security.filter` (Boot's `spring.security.filter` is
/// accepted as an alias).
@ConfigurationProperties("flint.security.filter")
final class SecurityFilterProperties
{
    private int order = -100;
    private DispatcherType[] dispatcherTypes;
    /// The order of Boot's default `SecurityFilterChain` (`Ordered.LOWEST_PRECEDENCE - 5`).
    enum int BASIC_AUTH_ORDER = int.max - 5;
    /// The default order of the security filter (`OrderedFilter.REQUEST_WRAPPER_FILTER_MAX_ORDER - 100`).
    enum int DEFAULT_FILTER_ORDER = -100;

    /// Boot's defaults.
    this()
    {
        dispatcherTypes = [EnumMembers!DispatcherType];
    }

    /// Security filter chain order for Servlet-based web applications.
    int getOrder() const pure nothrow @nogc
    {
        return order;
    }

    /// Set `order`.
    void setOrder(int order) pure nothrow @nogc
    {
        this.order = order;
    }

    /// Security filter chain dispatcher types for Servlet-based web applications.
    DispatcherType[] getDispatcherTypes() pure nothrow @nogc
    {
        return dispatcherTypes;
    }

    /// Set `dispatcherTypes`.
    void setDispatcherTypes(DispatcherType[] dispatcherTypes) pure nothrow @nogc
    {
        this.dispatcherTypes = dispatcherTypes;
    }
}

