/// Auto-configuration of Spring Security's defaults: binds `flint.security.*`.
@AutoConfiguration @ConditionalOnClass(null, ["flint.security.authentication.AuthenticationManager"])
@EnableConfigurationProperties([ClassRef(typeNameOf!SecurityProperties)])
final class SecurityAutoConfiguration
{
}

/// Auto-configuration of an `InMemoryUserDetailsManager` holding the `flint.security.user.*` user, unless the
/// application defines its own way to authenticate.
@AutoConfiguration @ConditionalOnClass(null, ["flint.security.authentication.AuthenticationManager"])
@ConditionalOnMissingBean([
    ClassRef("flint.security.authentication.AuthenticationManager"),
    ClassRef("flint.security.authentication.AuthenticationProvider"),
    ClassRef("flint.security.core.userdetails.UserDetailsService")
])
@ConditionalOnWebApplication(ConditionalOnWebApplication.Type.SERVLET)
final class UserDetailsServiceAutoConfiguration
{
    private enum NOOP_PASSWORD_PREFIX = "{noop}";

    /// The default user; its password is logged when it was generated.
    @Bean InMemoryUserDetailsManager inMemoryUserDetailsManager(SecurityProperties properties,
            PasswordEncoder[] passwordEncoder)
    {
        auto user = properties.getUser();
        auto encoder = passwordEncoder.length == 1 ? passwordEncoder[0] : null;
        return new InMemoryUserDetailsManager(User.withUsername(user.getName())
                .password(getOrDeducePassword(user, encoder)).roles(user.getRoles()).build());
    }

    private static string getOrDeducePassword(SecurityProperties.User user, PasswordEncoder encoder)
    {
        import flint.slf4j : LoggerFactory;

        const password = user.getPassword();
        if (user.isPasswordGenerated())
            LoggerFactory.getLogger(typeNameOf!UserDetailsServiceAutoConfiguration)
                .warn("\n\nUsing generated security password: "
                        ~ password ~ "\n\nThis generated password is for development use only. "
                        ~ "Your security configuration must be updated before running your application in "
                        ~ "production.\n");
        if (encoder !is null || hasAlgorithmPrefix(password))
            return password;
        return NOOP_PASSWORD_PREFIX ~ password;
    }

    // Boot's PASSWORD_ALGORITHM_PATTERN, `^\\{.+}.*$`: an id in braces starts the password.
    private static bool hasAlgorithmPrefix(string password) pure nothrow @nogc
    {
        if (password.length < 3 || password[0] != '{')
            return false;
        foreach (i; 2 .. password.length)
        {
            if (password[i] == '}')
                return true;
        }
        return false;
    }
}
