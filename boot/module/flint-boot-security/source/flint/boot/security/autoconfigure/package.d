/// Settings of Spring Security's defaults. Bound under `flint.security` (Boot's `spring.security` is accepted as an
/// alias).
@ConfigurationProperties("flint.security")
final class SecurityProperties
{
    /// The default user name and password.
    static final class User
    {
        private string name = "user";
        private string password;
        private string[] roles;
        private bool passwordGenerated = true;
        /// Whether the password was generated (no `user.password` was set).
        bool isPasswordGenerated() const pure nothrow @nogc
        {
            return passwordGenerated;
        }

        /// Boot's defaults.
        this()
        {
            password = randomUUID().toString();
        }

        /// Default user name.
        string getName() const pure nothrow @nogc
        {
            return name;
        }

        /// Set `name`.
        void setName(string name) pure nothrow @nogc
        {
            this.name = name;
        }

        /// Password for the default user name.
        string getPassword() const pure nothrow @nogc
        {
            return password;
        }

        /// Set `password`.
        void setPassword(string password) pure nothrow @nogc
        {
            if (!password.length)
                return;
            this.passwordGenerated = false;
            this.password = password;
        }

        /// Granted roles for the default user name.
        string[] getRoles() pure nothrow @nogc
        {
            return roles;
        }

        /// Set `roles`.
        void setRoles(string[] roles) pure nothrow @nogc
        {
            this.roles = roles;
        }
    }

    private User user;

    /// Boot's defaults.
    this()
    {
        user = new User;
    }

    /// The default user (`user.*`).
    User getUser() pure nothrow @nogc
    {
        return user;
    }
}

