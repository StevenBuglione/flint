module security_test;

import flint.boot.context.properties.bind : Binder;
import flint.boot.context.properties.source : ConfigurationPropertySource, MapConfigurationPropertySource;
import flint.boot.security.autoconfigure : SecurityProperties, UserDetailsServiceAutoConfiguration;
import flint.boot.security.autoconfigure.web.servlet : SecurityFilterAutoConfiguration, SecurityFilterProperties;
import flint.engine.aot.descriptor : descriptorOf;
import flint.jakarta.servlet : DispatcherType;
import flint.security.crypto.password : NoOpPasswordEncoder, PasswordEncoder;

@safe:

private Binder binder(string[2][] entries)
{
    auto source = new MapConfigurationPropertySource("test", entries);
    auto binder = new Binder([cast(ConfigurationPropertySource) source]);
    foreach (descriptor; [
            descriptorOf!(SecurityProperties.User)(), descriptorOf!(string[])(),
            descriptorOf!DispatcherType(), descriptorOf!(DispatcherType[])()
        ])
        binder.getDescriptors().add(descriptor);
    return binder;
}

@("userWhenNotConfiguredShouldUseDefaultNameAndGeneratedPassword") unittest
{
    auto user = new SecurityProperties().getUser();
    assert(user.getName() == "user");
    assert(user.getPassword().length == 36, "a random UUID");
    assert(user.isPasswordGenerated());
    assert(user.getRoles().length == 0);
    assert(new SecurityProperties().getUser().getPassword() != user.getPassword());
}

@("userShouldBindProperly") unittest
{
    auto properties = binder([
        ["flint.security.user.name", "foo"], ["flint.security.user.password", "password"],
        ["flint.security.user.roles", "ADMIN,USER"]
    ]).bind!SecurityProperties("flint.security").get();
    auto user = properties.getUser();
    assert(user.getName() == "foo");
    assert(user.getPassword() == "password");
    assert(!user.isPasswordGenerated());
    assert(user.getRoles() == ["ADMIN", "USER"]);
}

@("passwordAutogeneratedIfEmpty") unittest
{
    auto properties = binder([["flint.security.user.password", ""]]).bind!SecurityProperties("flint.security").get();
    assert(properties.getUser().isPasswordGenerated());
}

private string passwordOf(string provided, PasswordEncoder[] encoders = null)
{
    auto properties = new SecurityProperties;
    if (provided !is null)
        properties.getUser().setPassword(provided);
    auto manager = new UserDetailsServiceAutoConfiguration().inMemoryUserDetailsManager(properties, encoders);
    return manager.loadUserByUsername("user").getPassword();
}

@("userDetailsServiceWhenPasswordEncoderAbsentAndDefaultPassword") unittest
{
    import std.algorithm.searching : startsWith;

    assert(passwordOf(null).startsWith("{noop}"));
}

@("userDetailsServiceWhenPasswordEncoderAbsentAndRawPassword") unittest
{
    assert(passwordOf("secret") == "{noop}secret");
}

@("userDetailsServiceWhenPasswordEncoderAbsentAndEncodedPassword") unittest
{
    enum password = "{bcrypt}$2a$10$sCBi9fy9814vUPf2ZRbtp.fR5/VgRk2iBFZ.ypu5IyZ28bZgxrVDa";
    assert(passwordOf(password) == password);
}

@("userDetailsServiceWhenPasswordEncoderBeanPresent") unittest
{
    assert(passwordOf("secret", [NoOpPasswordEncoder.getInstance()]) == "secret");
}

@("the default user carries the configured roles") unittest
{
    auto properties = new SecurityProperties;
    properties.getUser().setRoles(["ADMIN"]);
    auto user = new UserDetailsServiceAutoConfiguration().inMemoryUserDetailsManager(properties,
            null).loadUserByUsername("user");
    assert(user.getAuthorities().length == 1 && user.getAuthorities()[0].getAuthority() == "ROLE_ADMIN");
}

@("filterIsOrderedShortlyAfterRequestContextFilter") unittest
{
    // OrderedRequestContextFilter's order is REQUEST_WRAPPER_FILTER_MAX_ORDER - 105.
    enum requestContextFilterOrder = -105;
    auto registration = new SecurityFilterAutoConfiguration().securityFilterChainRegistration(
            new SecurityFilterProperties);
    assert(registration.getOrder() > requestContextFilterOrder && registration.getOrder()
            - requestContextFilterOrder <= 5);
    assert(registration.getFilterName() == "springSecurityFilterChain");
    assert(registration.getDispatcherTypes() == [
        DispatcherType.FORWARD, DispatcherType.INCLUDE, DispatcherType.REQUEST,
        DispatcherType.ASYNC, DispatcherType.ERROR
    ]);
}

@("the filter's order and dispatcher types bind from flint.security.filter.*") unittest
{
    auto properties = binder([
        ["flint.security.filter.order", "5"],
        ["flint.security.filter.dispatcher-types", "request,error"]
    ]).bind!SecurityFilterProperties("flint.security.filter").get();
    assert(properties.getOrder() == 5);
    assert(properties.getDispatcherTypes() == [DispatcherType.REQUEST, DispatcherType.ERROR]);
    auto registration = new SecurityFilterAutoConfiguration().securityFilterChainRegistration(properties);
    assert(registration.getOrder() == 5);
    assert(registration.getDispatcherTypes() == [DispatcherType.REQUEST, DispatcherType.ERROR]);
}
