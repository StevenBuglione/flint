name "boot-autoconfigure-data"
description "Flint Boot auto-configuration for flint:engine-data: the pool from [database], migrations at start-up, repositories"
license "Apache-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "flint:arena" version="*"
dependency "flint:conc" version="*"
dependency "flint:engine-di" version="*"
dependency "flint:config" version="*"
dependency "flint:engine-data" version="*"
dependency "flint:engine-sql" version="*"
dependency "flint:engine-migrate" version="*"

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}
