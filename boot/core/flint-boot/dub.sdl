name "boot-core"
description "Flint Boot core (spring-boot v4.2.0 core/spring-boot): FlintApplication, configuration data and binding, the banner, failure analysis and console logging"
license "Apache-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "flint:engine-aot" version="*"
dependency "flint:term" version="*"
dependency "flint:java" version="*"
dependency "flint:slf4j-api" version="*"
dependency "flint:core" version="*"
dependency "flint:beans" version="*"
dependency "flint:context" version="*"
dependency "flint:conc" version="*"
dependency "flint:os" version="*"

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}
