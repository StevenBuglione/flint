name "boot-test"
description "Flint Boot test support (spring-boot v4.2.0 core/spring-boot-test): @FlintBootTest, @TestConfiguration and the test context bootstrapper"
license "Apache-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "boot-core" path="../flint-boot"
dependency "boot-autoconfigure" path="../flint-boot-autoconfigure"
dependency "flint:engine-aot" path="../../.."
dependency "flint:context" path="../../.."

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}
