name "boot-autoconfigure"
description "Flint Boot auto-configuration (spring-boot v4.2.0 core/spring-boot-autoconfigure): @FlintBootApplication, @AutoConfiguration, the @ConditionalOn* annotations and the core auto-configurations"
license "Apache-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "flint:boot-core" version="*"
dependency "flint:engine-aot" version="*"
dependency "flint:java" version="*"

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}
