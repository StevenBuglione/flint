{
  "groups": [
    {
      "name": "flint.messages",
      "type": "flint.boot.autoconfigure.context.MessageSourceProperties",
      "sourceType": "flint.boot.autoconfigure.context.MessageSourceProperties"
    },
    {
      "name": "flint.web",
      "type": "flint.boot.autoconfigure.web.WebProperties",
      "sourceType": "flint.boot.autoconfigure.web.WebProperties"
    },
    {
      "name": "flint.web.resources",
      "type": "flint.boot.autoconfigure.web.WebProperties$Resources",
      "sourceType": "flint.boot.autoconfigure.web.WebProperties$Resources"
    },
    {
      "name": "flint.web.error",
      "type": "flint.boot.autoconfigure.web.WebProperties$ErrorProperties",
      "sourceType": "flint.boot.autoconfigure.web.WebProperties$ErrorProperties"
    },
    {
      "name": "flint.web.error.whitelabel",
      "type": "flint.boot.autoconfigure.web.WebProperties$ErrorProperties$Whitelabel",
      "sourceType": "flint.boot.autoconfigure.web.WebProperties$ErrorProperties$Whitelabel"
    }
  ],
  "properties": [
    {
      "name": "flint.messages.basename",
      "type": "java.util.List<java.lang.String>",
      "description": "List of basenames (essentially a fully-qualified classpath location), each following the ResourceBundle convention with relaxed support for slash based locations. If it does not contain a package qualifier (such as \"org.mypackage\"), it will be resolved from the classpath root.",
      "sourceType": "flint.boot.autoconfigure.context.MessageSourceProperties",
      "defaultValue": [
        "messages"
      ]
    },
    {
      "name": "flint.messages.common-messages",
      "type": "java.util.List<java.lang.String>",
      "description": "List of locale-independent property file resources containing common messages.",
      "sourceType": "flint.boot.autoconfigure.context.MessageSourceProperties"
    },
    {
      "name": "flint.messages.encoding",
      "type": "java.lang.String",
      "description": "Message bundles encoding (a charset name).",
      "sourceType": "flint.boot.autoconfigure.context.MessageSourceProperties",
      "defaultValue": "UTF-8"
    },
    {
      "name": "flint.messages.cache-duration",
      "type": "java.time.Duration",
      "description": "Loaded resource bundle files cache duration. When not set, bundles are cached forever. If a duration suffix is not specified, seconds will be used.",
      "sourceType": "flint.boot.autoconfigure.context.MessageSourceProperties"
    },
    {
      "name": "flint.messages.fallback-to-system-locale",
      "type": "java.lang.Boolean",
      "description": "Whether to fall back to the system Locale if no files for a specific Locale have been found. If this is turned off, the only fallback will be the default file (e.g. \"messages.properties\" for basename \"messages\").",
      "sourceType": "flint.boot.autoconfigure.context.MessageSourceProperties",
      "defaultValue": true
    },
    {
      "name": "flint.messages.always-use-message-format",
      "type": "java.lang.Boolean",
      "description": "Whether to always apply the MessageFormat rules, parsing even messages without arguments.",
      "sourceType": "flint.boot.autoconfigure.context.MessageSourceProperties",
      "defaultValue": false
    },
    {
      "name": "flint.messages.use-code-as-default-message",
      "type": "java.lang.Boolean",
      "description": "Whether to use the message code as the default message instead of throwing a \"NoSuchMessageException\". Recommended during development only.",
      "sourceType": "flint.boot.autoconfigure.context.MessageSourceProperties",
      "defaultValue": false
    },
    {
      "name": "flint.web.locale",
      "type": "java.lang.String",
      "description": "Locale to use (a language tag such as `en-US`). By default, this locale is overridden by the \"Accept-Language\" header.",
      "sourceType": "flint.boot.autoconfigure.web.WebProperties"
    },
    {
      "name": "flint.web.locale-resolver",
      "type": "LocaleResolver",
      "description": "Define how the locale should be resolved.",
      "sourceType": "flint.boot.autoconfigure.web.WebProperties",
      "defaultValue": "accept-header"
    },
    {
      "name": "flint.web.resources.static-locations",
      "type": "java.util.List<java.lang.String>",
      "description": "Locations of static resources.",
      "sourceType": "flint.boot.autoconfigure.web.WebProperties$Resources",
      "defaultValue": [
        "classpath:/META-INF/resources/",
        "classpath:/resources/",
        "classpath:/static/",
        "classpath:/public/"
      ]
    },
    {
      "name": "flint.web.resources.add-mappings",
      "type": "java.lang.Boolean",
      "description": "Whether to enable default resource handling.",
      "sourceType": "flint.boot.autoconfigure.web.WebProperties$Resources",
      "defaultValue": true
    },
    {
      "name": "flint.web.error.path",
      "type": "java.lang.String",
      "description": "Path of the error controller.",
      "sourceType": "flint.boot.autoconfigure.web.WebProperties$ErrorProperties",
      "defaultValue": "/error"
    },
    {
      "name": "flint.web.error.include-exception",
      "type": "java.lang.Boolean",
      "description": "Include the \"exception\" attribute.",
      "sourceType": "flint.boot.autoconfigure.web.WebProperties$ErrorProperties",
      "defaultValue": false
    },
    {
      "name": "flint.web.error.include-stacktrace",
      "type": "IncludeAttribute",
      "description": "When to include the \"trace\" attribute.",
      "sourceType": "flint.boot.autoconfigure.web.WebProperties$ErrorProperties",
      "defaultValue": "never"
    },
    {
      "name": "flint.web.error.include-message",
      "type": "IncludeAttribute",
      "description": "When to include the \"message\" attribute.",
      "sourceType": "flint.boot.autoconfigure.web.WebProperties$ErrorProperties",
      "defaultValue": "never"
    },
    {
      "name": "flint.web.error.include-binding-errors",
      "type": "IncludeAttribute",
      "description": "When to include the \"errors\" attribute.",
      "sourceType": "flint.boot.autoconfigure.web.WebProperties$ErrorProperties",
      "defaultValue": "never"
    },
    {
      "name": "flint.web.error.include-path",
      "type": "IncludeAttribute",
      "description": "When to include the \"path\" attribute.",
      "sourceType": "flint.boot.autoconfigure.web.WebProperties$ErrorProperties",
      "defaultValue": "always"
    },
    {
      "name": "flint.web.error.whitelabel.enabled",
      "type": "java.lang.Boolean",
      "description": "Whether to enable the default error page displayed in browsers in case of a server error.",
      "sourceType": "flint.boot.autoconfigure.web.WebProperties$ErrorProperties$Whitelabel",
      "defaultValue": true
    }
  ],
  "hints": []
}
