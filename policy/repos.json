{
  "schema": "flint.repos/1",
  "note": "Repo split (plan section 7, ADR-030): every flint:* package belongs to one repo, and edges follow Spring's own: integrated repos (security, the data family, batch) sit between boot and framework, so boot -> integrated -> framework -> flint; Boot-based repos (ai, the cloud family, later shell) ship their own auto-configuration and depend on boot.",
  "repos": {
    "flint": {
      "github": "flint",
      "kind": "tooling",
      "may_depend_on": []
    },
    "framework": {
      "github": "flint-framework",
      "kind": "framework",
      "may_depend_on": [
        "flint"
      ]
    },
    "security": {
      "github": "flint-security",
      "kind": "integrated",
      "may_depend_on": [
        "framework",
        "flint"
      ]
    },
    "data-jdbc": {
      "github": "flint-data-jdbc",
      "kind": "integrated",
      "may_depend_on": [
        "framework",
        "flint"
      ]
    },
    "boot": {
      "github": "flint-boot",
      "kind": "boot",
      "may_depend_on": [
        "security",
        "data-jdbc",
        "framework",
        "flint"
      ]
    },
    "ai": {
      "github": "flint-ai",
      "kind": "boot-based",
      "may_depend_on": [
        "boot",
        "security",
        "data-jdbc",
        "framework",
        "flint"
      ]
    }
  },
  "pending_edges": []
}
