{
  "schema": "flint.starters/1",
  "starters": {
    "starter-web": {
      "directory": "starters/web",
      "module": "flint.starter_web",
      "dependencies": [
        "arena",
        "di",
        "config",
        "web",
        "term",
        "validate"
      ],
      "section": "server",
      "summary": "REST controllers on a configuration-bound server, wired by runApplication"
    },
    "starter-observability": {
      "directory": "starters/observability",
      "module": "flint.starter_observability",
      "dependencies": [
        "arena",
        "conc",
        "di",
        "config",
        "web",
        "actuator"
      ],
      "section": "management",
      "summary": "Health, readiness and Prometheus metrics endpoints on the application's server, and OTLP export"
    },
    "starter-data": {
      "directory": "starters/data",
      "module": "flint.starter_data",
      "dependencies": [
        "arena",
        "conc",
        "di",
        "config",
        "data",
        "sql",
        "migrate"
      ],
      "section": "database",
      "summary": "A configured SQL pool, the project's migrations applied at start-up, and repositories as beans"
    }
  }
}
