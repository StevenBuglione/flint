{
  "schema": "flint.boot/1",
  "libraries": {
    "boot": {
      "directory": "boot/boot",
      "module": "flint.boot",
      "dependencies": [
        "arena",
        "engine-di",
        "config",
        "term"
      ],
      "repo": "boot"
    },
    "boot-autoconfigure-web": {
      "directory": "boot/autoconfigure-web",
      "module": "flint.boot_autoconfigure_web",
      "dependencies": [
        "arena",
        "engine-di",
        "config",
        "engine-web",
        "term",
        "boot"
      ],
      "repo": "boot"
    },
    "boot-autoconfigure-data": {
      "directory": "boot/autoconfigure-data",
      "module": "flint.boot_autoconfigure_data",
      "dependencies": [
        "arena",
        "conc",
        "engine-di",
        "config",
        "engine-data",
        "engine-sql",
        "engine-migrate"
      ],
      "repo": "boot"
    },
    "boot-actuator": {
      "directory": "boot/actuator",
      "module": "flint.boot_actuator",
      "dependencies": [
        "arena",
        "conc",
        "engine-di",
        "config",
        "engine-web",
        "engine-actuator"
      ],
      "repo": "boot"
    }
  },
  "starters": {
    "starter": {
      "directory": "starters/starter",
      "dependencies": [
        "boot",
        "log"
      ],
      "section": "",
      "summary": "Flint Boot and logging: the base every other starter builds on",
      "repo": "boot"
    },
    "starter-web": {
      "directory": "starters/web",
      "dependencies": [
        "starter",
        "arena",
        "engine-di",
        "config",
        "serde",
        "validate",
        "engine-web",
        "boot-autoconfigure-web"
      ],
      "section": "server",
      "summary": "REST controllers on a configuration-bound server, with SPA serving and OpenAPI",
      "autoconfiguration": [
        "flint.boot_autoconfigure_web:WebServerAutoConfiguration"
      ],
      "repo": "boot"
    },
    "starter-actuator": {
      "directory": "starters/actuator",
      "dependencies": [
        "starter",
        "engine-actuator",
        "boot-actuator"
      ],
      "section": "management",
      "summary": "Health, readiness and Prometheus metrics endpoints on the application's server, and OTLP export",
      "autoconfiguration": [
        "flint.boot_actuator:ActuatorAutoConfiguration"
      ],
      "repo": "boot"
    },
    "starter-data-jdbc": {
      "directory": "starters/data-jdbc",
      "dependencies": [
        "starter",
        "conc",
        "engine-data",
        "engine-sql",
        "engine-migrate",
        "boot-autoconfigure-data"
      ],
      "section": "database",
      "summary": "A configured SQL pool, migrations applied at start-up, and repositories as beans",
      "autoconfiguration": [
        "flint.boot_autoconfigure_data:DataSourceAutoConfiguration"
      ],
      "repo": "boot"
    }
  }
}
