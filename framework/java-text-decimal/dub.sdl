name "java-text-decimal"
description "Java SE java.text.DecimalFormat over the java-text decimal renderers"
license "GPL-2.0-only WITH Classpath-exception-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "flint:java" version="*"
dependency "flint:java-text" version="*"

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}
