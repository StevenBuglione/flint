name "java-concurrent-service"
description "Optional Java execution service runtime"
license "GPL-2.0-only WITH Classpath-exception-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "flint:arena" version="*"
dependency "flint:conc" version="*"
dependency "flint:engine-reactor" version="*"
dependency "flint:java" version="*"
dependency "flint:java-concurrent-exec" version="*"
dependency "flint:java-concurrent-rejection" version="*"

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}
