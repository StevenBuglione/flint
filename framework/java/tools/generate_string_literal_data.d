/// Emit the graphical Unicode ranges used by the legacy D string-array display.
module generate_string_literal_data;

import std.stdio : write, writef;
import std.uni : isGraphical;

@safe:

void main()
{
    uint[2][] ranges;
    uint first;
    bool inside;
    foreach (uint point; 0 .. 0x110001)
    {
        const graphical = point < 0x110000 && isGraphical(cast(dchar) point);
        if (graphical && !inside)
            first = point;
        if (inside && !graphical)
            ranges ~= [first, point - 1];
        inside = graphical;
    }

    write(`// Generated by framework/java/tools/generate_string_literal_data.d with the pinned D toolchain.
/// Unicode graphical code points for the D string-array display.
module flint.java.data.stringliteral;

@safe:

/// Whether the D string-array display leaves this non-ASCII code point unescaped.
bool isGraphical(dchar point) pure nothrow @nogc
{
    size_t low;
    size_t high = ranges.length;
    while (low < high)
    {
        const middle = low + (high - low) / 2;
        if (point < ranges[middle][0])
            high = middle;
        else if (point > ranges[middle][1])
            low = middle + 1;
        else
            return true;
    }
    return false;
}

`);
    writef!"private static immutable uint[2][%d] ranges = [\n"(ranges.length);
    foreach (ref const range; ranges)
        writef!"    [0x%X, 0x%X],\n"(range[0], range[1]);
    write("];\n");
}
