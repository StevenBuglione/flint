    assert(toUpperCase('ß') == 'ß' && toLowerCase('İ') == 'i' && toLowerCase('1') == '1');
    assert(toLowerCase('Ω') == 'ω' && toUpperCase(cast(dchar) 0x10428) == 0x10400);
}

@("Character categories: isUpperCase includes Other_Uppercase; \\p{Lu} and \\p{Ll} are the letter categories")
unittest
{
    assert(isUpperCase('Ⓐ') && !isUppercaseLetter('Ⓐ'));
    assert(isUppercaseLetter('Ж') && !isUppercaseLetter('ж'));
    assert(isLowercaseLetter('ж') && !isLowercaseLetter('Ж') && isLowercaseLetter('ß'));
}

@("Character categories: \\p{L} is letters of every script; \\p{N} is every number category")
unittest
{
    assert(isLetter('a') && isLetter('Ж') && isLetter('中') && isLetter('ʰ'));
    assert(!isLetter('1') && !isLetter('Ⅻ') && !isLetter(cast(dchar) 0x0301) && !isLetter(' ') && !isLetter('_'));
    assert(isNumber('7') && isNumber('٣') && isNumber('Ⅻ') && isNumber('½'));
    assert(!isNumber('a') && !isNumber('-'));
}
