        if (_numbersAsStrings)
            quoted(encodedValue);
        else
            put(encodedValue);
        return this;
    }

    override JsonGenerator writeBoolean(bool state)
    {
        verifyValueWrite("write a boolean value");
        put(state ? "true" : "false");
        return this;
    }

    override JsonGenerator writeNull()
    {
        verifyValueWrite("write a null");
        put("null");
        return this;
    }

    override JsonGenerator writeRaw(string text)
    {
        verifyOpen();
        put(text);
        return this;
    }

    override JsonGenerator writeRaw(char c)
    {
        verifyOpen();
        put(cast(ubyte) c);
        return this;
    }

    override JsonGenerator writeRawValue(string text)
    {
        verifyValueWrite("write a raw (unencoded) value");
        put(text);
        return this;
    }

    override void flush()
    {
        flushBuffer();
    }

    override void close()
    {
        if (_closed)
            return;
        if (isEnabled(StreamWriteFeature.AUTO_CLOSE_CONTENT))
        {
            for (;;)
            {
                if (_streamWriteContext.inArray())
                    writeEndArray();
                else if (_streamWriteContext.inObject())
                    writeEndObject();
                else
                    break;
            }
        }
        flushBuffer();
        _closed = true;
    }

    override bool isClosed()
    {
        return _closed;
    }
}

/// Extension of `TokenStreamContext`, which implements core methods needed, and also exposes more complete API to parser implementation classes.
final class JsonReadContext : TokenStreamContext
{
    private JsonReadContext _child;
    private int _depth;
    private size_t _startOffset;

    private this(int type, JsonReadContext parent, int depth, size_t startOffset) pure nothrow @nogc
    {
        _type = type;
        _parent = parent;
        _depth = depth;
        _index = -1;
        _startOffset = startOffset;
    }

    /// The root context of a new parser.
    static JsonReadContext createRootContext() pure nothrow
    {
        return new JsonReadContext(TYPE_ROOT, null, 0, 0);
    }

    // A recycled parser's root context, as new; the children are kept and forget the names and values they held.
    package(flint.jackson) void resetRoot() pure nothrow @nogc
    {
        _type = TYPE_ROOT;
        _index = -1;
        _startOffset = 0;
        for (auto c = this; c !is null; c = c._child)
        {
            c._currentName = null;
            c._currentValue = null;
        }
    }

    private JsonReadContext child(int type, size_t offset) pure nothrow
    {
        if (_child is null)
            _child = new JsonReadContext(type, this, _depth + 1, offset);
        else
        {
            _child._type = type;
            _child._index = -1;
            _child._currentName = null;
            _child._currentValue = null;
            _child._startOffset = offset;
        }
        return _child;
    }

    /// Enter an Array.
    JsonReadContext createChildArrayContext(size_t offset) pure nothrow
    {
        return child(TYPE_ARRAY, offset);
    }

    /// Enter an Object.
    JsonReadContext createChildObjectContext(size_t offset) pure nothrow
    {
        return child(TYPE_OBJECT, offset);
    }

    /// The parent context.
    override JsonReadContext getParent() pure nothrow @nogc
    {
        return cast(JsonReadContext) _parent;
    }

    /// Nesting depth: 0 for the root.
    int getNestingDepth() const pure nothrow @nogc
    {
        return _depth;
    }

    /// Whether the next entry must be preceded by a comma.
    bool expectComma() pure nothrow @nogc
    {
        return ++_index > 0 && _type != TYPE_ROOT;
    }

    /// Record the current property name.
    void setCurrentName(string name) pure nothrow @nogc
    {
        _currentName = name;
    }
}

/**
 * This is a concrete implementation of `JsonParser`, which is based on a UTF-8
 * encoded byte buffer holding the complete document.
 */
class UTF8StreamJsonParser : JsonParser
{
    alias getValueAsInt = JsonParser.getValueAsInt;
    alias getValueAsLong = JsonParser.getValueAsLong;
    alias getValueAsDouble = JsonParser.getValueAsDouble;
    alias getValueAsBoolean = JsonParser.getValueAsBoolean;
    private ObjectReadContext _objectReadContext;
    private JsonFactory _factory;
    private StreamReadConstraints _constraints;
    private const(ubyte)[] _input;
    private size_t _inputPtr;
    private JsonReadContext _streamReadContext;
    private JsonToken _currToken;
    private bool _closed;
    private bool _nameCopied;
    // The factory's JsonReadFeature mask. Each non-standard construct is looked at only where strict JSON would end
    // a token or fail, so a parser with the defaults never reads it.
    private uint _readFeatures;

    // The current token's span: string contents or number text.
    private JsonTextToken _text;
    private JsonNumberToken _number;
    private size_t _tokenStart;
    private string _textCache;
    private bool _textCached;

    // Parsed numeric value of the current number token.
    private NumberType _numberType;
    private long _numberLong;
    private double _numberDouble;
    private bool _numberParsed;
    // A number read by oddNumber (a JsonReadFeature's form): the text getString reports, the digits it parses as, and
    // whether it is NaN or an Infinity. _oddText is null for a strict number (the strict path pays one store) and the
    // other two are read only when it is set.
    private string _oddText;
    private string _oddDigits;
    private bool _oddNonNumeric;

    // Escaped text decodes here before its one copy; kept across documents by a recycled parser.
    private char[] _scratch;

    /// A parser over `content`, which it borrows until it is closed.
    this(ObjectReadContext readCtxt, JsonFactory factory, const(ubyte)[] content)
    {
        _factory = factory;
        _readFeatures = factory._formatReadFeatures;
        _constraints = factory.streamReadConstraints();
        _streamReadContext = JsonReadContext.createRootContext();
        reuse(readCtxt, content);
    }

    // Start over on `content`, keeping the context chain and the scratch buffer (a recycled parser).
    package(flint.jackson) void reuse(ObjectReadContext readCtxt, const(ubyte)[] content)
    {
        _objectReadContext = readCtxt;
        _input = content;
        _inputPtr = 0;
        _streamReadContext.resetRoot();
        _currToken = JsonToken.NOT_AVAILABLE;
        _closed = false;
        _textCache = null;
        _textCached = false;
        _numberParsed = false;
        // A UTF-8 byte order mark is skipped, as Jackson's bootstrapper does.
        if (content.length >= 3 && content[0] == 0xEF && content[1] == 0xBB && content[2] == 0xBF)
            _inputPtr = 3;
    }

    // Drop what a finished read referenced (its document, context and decoded text), so the pool keeps none of it.
    package(flint.jackson) void forget() pure nothrow @nogc
    {
        _objectReadContext = null;
        _input = null;
        _textCache = null;
        _streamReadContext.resetRoot();
    }

    override bool isEnabled(StreamReadFeature f)
    {
        return _factory.isEnabled(f);
    }

    override int streamReadFeatures()
    {
        return cast(int) _factory._streamReadFeatures;
    }

    override ObjectReadContext objectReadContext()
    {
        return _objectReadContext;
    }

    override StreamReadConstraints streamReadConstraints()
    {
        return _constraints;
    }

    override TokenStreamContext streamReadContext()
    {
        return _streamReadContext;
    }

    override JsonToken currentToken()
    {
        return _currToken;
    }

    override string currentName()
    {
        // For START_OBJECT and START_ARRAY the name belongs to the enclosing context, as Jackson reports it.
        if (_currToken == JsonToken.START_OBJECT || _currToken == JsonToken.START_ARRAY)
        {
            auto parent = _streamReadContext.getParent();
            return parent is null ? null : parent.currentName();
        }
        return _streamReadContext.currentName();
    }

    override void close()
    {
        _closed = true;
        if (isEnabled(StreamReadFeature.CLEAR_CURRENT_TOKEN_ON_CLOSE))
            _currToken = JsonToken.NOT_AVAILABLE;
    }

    override bool isClosed()
    {
        return _closed;
    }

    // What skipWhitespace does with a byte: stop at it (a token), skip it (a blank), or look closer (`/`, `#` or a
    // control character: a comment or RS when their features are on, Jackson's error otherwise).
    private enum Space : ubyte
    {
        token,
        blank,
        odd,
    }

    private static immutable Space[256] spaceKind = () {
        Space[256] kinds;
        foreach (c; 0 .. 0x20)
            kinds[c] = Space.odd;
        kinds[' '] = kinds['\t'] = kinds['\n'] = kinds['\r'] = Space.blank;
        kinds['/'] = kinds['#'] = Space.odd;
        return kinds;
    }();

    private void skipWhitespace()
    {
        while (_inputPtr < _input.length)
        {
            immutable kind = spaceKind[_input[_inputPtr]];
            if (kind == Space.blank)
                ++_inputPtr;
            else if (kind == Space.token || !skipOdd())
                return;
        }
    }

    private bool allows(JsonReadFeature f) const pure nothrow @nogc
    {
        return (_readFeatures & (1u << f)) != 0;
    }

    private enum commentsDisabled = "maybe a (non-standard) comment? (not recognized as one since Feature "
        ~ "'ALLOW_COMMENTS' not enabled for parser)";

    // At `/`, `#` or a control character between tokens: skip a comment or RS its feature allows (true), leave a `#`
    // that ALLOW_YAML_COMMENTS doesn't make a comment to the value it starts (false), or fail as Jackson does.
    private bool skipOdd()
    {
        immutable c = _input[_inputPtr];
        if (c == '/')
        {
            if (!allows(JsonReadFeature.ALLOW_JAVA_COMMENTS))
                throw unexpected(c, commentsDisabled);
            ++_inputPtr;
            if (_inputPtr == _input.length)
                throw eofInComment();
            immutable kind = _input[_inputPtr++];
            if (kind == '/')
                skipLine();
            else if (kind == '*')
                skipBlockComment();
            else
                throw unexpected(kind, "was expecting either '*' or '/' for a comment");
            return true;
        }
        if (c == '#')
        {
            if (!allows(JsonReadFeature.ALLOW_YAML_COMMENTS))
                return false;
            ++_inputPtr;
            skipLine();
            return true;
        }
        if (c == 0x1E && allows(JsonReadFeature.ALLOW_RS_CONTROL_CHAR))
        {
            ++_inputPtr;
            return true;
        }
        throw invalidSpace(c);
    }

    // A `//` or `#` comment: up to and including its line feed or carriage return, or to the end of input.
    private void skipLine()
    {
        while (_inputPtr < _input.length)
        {
            immutable c = _input[_inputPtr++];
            if (c == '\n' || c == '\r')
                return;
            skipCommentByte(c);
        }
    }

    // A `/* ... */` comment, after its opening.
    private void skipBlockComment()
    {
        while (_inputPtr < _input.length)
        {
            immutable c = _input[_inputPtr++];
            if (c == '*' && _inputPtr < _input.length && _input[_inputPtr] == '/')
            {
                ++_inputPtr;
                return;
            }
            if (c != '\n' && c != '\r')
                skipCommentByte(c);
        }
        throw eofInComment();
    }

    // One comment character after its first byte: a control character other than tab fails, and a multi-byte UTF-8
    // sequence must be well formed (Jackson's comment input codes).
    private void skipCommentByte(ubyte c)
    {
        if (c < 0x20)
        {
            if (c != '\t')
                throw invalidSpace(c);
            return;
        }
        if (c < 0x80)
            return;
        immutable extra = c >= 0xC0 && c < 0xE0 ? 1 : c >= 0xE0 && c < 0xF0 ? 2 : c >= 0xF0 && c < 0xF8 ? 3 : 0;
        if (extra == 0)
            throw invalidUtf8("start", c);
        foreach (i; 0 .. extra)
        {
            if (_inputPtr == _input.length)
                throw eofInComment();
            immutable next = _input[_inputPtr++];
            if ((next & 0xC0) != 0x80)
                throw invalidUtf8("middle", next);
        }
    }

    // Jackson's _reportInvalidInitial and _reportInvalidOther: "Invalid UTF-8 start byte 0xc3".
    private JacksonException invalidUtf8(string which, ubyte b)
    {
        const char[2] hex = [lowerHexDigits[b >> 4], lowerHexDigits[b & 0xF]];
        return readError(joined("Invalid UTF-8 ", which, " byte 0x", hex[]));
    }

    private JacksonException eofInComment()
    {
        return endOfInputError("Unexpected end-of-input in a comment");
    }

    // ParserMinimalBase._reportInvalidSpace: a control character between tokens.
    private JacksonException invalidSpace(ubyte c)
    {
        enum spaceRule = "only regular white space (\\r, \\n, \\t) is allowed between tokens";
        enum rsHint = spaceRule ~ " (consider enabling `JsonReadFeature.ALLOW_RS_CONTROL_CHAR` to allow use of "
            ~ "Record Separators (\\u001E))";
        return readError(joined("Illegal character ((CTRL-CHAR, code ", decimal(c), ")): ",
                c == 0x1E ? rsHint : spaceRule));
    }

    override JsonToken nextToken()
    {
        if (_closed)
            return JsonToken.NOT_AVAILABLE;
        _textCached = false;
        _numberParsed = false;
        if (_currToken == JsonToken.PROPERTY_NAME)
            return _currToken = readValue(_input[_inputPtr]);
        skipWhitespace();
        if (_inputPtr == _input.length)
            return _currToken = endOfInput();
        ubyte c = _input[_inputPtr];
        if (c == ']' || c == '}')
        {
            closeScope(c);
            return _currToken;
        }
        if (_streamReadContext.expectComma())
        {
            c = afterComma(c);
            if (c == 0) // a trailing comma closed the scope (ALLOW_TRAILING_COMMA)
                return _currToken;
        }
        if (_streamReadContext.inObject())
            return _currToken = readName(c);
        return _currToken = readValue(c);
    }

    // At the end of input: fine at the root, an error inside an Array or Object.
    private JsonToken endOfInput()
    {
        if (!_streamReadContext.inRoot())
        {
            // The calls stay inside the concatenation: operands passed as values, not variables, keep its instance.
            auto context = _streamReadContext;
            throw endOfInputError("Unexpected end-of-input: expected close marker for " ~ context.typeDesc()
                    ~ " (start marker at " ~ locationAt(context._startOffset).toString() ~ ")");
        }
        close();
        return JsonToken.NOT_AVAILABLE;
    }

    // Consume the comma that must separate entries and return the first byte of the next one, or 0 when that byte
    // closed the scope (a trailing comma). skipWhitespace never stops at a 0: it is a control character.
    private ubyte afterComma(ubyte c)
    {
        if (c != ',')
            throw unexpected(c, "was expecting comma to separate " ~ _streamReadContext.typeDesc() ~ " entries");
        ++_inputPtr;
        skipWhitespace();
        if (_inputPtr == _input.length)
            throw eofIn(_streamReadContext.inArray() ? "Array entries" : "Object entries");
        c = _input[_inputPtr];
        if (c == ']' || c == '}')
            return closeAfterComma(c);
        return c;
    }

    // A close marker right after a comma: the scope's end with ALLOW_TRAILING_COMMA, a missing array element with
    // ALLOW_MISSING_VALUES (readValue reports it as null and leaves the marker), an error otherwise.
    private ubyte closeAfterComma(ubyte c)
    {
        if (allows(JsonReadFeature.ALLOW_TRAILING_COMMA))
        {
            closeScope(c);
            return 0;
        }
        if (c == ']' && _streamReadContext.inArray() && allows(JsonReadFeature.ALLOW_MISSING_VALUES))
            return c;
        throw unexpected(c, "expected a value");
    }

    private JsonToken readName(ubyte c)
    {
        if (c != '"')
            return readOddName(c);
        _tokenStart = _inputPtr;
        auto scanner = JsonScanner(_input, JsonDecodeOptions.init);
        scanner.offset = _inputPtr;
        JsonTextToken token;
        const error = scanner.text(token);
        // A string the strict scanner rejects is read again by Jackson's slow path: it accepts what the features
        // allow, or fails as Jackson does.
        if (error.code)
        {
            ++_inputPtr;
            return finishOddName(lenientText('"', true));
        }
        if (token.length > _constraints.maxNameLength)
        {
            throw lengthError("Name", token.length, _constraints.maxNameLength, null);
        }
        _inputPtr = scanner.offset;
        skipWhitespace();
        if (_inputPtr == _input.length)
            throw eofIn("Object entries");
        if (_input[_inputPtr] != ':')
            throw unexpected(_input[_inputPtr], "was expecting a colon to separate property name and value");
        ++_inputPtr;
        skipWhitespace();
        if (_inputPtr == _input.length)
            throw eofIn("Object entries");
        _streamReadContext.setCurrentName(name(token));
        return JsonToken.PROPERTY_NAME;
    }

    // A name that doesn't start with '"' (UTF8StreamJsonParser._handleOddName): single-quoted with ALLOW_SINGLE_QUOTES,
    // unquoted with ALLOW_UNQUOTED_PROPERTY_NAMES (Jackson's name characters, up to the first other byte), or an error.
    private JsonToken readOddName(ubyte c)
    {
        _tokenStart = _inputPtr;
        if (c == '\'' && allows(JsonReadFeature.ALLOW_SINGLE_QUOTES))
        {
            ++_inputPtr;
            return finishOddName(lenientText('\'', true));
        }
        if (!allows(JsonReadFeature.ALLOW_UNQUOTED_PROPERTY_NAMES))
            throw unexpected(c, "was expecting double-quote to start property name");
        if (!(nameClass[c] & unquotedName))
            throw unexpected(c, "was expecting either valid name character (for unquoted name) or double-quote (for "
                    ~ "quoted) to start property name");
        immutable start = _inputPtr;
        while (_inputPtr < _input.length && (nameClass[_input[_inputPtr]] & unquotedName))
            ++_inputPtr;
        auto text = cast(const(char)[]) _input[start .. _inputPtr];
        checkUtf8(start, _inputPtr);
        return finishOddName(text);
    }

    // The rest of a name a non-standard path read: readName's length limit, colon and interning.
    private JsonToken finishOddName(const(char)[] text)
    {
        if (text.length > _constraints.maxNameLength)
            throw lengthError("Name", text.length, _constraints.maxNameLength, null);
        skipWhitespace();
        if (_inputPtr == _input.length)
            throw eofIn("Object entries");
        if (_input[_inputPtr] != ':')
            throw unexpected(_input[_inputPtr], "was expecting a colon to separate property name and value");
        ++_inputPtr;
        skipWhitespace();
        if (_inputPtr == _input.length)
            throw eofIn("Object entries");
        // An owned copy, not the factory's interned one: a second internName caller keeps LDC from inlining it into
        // the strict readName, a request-path cost (R-182).
        _streamReadContext.setCurrentName(owned(text));
        return JsonToken.PROPERTY_NAME;
    }

    // CharTypes.getInputCodeUtf8JsNames: the bytes an unquoted name may hold. Java identifier parts from 33 up, read
    // as Latin-1 as Jackson's table does, plus '@', '#', '*', '-' and '+'.
    private enum ubyte identifierPart = 1, unquotedName = 2;

    // A string value read by lenientText: decoded once, owned, and kept as the token's text.
    private JsonToken lenientValue(ubyte quote)
    {
        ++_inputPtr;
        auto text = lenientText(quote, false);
        if (text.length > _constraints.maxStringLength)
            throw lengthError("String value", text.length, _constraints.maxStringLength, null);
        _textCache = owned(text);
        _textCached = true;
        return JsonToken.VALUE_STRING;
    }

    // Jackson's slow string path, after the opening `quote`: escapes (with ALLOW_BACKSLASH_ESCAPING_ANY_CHARACTER any
    // character may follow a backslash, and with ALLOW_SINGLE_QUOTES an apostrophe may), control characters with
    // ALLOW_UNESCAPED_CONTROL_CHARS, and well-formed UTF-8. Decodes into the scratch buffer and ends after the closing
    // quote.
    private const(char)[] lenientText(ubyte quote, bool isName)
    {
        size_t n;
        void put(ubyte b)
        {
            if (n == _scratch.length)
                growScratch(n < 32 ? 64 : n * 2);
            _scratch[n++] = cast(char) b;
        }

        while (true)
        {
            if (_inputPtr == _input.length)
                throw isName ? endOfInputError("Unexpected end-of-input in property name", JsonToken.PROPERTY_NAME)
                    : endOfInputError("Unexpected end-of-input: was expecting closing quote for a string value",
                            JsonToken.VALUE_STRING);
            immutable c = _input[_inputPtr++];
            if (c == quote)
                return _scratch[0 .. n];
            if (c == '\\')
            {
                dchar unit = escaped(isName);
                if (unit < 0x80)
                    put(cast(ubyte) unit);
                else
                {
                    ubyte[4] bytes;
                    foreach (b; bytes[0 .. encodeUtf8(unit, bytes)])
                        put(b);
                }
            }
            else if (c < 0x20)
            {
                if (!allows(JsonReadFeature.ALLOW_UNESCAPED_CONTROL_CHARS))
                    throw unquotedControl(c, isName);
                put(c);
            }
            else
            {
                put(c);
                if (c >= 0x80)
                {
                    immutable from = _inputPtr;
                    skipUtf8Tail(c);
                    foreach (b; _input[from .. _inputPtr])
                        put(b);
                }
            }
        }
    }

    // ParserBase._decodeEscaped, after a backslash: the code point it stands for.
    private dchar escaped(bool isName)
    {
        if (_inputPtr == _input.length)
            throw isName ? endOfInputError("Unexpected end-of-input in property name", JsonToken.PROPERTY_NAME)
                : endOfInputError("Unexpected end-of-input: was expecting closing quote for a string value",
                        JsonToken.VALUE_STRING);
        immutable e = _input[_inputPtr++];
        if (e == 'u')
            return unicodeEscape();
        immutable simple = simpleEscapes[e];
        return simple != 0xFF ? simple : otherEscape(e);
    }

    // The one-character escapes and what they stand for; 0xFF where the character after a backslash is not one.
    private static immutable ubyte[256] simpleEscapes = () {
        ubyte[256] table = 0xFF;
        table['"'] = '"';
        table['\\'] = '\\';
        table['/'] = '/';
        table['b'] = '\b';
        table['t'] = '\t';
        table['n'] = '\n';
        table['f'] = '\f';
        table['r'] = '\r';
        return table;
    }();

    // A \u escape: a surrogate pair's halves join, and a lone surrogate is U+FFFD (R14).
    private dchar unicodeEscape()
    {
        immutable unit = hexUnit();
        if (unit < 0xD800 || unit > 0xDFFF)
            return unit;
        const next = _inputPtr + 1 < _input.length ? _input[_inputPtr .. _inputPtr + 2] : null;
        immutable pairFollows = next.length == 2 && next[0] == '\\' && next[1] == 'u';
        if (unit <= 0xDBFF && pairFollows)
        {
            immutable mark = _inputPtr;
            _inputPtr += 2;
            immutable low = hexUnit();
            if (low >= 0xDC00 && low <= 0xDFFF)
                return 0x10000 + ((unit - 0xD800) << 10) + (low - 0xDC00);
            _inputPtr = mark; // not a pair: the next escape is read on its own
        }
        return 0xFFFD;
    }

    // ParserMinimalBase._handleUnrecognizedCharacterEscape: the character itself with
    // ALLOW_BACKSLASH_ESCAPING_ANY_CHARACTER (or an apostrophe with ALLOW_SINGLE_QUOTES), an error otherwise.
    private dchar otherEscape(ubyte e)
    {
        import flint.engine.aot.text : decodeUtf8;

        if (!allows(JsonReadFeature.ALLOW_BACKSLASH_ESCAPING_ANY_CHARACTER) && !(e == '\''
                && allows(JsonReadFeature.ALLOW_SINGLE_QUOTES)))
            throw unexpected(e, null, false, true);
        if (e < 0x80)
            return e;
        immutable from = _inputPtr - 1;
        skipUtf8Tail(e);
        size_t at;
        return decodeUtf8(cast(const(char)[]) _input[from .. _inputPtr], at);
    }

    // Four hex digits of a \u escape.
    private dchar hexUnit()
    {
        dchar unit = 0; // not dchar.init, which is U+FFFF
        foreach (i; 0 .. 4)
        {
            if (_inputPtr == _input.length)
                throw endOfInputError("Unexpected end-of-input in character escape sequence", JsonToken.VALUE_STRING);
            immutable h = _input[_inputPtr++];
            immutable digit = h >= '0' && h <= '9' ? h - '0' : (h | 0x20) >= 'a' && (h | 0x20) <= 'f'
                ? (h | 0x20) - 'a' + 10 : -1;
            if (digit < 0)
                throw unexpected(h, "expected a hex-digit for character escape sequence");
            unit = unit << 4 | digit;
        }
        return unit;
    }

    // The continuation bytes of a multi-byte UTF-8 sequence led by `lead`, checked as Jackson's decoders check them.
    private void skipUtf8Tail(ubyte lead)
    {
        immutable extra = lead >= 0xC0 && lead < 0xE0 ? 1 : lead >= 0xE0 && lead < 0xF0
            ? 2 : lead >= 0xF0 && lead < 0xF8 ? 3 : 0;
        if (extra == 0)
            throw invalidUtf8("start", lead);
        foreach (i; 0 .. extra)
        {
            if (_inputPtr == _input.length)
                throw endOfInputError("Unexpected end-of-input in a multi-byte UTF-8 character");
            immutable next = _input[_inputPtr++];
            if ((next & 0xC0) != 0x80)
                throw invalidUtf8("middle", next);
        }
    }

    // An unquoted name's bytes from `from` to `to` are well-formed UTF-8.
    private void checkUtf8(size_t from, size_t to)
    {
        immutable end = _inputPtr;
        _inputPtr = from;
        while (_inputPtr < to)
        {
            immutable c = _input[_inputPtr++];
            if (c >= 0x80)
                skipUtf8Tail(c);
        }
        _inputPtr = end;
    }

    // ParserMinimalBase._throwUnquotedSpace.
    private JacksonException unquotedControl(ubyte c, bool isName)
    {
        return readError(joined("Illegal unquoted character ((CTRL-CHAR, code ", decimal(c),
                ")): has to be escaped using backslash to be included in ", isName ? "name" : "string value"));
    }

    private JsonToken readValue(ubyte c)
    {
        _tokenStart = _inputPtr;
        switch (c)
        {
        case '{':
            ++_inputPtr;
            enter(_streamReadContext.createChildObjectContext(_tokenStart));
            return JsonToken.START_OBJECT;
        case '[':
            ++_inputPtr;
            enter(_streamReadContext.createChildArrayContext(_tokenStart));
            return JsonToken.START_ARRAY;
        case '"':
            return readString();
        case 't':
            return literal("true", JsonToken.VALUE_TRUE);
        case 'f':
            return literal("false", JsonToken.VALUE_FALSE);
        case 'n':
            return literal("null", JsonToken.VALUE_NULL);
        default:
            if (c == '-' || (c >= '0' && c <= '9'))
                return readNumber();
            return unexpectedValue(c);
        }
    }

    // ReaderBasedJsonParser._handleUnexpectedValue: a missing value (ALLOW_MISSING_VALUES) is null and leaves its
    // comma or close marker for the next token; anything else fails.
    private JsonToken unexpectedValue(ubyte c)
    {
        if (c == '\'' && allows(JsonReadFeature.ALLOW_SINGLE_QUOTES))
            return lenientValue('\'');
        if (c == '+' || c == 'N' || c == 'I' || (c == '.'
                && allows(JsonReadFeature.ALLOW_LEADING_DECIMAL_POINT_FOR_NUMBERS)))
            return oddNumber();
        immutable missing = c == ',' || (c == ']' && _streamReadContext.inArray());
        if (missing && !_streamReadContext.inRoot() && allows(JsonReadFeature.ALLOW_MISSING_VALUES))
            return JsonToken.VALUE_NULL;
        if (missing || c == '}')
            throw unexpected(c, "expected a value");
        throw invalidValue(c);
    }

    // UTF8StreamJsonParser._handleUnexpectedValue's end: a Java identifier start begins an unrecognized token
    // (" A\u3456C " reads as 'A\u3456C'); any other byte is an unexpected character.
    private JacksonException invalidValue(ubyte c)
    {
        size_t next;
        if (javaIdentifierStart(codePointAt(_inputPtr, next)))
            return unrecognized(_inputPtr, _inputPtr);
        return unexpected(c, allows(JsonReadFeature.ALLOW_NON_NUMERIC_NUMBERS)
                ? "expected a valid value (JSON String, Number (or 'NaN'/'+INF'/'-INF'), Array, Object or token "
                ~ "'null', 'true' or 'false')"
                : "expected a valid value (JSON String, Number, Array, Object or token 'null', 'true' or 'false')");
    }

    private JsonToken readString()
    {
        auto scanner = JsonScanner(_input, JsonDecodeOptions.init);
        scanner.offset = _inputPtr;
        const error = scanner.textValue(_text);
        // A string the strict scanner rejects is read again by Jackson's slow path: it accepts what the features
        // allow, or fails as Jackson does.
        if (error.code)
            return lenientValue('"');
        if (_text.length > _constraints.maxStringLength)
            throw lengthError("String value", _text.length, _constraints.maxStringLength, null);
        _inputPtr = scanner.offset;
        return JsonToken.VALUE_STRING;
    }

    private void enter(JsonReadContext child)
    {
        if (child.getNestingDepth() > _constraints.maxNestingDepth)
            throw constraintError("Document nesting depth (" ~ decimal(
                    child.getNestingDepth()) ~ ") exceeds the maximum allowed (" ~ decimal(
                    _constraints.maxNestingDepth) ~ ", from `StreamReadConstraints.getMaxNestingDepth()`)",
                    currentLocation());
        _streamReadContext = child;
    }

    private void closeScope(ubyte c)
    {
        immutable array = c == ']';
        if (array ? !_streamReadContext.inArray() : !_streamReadContext.inObject())
            throw unexpected(c, "Unexpected close marker '" ~ cast(char) c ~ "': expected '" ~ (
                    _streamReadContext.inArray() ? "]" : _streamReadContext.inObject() ? "}" : "a value")
                    ~ "' (for " ~ _streamReadContext.typeDesc() ~ " starting at " ~ locationAt(
                        _streamReadContext._startOffset).toString() ~ ")", true);
        _tokenStart = _inputPtr;
        ++_inputPtr;
        _streamReadContext = _streamReadContext.getParent();
        _currToken = array ? JsonToken.END_ARRAY : JsonToken.END_OBJECT;
    }

    private JsonToken literal(string word, JsonToken token)
    {
        immutable end = _inputPtr + word.length;
        if (end > _input.length || cast(const(char)[]) _input[_inputPtr .. end] != word)
            throw unrecognized(_tokenStart, _tokenStart);
        _inputPtr = end;
        if (_inputPtr < _input.length && !separator(_input[_inputPtr]) && spaceKind[_input[_inputPtr]] != Space.odd)
            matchEnd(_tokenStart);
        return token;
    }

    // UTF8StreamJsonParser._checkMatchEnd: a matched token (a literal, NaN or an Infinity) runs on into a longer token
    // only through a Java identifier part ("truex", "NaNu"); any other byte ends it ("NaN,", "true-"), and the next
    // token reports that byte. `from` is where the token's letters start, after any sign.
    private void matchEnd(size_t from)
    {
        size_t next;
        if (_input[_inputPtr] >= '0' && javaIdentifierPart(codePointAt(_inputPtr, next)))
            throw unrecognized(_tokenStart, from);
    }

    private static bool separator(ubyte c) pure nothrow @nogc
    {
        return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == ',' || c == ']' || c == '}' || c == ':';
    }

    private JsonToken readNumber()
    {
        _oddText = null;
        auto scanner = JsonScanner(_input, JsonDecodeOptions.init);
        scanner.offset = _inputPtr;
        const error = scanner.number(_number);
        if (error.code) // read again as Jackson does: what the features allow, or Jackson's error
            return oddNumber();
        _inputPtr = scanner.offset;
        immutable length = _number.end - _number.start;
        if (length > _constraints.maxNumberLength)
            throw lengthError("Number value", length, _constraints.maxNumberLength, currentLocation());
        if (_inputPtr < _input.length && badNumberEnd(_input[_inputPtr]))
        {
            // "00003" or "-01": the strict scanner stops after the first zero; leading zeros are oddNumber's.
            if (leadingZero(_number.start + (_input[_number.start] == '-')))
                return oddNumber();
            rootSpace(_input[_inputPtr]);
        }
        return _number.fractional ? JsonToken.VALUE_NUMBER_FLOAT : JsonToken.VALUE_NUMBER_INT;
    }

    // Where a number may stop without a second look: white space anywhere, and ',', ']', '}' or ':' inside an Array or
    // Object. Any other byte, or a structural one at the root, goes to the cold checks.
    private bool badNumberEnd(ubyte c)
    {
        immutable end = numberEnd[c];
        return end == NumberEnd.other || (end == NumberEnd.structural && _streamReadContext.inRoot());
    }

    private enum NumberEnd : ubyte
    {
        blank,
        structural,
        other,
    }

    private static immutable NumberEnd[256] numberEnd = () {
        NumberEnd[256] ends = NumberEnd.other;
        ends[' '] = ends['\t'] = ends['\n'] = ends['\r'] = NumberEnd.blank;
        ends[','] = ends[']'] = ends['}'] = ends[':'] = NumberEnd.structural;
        return ends;
    }();

    // UTF8StreamJsonParser._verifyRootSpace: a root-level number needs white space (or the end of input) after it.
    // Inside an Array or Object any other byte ends the number, and the next token reports it.
    private void rootSpace(ubyte c)
    {
        if (spaceKind[c] != Space.blank && _streamReadContext.inRoot())
            throw unexpected(c, "Expected space separating root-level values");
    }

    // UTF8StreamJsonParser's non-standard numbers, from the token's first byte: a leading '+'
    // (ALLOW_LEADING_PLUS_SIGN_FOR_NUMBERS), leading zeros (ALLOW_LEADING_ZEROS_FOR_NUMBERS, which leave the text), a
    // leading or trailing decimal point (ALLOW_LEADING_/ALLOW_TRAILING_DECIMAL_POINT_FOR_NUMBERS), and NaN, Infinity,
    // -INF and +INF (ALLOW_NON_NUMERIC_NUMBERS); otherwise Jackson's error for the first byte that fails.
    private JsonToken oddNumber()
    {
        size_t p = _tokenStart;
        immutable sign = _input[p] == '-' || _input[p] == '+' ? _input[p] : 0;
        if (sign)
            ++p;
        if (p < _input.length && (_input[p] == 'N' || _input[p] == 'I'))
            return nonNumeric(p, sign);
        if (sign == '+' && !allows(JsonReadFeature.ALLOW_LEADING_PLUS_SIGN_FOR_NUMBERS))
            throw numberError('+', "JSON spec does not allow numbers to have plus signs: enable "
                    ~ "`JsonReadFeature.ALLOW_LEADING_PLUS_SIGN_FOR_NUMBERS` to allow");
        // The digits it parses as, built in the scratch buffer: '-', the integer part ("0" when absent), the fraction
        // when it has digits, and the exponent.
        size_t n;
        if (sign == '-')
            putScratch(n, "-");
        bool trimmed;
        putScratch(n, integralPart(p, sign, trimmed));
        immutable fractional = fractionAndExponent(p, n);
        return finishOddNumber(p, owned(_scratch[0 .. n]), trimmed, fractional);
    }

    // The integer part from `p`: leading zeros dropped with ALLOW_LEADING_ZEROS_FOR_NUMBERS (`trimmed`), "0" before a
    // leading decimal point with ALLOW_LEADING_DECIMAL_POINT_FOR_NUMBERS, Jackson's error otherwise.
    private const(char)[] integralPart(ref size_t p, ubyte sign, out bool trimmed)
    {
        immutable intStart = p;
        p = skipDigits(p);
        auto integral = cast(const(char)[]) _input[intStart .. p];
        if (integral.length > 1 && integral[0] == '0')
        {
            if (!allows(JsonReadFeature.ALLOW_LEADING_ZEROS_FOR_NUMBERS))
                throw readError("Invalid numeric value: Leading zeroes not allowed");
            while (integral.length > 1 && integral[0] == '0')
                integral = integral[1 .. $];
            trimmed = true;
        }
        if (integral.length != 0)
            return integral;
        immutable leadingPoint = p < _input.length && _input[p] == '.'
            && allows(JsonReadFeature.ALLOW_LEADING_DECIMAL_POINT_FOR_NUMBERS);
        if (!leadingPoint)
            throw numberError(byteAt(p), sign == '-'
                    ? "expected digit (0-9) to follow minus sign, for valid numeric value"
                    : "Decimal point not followed by a digit");
        return "0";
    }

    // The fraction (a trailing decimal point alone with ALLOW_TRAILING_DECIMAL_POINT_FOR_NUMBERS) and the exponent
    // from `p`, onto the scratch digits; whether the number has either.
    private bool fractionAndExponent(ref size_t p, ref size_t n)
    {
        bool fractional;
        if (p < _input.length && _input[p] == '.')
        {
            fractional = true;
            immutable from = ++p;
            p = skipDigits(p);
            if (p == from && !allows(JsonReadFeature.ALLOW_TRAILING_DECIMAL_POINT_FOR_NUMBERS))
                throw numberError(byteAt(p), "Decimal point not followed by a digit");
            if (p > from)
                putScratch(n, cast(const(char)[]) _input[from - 1 .. p]);
        }
        if (p < _input.length && (_input[p] | 0x20) == 'e')
        {
            fractional = true;
            immutable from = p++;
            if (p < _input.length && (_input[p] == '+' || _input[p] == '-'))
                ++p;
            immutable expStart = p;
            p = skipDigits(p);
            if (p == expStart)
                throw numberError(byteAt(p), "Exponent indicator not followed by a digit");
            putScratch(n, cast(const(char)[]) _input[from .. p]);
        }
        return fractional;
    }

    // Append `piece` to the scratch buffer's first `n` bytes.
    private void putScratch(ref size_t n, scope const(char)[] piece)
    {
        if (n + piece.length > _scratch.length)
            growScratch(n + piece.length < 64 ? 64 : (n + piece.length) * 2);
        _scratch[n .. n + piece.length] = piece[];
        n += piece.length;
    }

    private size_t skipDigits(size_t p) const pure nothrow @nogc
    {
        while (p < _input.length && _input[p] >= '0' && _input[p] <= '9')
            ++p;
        return p;
    }

    // The byte at `p`, or a space at the end of input (as an error describes it).
    private ubyte byteAt(size_t p) const pure nothrow @nogc
    {
        return p < _input.length ? _input[p] : ' ';
    }

    // An odd number's end: the separator checks of readNumber, then its token.
    private JsonToken finishOddNumber(size_t end, string digits, bool trimmed, bool fractional)
    {
        _inputPtr = end;
        if (end - _tokenStart > _constraints.maxNumberLength)
            throw lengthError("Number value", end - _tokenStart, _constraints.maxNumberLength, currentLocation());
        if (_inputPtr < _input.length)
            rootSpace(_input[_inputPtr]);
        // Leading zeros leave the text (Jackson reports "00003" as "3"); a sign or decimal point stays as written.
        _oddText = trimmed ? digits : owned(cast(const(char)[]) _input[_tokenStart .. end]);
        _oddDigits = digits;
        _oddNonNumeric = false;
        _number = JsonNumberToken(_tokenStart, end, fractional);
        return fractional ? JsonToken.VALUE_NUMBER_FLOAT : JsonToken.VALUE_NUMBER_INT;
    }

    // NaN, Infinity and the signed INF and Infinity: a double that is not a number, with ALLOW_NON_NUMERIC_NUMBERS.
    private JsonToken nonNumeric(size_t p, ubyte sign)
    {
        size_t end = p;
        while (end < _input.length && end - p < 8 && ((_input[end] | 0x20) >= 'a' && (_input[end] | 0x20) <= 'z'))
            ++end;
        auto word = cast(const(char)[]) _input[p .. end];
        immutable valid = sign ? word == "INF" || word == "Infinity" : word == "NaN" || word == "Infinity";
        if (!valid)
        {
            throw unrecognized(_tokenStart, p);
        }
        _inputPtr = end;
        if (_inputPtr < _input.length) // _matchToken's _checkMatchEnd, before the feature check; no _verifyRootSpace
            matchEnd(p);
        auto text = owned(cast(const(char)[]) _input[_tokenStart .. end]);
        if (!allows(JsonReadFeature.ALLOW_NON_NUMERIC_NUMBERS))
            throw readError(
                    "Non-standard token '" ~ text ~ "': enable `JsonReadFeature.ALLOW_NON_NUMERIC_NUMBERS` "
                    ~ "to allow");
        _oddText = text;
        _oddDigits = text;
        _oddNonNumeric = true;
        _number = JsonNumberToken(_tokenStart, end, true);
        _numberDouble = word == "NaN" ? double.nan : sign == '-' ? -double.infinity : double.infinity;
        _numberType = NumberType.DOUBLE;
        _numberParsed = true;
        return JsonToken.VALUE_NUMBER_FLOAT;
    }

    // ParserMinimalBase._reportUnexpectedNumberChar: "Unexpected character ('x' (code 120)) in numeric value: ...".
    private JacksonException numberError(ubyte c, string comment)
    {
        return unexpected(c, comment, false, false, true);
    }

    override bool isNaN()
    {
        return _currToken == JsonToken.VALUE_NUMBER_FLOAT && _oddText !is null && _oddNonNumeric;
    }

    // Whether a '0' at `offset` is followed by another digit.
    private bool leadingZero(size_t offset) const pure nothrow @nogc
    {
        return offset + 1 < _input.length && _input[offset] == '0' && _input[offset + 1] >= '0'
            && _input[offset + 1] <= '9';
    }

    // The text of a string token, unescaped: a slice of the input, or of the scratch buffer when it has escapes.
    private const(char)[] text(JsonTextToken token)
    {
        if (token.length == token.end - token.start)
            return cast(const(char)[]) _input[token.start .. token.end];
        if (_scratch.length < token.length)
            growScratch(token.length < 64 ? 64 : token.length);
        auto output = _scratch[0 .. token.length];
        if (!copyJsonText(_input, token, cast(ubyte[]) output))
            throw readError("Invalid JSON string");
        return output;
    }

    // A string value, owned by the caller: the value becomes part of the user's object.
    private string decode(JsonTextToken token)
    {
        return owned(text(token));
    }

    // The parser's one place that grows the scratch buffer.
    private void growScratch(size_t length) pure nothrow
    {
        _scratch.length = length;
    }

    // UTF-8 for a code point from an escape, into `bytes`: its length.
    private static size_t encodeUtf8(dchar c, ref ubyte[4] bytes) pure nothrow @nogc
    {
        if (c < 0x800)
        {
            bytes[0] = cast(ubyte)(0xC0 | c >> 6);
            bytes[1] = cast(ubyte)(0x80 | (c & 0x3F));
            return 2;
        }
        if (c < 0x10000)
        {
            bytes[0] = cast(ubyte)(0xE0 | c >> 12);
            bytes[1] = cast(ubyte)(0x80 | (c >> 6 & 0x3F));
            bytes[2] = cast(ubyte)(0x80 | (c & 0x3F));
            return 3;
        }
        bytes[0] = cast(ubyte)(0xF0 | c >> 18);
        bytes[1] = cast(ubyte)(0x80 | (c >> 12 & 0x3F));
        bytes[2] = cast(ubyte)(0x80 | (c >> 6 & 0x3F));
        bytes[3] = cast(ubyte)(0x80 | (c & 0x3F));
        return 4;
    }

    // A property name: the factory's interned copy, so a name the mapper has seen costs no allocation.
    private string name(JsonTextToken token)
    {
        return _factory.internName(text(token));
    }

    // The string token's text without a copy: a slice of the document, or of the scratch buffer when it had escapes.
    override const(char)[] getStringCharacters()
    {
        if (_currToken != JsonToken.VALUE_STRING)
            return getString();
        return _textCached ? _textCache : text(_text);
    }

    override string getString()
    {
        switch (_currToken)
        {
        case JsonToken.VALUE_STRING:
            if (!_textCached)
            {
                _textCache = decode(_text);
                _textCached = true;
            }
            return _textCache;
        case JsonToken.PROPERTY_NAME:
            return _streamReadContext.currentName();
        case JsonToken.VALUE_NUMBER_INT:
        case JsonToken.VALUE_NUMBER_FLOAT:
            if (_oddText !is null)
                return _oddText;
            return owned(cast(const(char)[]) _input[_number.start .. _number.end]);
        case JsonToken.NOT_AVAILABLE:
            return null;
        default:
            import flint.jackson.core : asString;

            return _currToken.asString();
        }
    }

    override JsonParser skipChildren()
    {
        if (_currToken != JsonToken.START_OBJECT && _currToken != JsonToken.START_ARRAY)
            return this;
        int open = 1;
        for (;;)
        {
            const t = nextToken();
            if (t == JsonToken.NOT_AVAILABLE)
                return this;
            if (t == JsonToken.START_OBJECT || t == JsonToken.START_ARRAY)
                ++open;
            else if ((t == JsonToken.END_OBJECT || t == JsonToken.END_ARRAY) && --open == 0)
                return this;
        }
    }

    private void parseNumber()
    {
        if (_numberParsed)
            return;
        if (_currToken != JsonToken.VALUE_NUMBER_INT && _currToken != JsonToken.VALUE_NUMBER_FLOAT)
            throw coercionError("Current token (" ~ tokenName(
                    _currToken) ~ ") not numeric, cannot use numeric value accessors", _currToken);
        auto text = _oddText is null ? _input[_number.start .. _number.end] : cast(const(ubyte)[]) _oddDigits;
        if (_currToken == JsonToken.VALUE_NUMBER_FLOAT)
        {
            if (!parseJsonDecimal(text, _numberDouble))
                _numberDouble = text[0] == '-' ? -double.infinity : double.infinity;
            _numberType = NumberType.DOUBLE;
        }
        else
        {
            immutable negative = text[0] == '-';
            ulong magnitude;
            bool overflow;
            foreach (d; text[negative ? 1 : 0 .. $])
            {
                if (magnitude > (ulong.max - (d - '0')) / 10)
                {
                    overflow = true;
                    break;
                }
                magnitude = magnitude * 10 + (d - '0');
            }
            immutable limit = negative ? cast(ulong) long.max + 1 : cast(ulong) long.max;
            if (overflow || magnitude > limit)
            {
                _numberType = NumberType.BIG_INTEGER;
                parseJsonDecimal(text, _numberDouble);
            }
            else
            {
                _numberLong = negative ? -cast(long)(magnitude - 1) - 1 : cast(long) magnitude;
                _numberDouble = cast(double) _numberLong;
                _numberType = _numberLong >= int.min && _numberLong <= int.max ? NumberType.INT : NumberType.LONG;
            }
        }
        _numberParsed = true;
    }

    override NumberType getNumberType()
    {
        parseNumber();
        return _numberType;
    }

    override int getIntValue()
    {
        parseNumber();
        if (_numberType == NumberType.INT)
            return cast(int) _numberLong;
        if (_numberType == NumberType.DOUBLE && _numberDouble >= int.min && _numberDouble <= int.max)
            return cast(int) _numberDouble;
        throw coercionError("Numeric value (" ~ longIntegerDesc(
                getString()) ~ ") out of range of `int` (-2147483648 - 2147483647)", _currToken);
    }

    override long getLongValue()
    {
        parseNumber();
        if (_numberType == NumberType.INT || _numberType == NumberType.LONG)
            return _numberLong;
        if (_numberType == NumberType.DOUBLE && _numberDouble >= -0x1p63 && _numberDouble < 0x1p63)
            return cast(long) _numberDouble;
        throw coercionError("Numeric value (" ~ longIntegerDesc(getString())
                ~ ") out of range of `long` (-9223372036854775808 - 9223372036854775807)", _currToken);
    }

    // ParserMinimalBase._longIntegerDesc: very long numbers are described by their digit count.
    private static string longIntegerDesc(string raw) pure nothrow
    {
        if (raw.length < 1000)
            return raw;
        immutable digits = raw[0] == '-' ? raw[1 .. $].length : raw.length;
        return "[Integer with " ~ decimal(cast(long) digits) ~ " digits]";
    }

    override double getDoubleValue()
    {
        parseNumber();
        return _numberDouble;
    }

    override float getFloatValue()
    {
        parseNumber();
        if (_currToken == JsonToken.VALUE_NUMBER_FLOAT)
        {
            float[1] value;
            if (parseJsonDecimal(_input[_number.start .. _number.end], value[0]))
                return value[0];
        }
        return cast(float) _numberDouble;
    }

    override int getValueAsInt(int def)
    {
        switch (_currToken)
        {
        case JsonToken.VALUE_NUMBER_INT:
        case JsonToken.VALUE_NUMBER_FLOAT:
            parseNumber();
            if (_numberType == NumberType.INT || _numberType == NumberType.LONG)
                return cast(int) _numberLong;
            return cast(int) _numberDouble;
        case JsonToken.VALUE_TRUE:
            return 1;
        case JsonToken.VALUE_FALSE:
        case JsonToken.VALUE_NULL:
            return 0;
        case JsonToken.VALUE_STRING:
            return cast(int) parseAsLong(getString(), def);
        default:
            return def;
        }
    }

    override long getValueAsLong(long def)
    {
        switch (_currToken)
        {
        case JsonToken.VALUE_NUMBER_INT:
        case JsonToken.VALUE_NUMBER_FLOAT:
            parseNumber();
            if (_numberType == NumberType.INT || _numberType == NumberType.LONG)
                return _numberLong;
            return cast(long) _numberDouble;
        case JsonToken.VALUE_TRUE:
            return 1;
        case JsonToken.VALUE_FALSE:
        case JsonToken.VALUE_NULL:
            return 0;
        case JsonToken.VALUE_STRING:
            return parseAsLong(getString(), def);
        default:
            return def;
        }
    }

    override double getValueAsDouble(double def)
    {
        switch (_currToken)
        {
        case JsonToken.VALUE_NUMBER_INT:
        case JsonToken.VALUE_NUMBER_FLOAT:
            return getDoubleValue();
        case JsonToken.VALUE_TRUE:
            return 1.0;
        case JsonToken.VALUE_FALSE:
        case JsonToken.VALUE_NULL:
            return 0.0;
        case JsonToken.VALUE_STRING:
            import flint.jackson.core.io : NumberInput;

            // NumberInput.parseAsDouble: the default for text that is not a number.
            double value;
            return NumberInput.parseDouble(getString(), value) ? value : def;
        default:
            return def;
        }
    }

    override bool getValueAsBoolean(bool def)
    {
        switch (_currToken)
        {
        case JsonToken.VALUE_NUMBER_INT:
            return getIntValue() != 0;
        case JsonToken.VALUE_TRUE:
            return true;
        case JsonToken.VALUE_FALSE:
        case JsonToken.VALUE_NULL:
            return false;
        case JsonToken.VALUE_STRING:
            import flint.engine.aot.text : stripWhite;

            const text = stripWhite(getString());
            if (text == "true")
                return true;
            if (text == "false" || text == "null")
                return false;
            return def;
        default:
            return def;
        }
    }

    // NumberInput.parseAsLong: trimmed decimal digits, else the default.
    private static long parseAsLong(string text, long def) pure nothrow
    {
        import flint.engine.aot.text : stripWhite;

        const s = stripWhite(text);
        if (s.length == 0)
            return def;
        size_t i = s[0] == '-' || s[0] == '+' ? 1 : 0;
        if (i == s.length)
            return def;
        long value;
        foreach (c; s[i .. $])
        {
            if (c < '0' || c > '9')
                return def;
            value = value * 10 + (c - '0');
        }
        return s[0] == '-' ? -value : value;
    }

    override TokenStreamLocation currentTokenLocation()
    {
        return locationAt(_tokenStart);
    }

    override TokenStreamLocation currentLocation()
    {
        return locationAt(_inputPtr);
    }

    private TokenStreamLocation locationAt(size_t offset)
    {
        int line = 1;
        size_t lineStart;
        // A line ends at LF, CR or CR LF, as Jackson counts rows.
        foreach (i, b; _input[0 .. offset < _input.length ? offset : _input.length])
        {
            if (b == '\n' || (b == '\r' && (i + 1 >= _input.length || _input[i + 1] != '\n')))
            {
                ++line;
                lineStart = i + 1;
            }
        }
        return new TokenStreamLocation(cast(long) offset, -1, line, cast(int)(offset - lineStart + 1));
    }

    // `escape`: ParserMinimalBase._handleUnrecognizedCharacterEscape's "Unrecognized character escape 'x' (code 120)".
    private JacksonException unexpected(ubyte c, string comment, bool whole = false,
            bool escape = false, bool numeric = false)
    {
        import flint.engine.aot.text : decimal;

        if (whole)
            return readError(comment);
        // Written into the scratch buffer, not concatenated: each `~` site is a template instance and inline code
        // that every application links (R-184); std.format alone instantiated about 4,000 templates here.
        const char[1] glyph = [cast(char) c];
        const printable = c >= 0x20 && c < 0x7F;
        const code = decimal(cast(uint) c);
        const(char)[] head = escape ? "Unrecognized character escape " : "Unexpected character (";
        const(char)[] tail = escape ? "" : numeric ? ") in numeric value: " : "): ";
        if (printable)
            return readError(joined(head, "'", glyph[], "' (code ", code, ")", tail, escape ? null : comment));
        return readError(joined(head, "(CTRL-CHAR, code ", code, ")", tail, escape ? null : comment));
    }

    // The pieces of an error message, written into the scratch buffer and copied once. None may be a slice of the
    // scratch buffer itself.
    pragma(inline, false) private string joined(scope const(char)[][] pieces...)
    {
        size_t n;
        foreach (piece; pieces)
            putScratch(n, piece);
        return owned(_scratch[0 .. n]);
    }

    // The code point at `p` (U+FFFD for malformed UTF-8) and, through `next`, the offset after it: one out-of-line copy
    // of the decoder for the cold paths.
    pragma(inline, false) private dchar codePointAt(size_t p, out size_t next) const
    {
        import flint.engine.aot.text : decodeUtf8;

        next = p;
        return decodeUtf8(cast(const(char)[]) _input, next);
    }

    // ParserBase._reportInvalidToken: what matched (`start` to `from`), then every Java identifier part after it, up to
    // ErrorReportConfiguration's 256 UTF-16 units and "...", reported at the token's start.
    private JacksonException unrecognized(size_t start, size_t from)
    {
        enum maxErrorTokenLength = 256;
        size_t end = from;
        size_t units = from - start;
        bool cut;
        while (!cut && end < _input.length)
        {
            size_t next;
            immutable c = codePointAt(end, next);
            if (!javaIdentifierPart(c))
                break;
            end = next;
            units += c >= 0x10000 ? 2 : 1;
            cut = units >= maxErrorTokenLength;
        }
        _inputPtr = start;
        return readError(joined("Unrecognized token '", cast(const(char)[]) _input[start .. end],
                cut ? "...': was expecting " : "': was expecting ", validValues()));
    }

    // JsonParserBase._validJsonValueList: NaN and the Infinities are named once ALLOW_NON_NUMERIC_NUMBERS allows them.
    private string validValues()
    {
        if (allows(JsonReadFeature.ALLOW_NON_NUMERIC_NUMBERS))
            return "(JSON String, Number (or 'NaN'/'+INF'/'-INF'), Array, Object or token 'null', 'true' or 'false')";
        return "(JSON String, Number, Array, Object or token 'null', 'true' or 'false')";
    }

    // Character.isJavaIdentifierPart, exact through U+00FF. jackson-core has no Unicode identifier tables, so every
    // code point above U+00FF counts as a part; only the text of an "Unrecognized token" error can differ.
    private static bool javaIdentifierPart(dchar c) pure nothrow @nogc
    {
        return c >= 0x100 || (nameClass[c] & identifierPart);
    }

    // Character.isJavaIdentifierStart through U+00FF; above it, false, so such a byte keeps the unexpected-character
    // error.
    private static bool javaIdentifierStart(dchar c) pure nothrow @nogc
    {
        return c < 0x100 && (nameClass[c] & identifierPart) && !(c >= '0' && c <= '9') && c > 0x1B
            && (c < 0x7F || c > 0x9F) && c != 0xAD;
    }

    // Character.isJavaIdentifierPart in Latin-1: letters, digits, '$', '_', the currency signs, ª, µ and º, and the
    // identifier-ignorable controls (U+0000-U+0008, U+000E-U+001B, U+007F-U+009F) and soft hyphen.
    // One table for both: `identifierPart` (above) and `unquotedName`, CharTypes.getInputCodeUtf8JsNames' bytes for an
    // unquoted name (the identifier parts from 33 up, read as Latin-1, plus '@', '#', '*', '-' and '+').
    private static immutable ubyte[256] nameClass = () {
        ubyte[256] table;
        foreach (c; 0 .. 256)
        {
            immutable letter = (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z');
            immutable ascii = letter || (c >= '0' && c <= '9') || c == '_' || c == '$';
            immutable ignorable = c <= 0x08 || (c >= 0x0E && c <= 0x1B) || (c >= 0x7F && c <= 0x9F) || c == 0xAD;
            immutable latin = (c >= 0xA2 && c <= 0xA5) || c == 0xAA || c == 0xB5 || c == 0xBA
                || (c >= 0xC0 && c != 0xD7 && c != 0xF7);
            if (ascii || ignorable || latin)
                table[c] = identifierPart | (c >= 33 ? unquotedName : 0);
        }
        foreach (c; "@#*-+")
            table[c] |= unquotedName;
        return table;
    }();

    // StreamReadConstraints' length limits, built at one site: "Name length (12) exceeds the maximum allowed (10)".
    private JacksonException lengthError(string what, size_t length, long limit, TokenStreamLocation location)
    {
        return constraintError(joined(what, " length (", decimal(cast(long) length),
                ") exceeds the maximum allowed (", decimal(limit), ")"), location);
    }

    // The one construction site of the parser's StreamConstraintsException.
    private JacksonException constraintError(string message, TokenStreamLocation location)
    {
        return new StreamConstraintsException(message, location);
    }

    private JacksonException eofIn(string what)
    {
        return endOfInputError("Unexpected end-of-input within/between " ~ what);
    }

    // The one construction site of the parser's end-of-input errors between tokens (each `new` site is a template
    // instance in this module's budget).
    private JacksonException endOfInputError(string message, JsonToken token = JsonToken.NOT_AVAILABLE)
    {
        return new UnexpectedEndOfInputException(this, token, message, currentLocation());
    }

}
