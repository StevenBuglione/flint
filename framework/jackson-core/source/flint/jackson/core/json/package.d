            put('{');
        return this;
    }

    override JsonGenerator writeEndObject()
    {
        verifyOpen();
        if (!_streamWriteContext.inObject())
            throw new StreamWriteException(this, "Current context not an Object but " ~ _streamWriteContext.typeDesc());
        if (_cfgPrettyPrinter !is null)
            _cfgPrettyPrinter.writeEndObject(this, _streamWriteContext.getEntryCount());
        else
            put('}');
        _streamWriteContext = _streamWriteContext.getParent();
        return this;
    }

    override JsonGenerator writeStartArray()
    {
        verifyValueWrite("start an array");
        _streamWriteContext = _streamWriteContext.createChildArrayContext(null);
        _streamWriteConstraints.validateNestingDepth(_streamWriteContext.getNestingDepth());
        if (_cfgPrettyPrinter !is null)
            _cfgPrettyPrinter.writeStartArray(this);
        else
            put('[');
        return this;
    }

    override JsonGenerator writeEndArray()
    {
        verifyOpen();
        if (!_streamWriteContext.inArray())
            throw new StreamWriteException(this, "Current context not an Array but " ~ _streamWriteContext.typeDesc());
        if (_cfgPrettyPrinter !is null)
            _cfgPrettyPrinter.writeEndArray(this, _streamWriteContext.getEntryCount());
        else
            put(']');
        _streamWriteContext = _streamWriteContext.getParent();
        return this;
    }

    override JsonGenerator writeName(string name)
