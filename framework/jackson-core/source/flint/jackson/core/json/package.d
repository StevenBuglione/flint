    /// The characters `buffer[offset .. offset + len]` as a String value, escaped from the buffer as they are.
    override JsonGenerator writeString(scope const(char)[] buffer, int offset, int len)
    {
        verifyValueWrite("write a string");
        quoted(buffer[offset .. offset + len]);
        return this;
    }

    // ASCII bytes written as they are whatever the features: not a control character, `"`, `\\` or `/` (which
    // ESCAPE_FORWARD_SLASHES escapes). The others take outputEscape's answer.
    private static immutable bool[128] plainAscii = () {
        bool[128] table;
        foreach (c; 0x20 .. 0x80)
            table[c] = c != '"' && c != '\\' && c != '/';
        return table;
    }();

    // The same over every byte value: with ESCAPE_NON_ASCII off a byte of a multi-byte character is written as it is
    // (plainUtf8); with it on, such bytes take the escape path (plainAsciiOnly). One lookup per byte, the table chosen
    // once per string.
    private static immutable bool[256] plainUtf8 = () {
        bool[256] table;
        foreach (c; 0 .. 256)
            table[c] = c >= 0x80 || plainAscii[c];
        return table;
    }();
    /// ditto
    private static immutable bool[256] plainAsciiOnly = () {
        bool[256] table;
        foreach (c; 0 .. 0x80)
            table[c] = plainAscii[c];
        return table;
    }();

    private void quoted(scope const(char)[] text)
    {
        put('"');
        escaped(text);
        put('"');
    }

    private void escaped(scope const(char)[] text)
    {
        auto bytes = cast(const(ubyte)[]) text;
        const plain = _escapeNonAscii ? &plainAsciiOnly : &plainUtf8;
        size_t run;
        size_t i;
        while (i < bytes.length)
        {
            immutable b = bytes[i];
            if ((*plain)[b])
            {
                ++i;
                continue;
            }
            int esc;
            if (b < 0x80)
                esc = outputEscape(b, _escapeSlash);
            else if (_escapeNonAscii)
                esc = -2;
            if (esc == 0)
            {
                ++i;
                continue;
            }
            put(bytes[run .. i]);
            if (esc == -2)
                i = escapeNonAscii(bytes, i);
            else
            {
                if (esc > 0)
                {
                    put('\\');
                    put(cast(ubyte) esc);
                }
                else
                    unicodeEscape(b);
                ++i;
            }
            run = i;
        }
        put(bytes[run .. $]);
    }

    private size_t escapeNonAscii(scope const(ubyte)[] bytes, size_t i)
    {
        import flint.engine.aot.text : decodeUtf8;

        const text = cast(const(char)[]) bytes;
        size_t next = i;
        const c = decodeUtf8(text, next);
        // A malformed sequence reads as U+FFFD; it is escaped as one, and output resumes at the next byte.
        if (c == 0xFFFD && text[i .. next] != "\uFFFD")
        {
            unicodeEscape(0xFFFD);
            return i + 1;
        }
        if (c >= 0x10000)
        {
            immutable v = c - 0x10000;
            unicodeEscape(0xD800 + (v >> 10));
            unicodeEscape(0xDC00 + (v & 0x3FF));
        }
        else
            unicodeEscape(c);
        return next;
    }

    private void unicodeEscape(uint c)
    {
        const _hex = _hexUpper ? upperHexDigits : lowerHexDigits;
        immutable ubyte[6] escape = [
            '\\', 'u', _hex[(c >> 12) & 0xF], _hex[(c >> 8) & 0xF], _hex[(c >> 4) & 0xF], _hex[c & 0xF]
        ];
        put(escape[]);
    }

    override JsonGenerator writeNumber(int v)
    {
        return writeNumber(cast(long) v);
    }

    override JsonGenerator writeNumber(long v)
    {
