name "java-concurrent-sync"
description "Java SE locks and synchronizers for Flint"
license "GPL-2.0-only WITH Classpath-exception-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "flint:conc" version="*"
dependency "flint:engine-aot" version="*"
dependency "flint:java" version="*"
dependency "flint:java-concurrent" version="*"
dependency "flint:serde" version="*"

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}
