name "micrometer-core"
description "Flint's Micrometer core instrumentation API"
license "Apache-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "flint:engine-aot" version="*"
dependency "flint:java" version="*"
dependency "flint:java-concurrent" version="*"

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}
