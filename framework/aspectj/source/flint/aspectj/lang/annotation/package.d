// Modified by the Flint authors.
module flint.aspectj.lang.annotation;

import flint.java.classref : ClassRef, classOf;

@safe:

/// Identifies an aspect and its instantiation expression.
struct Aspect
{
    /// An empty expression selects one shared aspect instance.
    string value = "";
}

/// Gives an advice method its declared AspectJ name.
struct AdviceName
{
    /// The advice name.
    string value;
}

/// Advice that runs before a matching joinpoint.
struct Before
{
    /// The pointcut expression.
    string value;
    /// Explicit advice argument bindings, in parameter order.
    string argNames = "";
}

/// Advice that controls whether and how a matching joinpoint proceeds.
struct Around
{
    /// The pointcut expression.
    string value;
    /// Explicit advice argument bindings, in parameter order.
    string argNames = "";
}

/// Advice that runs on both normal and exceptional completion.
struct After
{
    /// The pointcut expression.
    string value;
    /// Explicit advice argument bindings, in parameter order.
    string argNames = "";
}

/// Advice that runs after a matching joinpoint returns successfully.
struct AfterReturning
{
    /// The pointcut expression.
    string value = "";
    /// An explicit pointcut expression that takes precedence over value.
    string pointcut = "";
    /// The argument bound to the returned value.
    string returning = "";
    /// Explicit advice argument bindings, in parameter order.
    string argNames = "";
}

/// Advice that runs when a matching joinpoint throws.
struct AfterThrowing
{
    /// The pointcut expression.
    string value = "";
    /// An explicit pointcut expression that takes precedence over value.
    string pointcut = "";
    /// The argument bound to the exception.
    string throwing = "";
    /// Explicit advice argument bindings, in parameter order.
    string argNames = "";
}

/// Declares a named pointcut on a method.
struct Pointcut
{
    /// The pointcut expression.
    string value = "";
    /// Explicit pointcut argument names, in parameter order.
    string argNames = "";
}

/// Declares an introduced interface for types matching a pattern.
struct DeclareParents
{
    /// The target type pattern.
    string value;
    /// The implementation type, or the annotation type when unspecified.
    ClassRef defaultImpl = classOf!DeclareParents;
}

/// Declares precedence among matching aspects.
struct DeclarePrecedence
{
    /// A comma-separated sequence of aspect type patterns.
    string value;
}

/// Associates an annotation declaration with the matching types or members.
struct DeclareAnnotation
{
    /// The type or member pattern that selects where to declare the annotation.
    string value;
}

/// Selects the join points for a declared error.
struct DeclareError
{
    /// Pointcut expression identifying locations where the error applies.
    string value;
}

/// Selects the join points for a declared warning.
struct DeclareWarning
{
    /// Pointcut expression identifying locations where the warning applies.
    string value;
}

/// Describes the interfaces an annotated factory can mix into selected types.
struct DeclareMixin
{
    /// Type pattern selecting the targets of the mixin.
    string value;
    /// A single unset token selects the factory method's return type.
    ClassRef[] interfaces = [ClassRef.init];
}

/// Names the types that must be available for an aspect to activate.
struct RequiredTypes
{
    /// Fully qualified names of the required types.
    string[] value;
}

/// Selects AspectJ warnings to suppress for the annotated declaration.
struct SuppressAjWarnings
{
    /// Warning identifiers, with the upstream default of one empty string.
    string[] value = [""];
}
