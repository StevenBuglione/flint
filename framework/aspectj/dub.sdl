name "aspectj"
description "AspectJ annotations and join-point contracts for Flint AOT"
license "EPL-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "flint:engine-aot" version="*"
dependency "flint:java" version="*"

configuration "library" {
    targetType "library"
}

configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
}
