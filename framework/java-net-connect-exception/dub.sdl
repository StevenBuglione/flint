name "java-net-connect-exception"
description "Java SE connect exception"
license "GPL-2.0-only WITH Classpath-exception-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "flint:java-net-socket-exception" version="*"

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}
