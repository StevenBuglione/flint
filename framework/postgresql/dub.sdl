name "postgresql"
description "PgJDBC (org.postgresql:postgresql) for Flint: an application that declares it links Flint's PostgreSQL engine driver (performance playbook S-1)"
license "Apache-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "flint:engine-jdbc" version="*"
dependency "flint:java" version="*"

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}
